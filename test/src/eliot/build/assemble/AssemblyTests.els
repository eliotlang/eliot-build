import eliot.collection.List
import eliot.file.Path
import eliot.test.Assertion
import eliot.test.Test
import eliot.build.model.PackageId
import eliot.build.model.Version
import eliot.build.model.Descriptor
import eliot.build.resolve.Configuration
import eliot.build.resolve.Resolution
import eliot.build.resolve.TablePackages
import eliot.build.assemble.Assembly

/**
 * What a resolution mounts: which directories building one package compiles from, and which it leaves
 * out.
 *
 * Run against `eliot.build.resolve.TablePackages`, whose trees are at `/trees/<url>@<tag>` and exist
 * only as answers — the subject here is the layout read off a descriptor, not how a version got onto
 * disk, which is `eliot.build.git.Cache`'s and `GitTests`' business.
 *
 * **The layout is one rule**: a package's sources are `<package root>/src`, and the root package's
 * root is `.`, which it writes as its `at` like any other package whose directory is not its name.
 * What the project mounts of *itself* is whichever package was asked for plus the siblings it
 * reaches, so a suite that deps `//root` compiles the library beside it and
 * an executable that does not deps nothing of its own.
 *
 * **A package is mounted at the directory the layout says, whether or not anything is there.** A
 * package whose entire content is a compiler plugin ships no `.els` at all — the compiler itself is
 * one, and so is a documentation backend — so the root it contributes is a directory that does not
 * exist. That is deliberately not a failure: the compiler accepts a source root it finds nothing in
 * (verified), and the one case that is genuinely a mistake — a mistyped `at` — is indistinguishable
 * from it here, where the dependency line that would name the error has never been seen. The
 * diagnostic belongs at the author's build, which is the same place the empty mounts above are
 * already left to.
 */
def testCases: Test = {
   "rootsOf" should "mount the root package at the repository root" in {
      assembled("root", rootPackage(""), publishing("unused", "")) shouldBe "/project/src"
   }
   "rootsOf" should "mount a suite beside the library it deps, and in that order" in {
      assembled(
         "test",
         rootPackage("") ++ "\npackage test {\n  dep //root\n}",
         publishing("unused", "")
      ) shouldBe "/project/test/src, /project/src"
   }
   "rootsOf" should "leave the project's suite out of a build that does not dep it" in {
      assembled(
         "root",
         rootPackage("") ++ "\npackage test {\n  dep //root\n}",
         publishing("unused", "")
      ) shouldBe "/project/src"
   }
   "rootsOf" should "mount each package of the project at the directory it declares" in {
      assembled(
         "lang",
         "package lang {\n  at lang/eliot\n  dep //stdlib\n}\npackage stdlib {\n  at stdlib/eliot\n}",
         publishing("unused", "")
      ) shouldBe "/project/lang/eliot/src, /project/stdlib/eliot/src"
   }
   "rootsOf" should "mount a dependency's root package at its repository root" in {
      assembled(
         "root",
         rootPackage("dep github.com/x/foo//root v1.2"),
         publishing("github.com/x/foo@v1.2", rootPackage(""))
      ) shouldBe "/project/src, /trees/github.com/x/foo@v1.2/src"
   }
   "rootsOf" should "mount a dependency's selected package at the directory that package declares" in {
      assembled(
         "root",
         rootPackage("dep github.com/e/eliot//jvm v1.2"),
         publishing("github.com/e/eliot@v1.2", "package jvm {\n  at jvm/eliot\n}")
      ) shouldBe "/project/src, /trees/github.com/e/eliot@v1.2/jvm/eliot/src"
   }
   "rootsOf" should "mount a package that ships a plugin and no sources of its own" in {
      assembled(
         "root",
         rootPackage("dep github.com/e/eliot//apidoc v1.2"),
         publishing("github.com/e/eliot@v1.2", "package apidoc {\n  asset eliot-apidoc.zip\n}")
      ) shouldBe "/project/src, /trees/github.com/e/eliot@v1.2/apidoc/src"
   }
   "rootsOf" should "leave a package nobody selected out of the mount" in {
      assembled(
         "root",
         rootPackage("dep github.com/e/eliot//stdlib v1.2"),
         publishing("github.com/e/eliot@v1.2", "package stdlib {\n}\npackage jvm {\n}")
      ) shouldBe "/project/src, /trees/github.com/e/eliot@v1.2/stdlib/src"
   }
   "rootsOf" should "mount the sibling a selected package carries, which is how a layer brings its base" in {
      assembled(
         "root",
         rootPackage("dep github.com/e/eliot//jvm v1.2"),
         publishing("github.com/e/eliot@v1.2", "package stdlib {\n}\npackage jvm {\n  dep //stdlib\n}")
      ) shouldBe expectedSiblingMount
   }
   "rootsOf" should "never mount a dependency's suite, which nothing depends on" in {
      assembled(
         "root",
         rootPackage("dep github.com/x/foo//root v1.2"),
         publishing(
            "github.com/x/foo@v1.2",
            rootPackage("") ++ "\npackage test {\n  dep github.com/x/tester//root v1.0\n}"
         )
      ) shouldBe "/project/src, /trees/github.com/x/foo@v1.2/src"
   }
   "rootsOf" should "mount every selected package, in the resolution's own order" in {
      assembled(
         "root",
         rootPackage("dep github.com/x/foo//root v1.2"),
         publishing("github.com/x/foo@v1.2", rootPackage("dep github.com/x/bar//root v1.1"))
            .published("github.com/x/bar@v1.1", rootPackage(""))
      ) shouldBe "/project/src, /trees/github.com/x/bar@v1.1/src, /trees/github.com/x/foo@v1.2/src"
   }
   "rootsOf" should "report a selected version whose sources cannot be read back" in {
      assembled("root", rootPackage("dep github.com/x/foo//root v1.2"), publishing("github.com/x/foo@v1.1", rootPackage("")))
         shouldBe "github.com/x/foo publishes no v1.2"
   }
   "rootsOf" should "report a package no descriptor declares" in {
      assembled("nosuch", "", publishing("unused", "")) shouldBe "no package named 'nosuch'"
   }
}

/**
 * The sibling arrives as a package of the same repository, so both trees are one tree, and the order
 * is the descriptor's declaration order rather than the order the closure reached them in.
 */
private def expectedSiblingMount: String =
   "/project/src, /trees/github.com/e/eliot@v1.2/stdlib/src, " ++
      "/trees/github.com/e/eliot@v1.2/jvm/src"

/**
 * The roots building `name` compiles from, given the project descriptor `rootText` and a `universe` of
 * published ones — one line, so a case says both what is mounted and in what order.
 */
private def assembled(name: String, rootText: String, universe: List[Pair[String, String]]): String =
   rendered(
      against(
         universeOf(universe, empty),
         renderedRoots(rootsOf(PackageName(name), projectOf(rootText), resolve(PackageName(name), descriptorOf(rootText))))
      )
   )

/**
 * The package being built always stands at `/project`, so a root of the project and a root of a
 * dependency are told apart by reading a line rather than by counting.
 */
private def projectOf(rootText: String): Project = Project(path("/project"), descriptorOf(rootText))

/**
 * Rendered *inside* the `against`, as every case of `ResolutionTests` is and for the reason recorded
 * there: two `provide[Universe, _]` instantiations whose JVM descriptors agree get one native between
 * them, so both suites answer a `String` and there is one instantiation to emit.
 */
private def rendered(outcome: Either[ResolutionError, String]): String =
   foldEither(error -> show(error), roots -> roots, outcome)

private def renderedRoots(roots: List[Path]): String = roots.joined(", ")

private def publishing(key: String, text: String): List[Pair[String, String]] = published(key, text, empty)

private def published(key: String, text: String, entries: List[Pair[String, String]]): List[Pair[String, String]] =
   append(entries, Pair(key, text))
