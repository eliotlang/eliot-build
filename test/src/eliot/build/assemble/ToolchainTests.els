import eliot.collection.List
import eliot.test.Assertion
import eliot.test.Test
import eliot.build.model.PackageId
import eliot.build.model.Version
import eliot.build.model.Descriptor
import eliot.build.assets.Assets
import eliot.build.resolve.PackageSource
import eliot.build.resolve.Configuration
import eliot.build.resolve.Resolution
import eliot.build.resolve.TablePackages
import eliot.build.assemble.Toolchain

/**
 * What a closure says to run with: which asset is the compiler, which word calls the backend, which
 * binaries come along, and where the entry point is.
 *
 * Run against `eliot.build.resolve.TablePackages`, so every descriptor here is a string and nothing is
 * fetched — the subject is what `plugin` and `main` clauses *mean* across a resolution, which is the
 * one thing no descriptor reader can decide alone. The universe is the eliot repository's own shape,
 * because it is the shape the question was invented for: a compiler asset in `lang`, a bare
 * contributor in `stdlib`, a backend in `jvm`, and an `apidoc` backend nobody has selected.
 *
 * **The entry point is read the same way the compiler is**, which is the whole of what Q4 became: a
 * suite's `main` comes from the framework it deps and an application's from the package that is the
 * application, and neither is a case the tool special-cases. The two refusals are the same pair as
 * everywhere else here — none in the closure, or two.
 */
def testCases: Test = {
   "toolchainOf" should "find the compiler in the asset whose plugin claims it" in {
      toolchainFor(dependingOnJvm) shouldBe expectedEliotToolchain
   }
   "toolchainOf" should "call the backend by the word its provider registered, lang and stdlib not counting" in {
      backendOf(dependingOnJvm) shouldBe "jvm"
   }
   "toolchainOf" should "carry the asset of every package the closure mounted, in the resolution's order" in {
      assetsOf(dependingOnJvm) shouldBe expectedEliotAssets
   }
   "toolchainOf" should "leave out the asset of a package nobody selected" in {
      assetsOf(dependingOnJvm).contains("eliot-apidoc.zip").shouldBeFalse
   }
   "toolchainOf" should "take the entry point from the package being built, where it declares one" in {
      mainOf(dependingOnJvm) shouldBe "Hello"
   }
   "toolchainOf" should "take a suite's entry point from the framework, which declares its own" in {
      mainFor("test", suiteDependingOnFramework) shouldBe "eliot.test.Runner"
   }
   "toolchainOf" should "refuse a closure in which nothing declares a main" in {
      toolchainForName("test", suiteWithNoFramework)
         shouldBe "nothing in 'test' declares a main, so there is nothing to run"
   }
   "toolchainOf" should "refuse a closure declaring two mains, which is why an executable is its own package" in {
      toolchainFor(dependingOnFrameworkAndRunnable) shouldBe expectedMainConflict
   }
   "toolchainOf" should "refuse a closure in which nothing ships a compiler" in {
      toolchainFor(rootPackage("dep github.com/x/foo v1.2\nmain Hello"))
         shouldBe "nothing 'root' depends on ships a compiler"
   }
   "toolchainOf" should "refuse a closure in which two assets claim to be the compiler" in {
      toolchainFor(dependingOnBothCompilers) shouldBe expectedCompilerConflict
   }
   "toolchainOf" should "refuse a closure that ships a compiler but no backend" in {
      toolchainFor(rootPackage("dep github.com/e/eliot//stdlib v1.2\nmain Hello"))
         shouldBe "nothing 'root' depends on ships a backend"
   }
   "toolchainOf" should "refuse a closure shipping two backends, which is two platform layers" in {
      toolchainForName("app", twoPlatforms) shouldBe expectedBackendConflict
   }
}

/**
 * The eliot repository as its descriptor declares it: one asset per package, the compiler marker on
 * `lang` because `eliotc` has no package of its own to ride in, and the backend word on `jvm`.
 * `apidoc` is here as the package a dependency line has to name before any of it arrives.
 */
private def eliotPackages: String =
   "package lang {\n  plugin eliot-compiler.zip {\n    compiler\n  }\n}\n" ++
      "package stdlib {\n  dep //lang\n  plugin eliot-stdlib.zip\n}\n" ++
      "package jvm {\n  dep //stdlib\n  plugin eliot-jvm.zip {\n    backend jvm\n  }\n}\n" ++
      "package apidoc {\n  dep //lang\n  plugin eliot-apidoc.zip {\n    backend apidoc\n  }\n}"

private def dependingOnJvm: String = rootPackage("dep github.com/e/eliot//jvm v1.2\nmain Hello")

/**
 * A suite as the design has one: a package that deps the library beside it and the framework, and
 * declares no entry point of its own because the framework declares one about itself.
 */
private def suiteDependingOnFramework: String =
   rootPackage("dep github.com/e/eliot//jvm v1.2") ++
      "\npackage test {\n  dep //root\n  dep github.com/e/eliot-test v1.0\n}"

private def suiteWithNoFramework: String =
   rootPackage("dep github.com/e/eliot//jvm v1.2") ++ "\npackage test {\n  dep //root\n}"

/**
 * The mistake the executable-is-its-own-package rule exists to prevent, written out: a library that
 * declares a `main` of its own, and a suite that then inherits it alongside the framework's.
 */
private def dependingOnFrameworkAndRunnable: String =
   rootPackage("dep github.com/e/eliot//jvm v1.2\ndep github.com/e/eliot-test v1.0\nmain Hello")

/**
 * Both packages of a repository whose two assets each claim the marker — which no descriptor reader
 * could refuse, since each descriptor is read alone and there is only one here.
 */
private def dependingOnBothCompilers: String =
   rootPackage("dep github.com/two/compilers//one v1.0\ndep github.com/two/compilers//other v1.0\nmain Hello")

/**
 * Two repositories that each ship a backend, which is two platform layers in one closure. There is
 * nothing to name any more and nothing to choose: the two would collide on every name they implement,
 * so the honest answer is that this closure describes no one build.
 */
private def twoPlatforms: String =
   "package app {\n  dep github.com/e/eliot//jvm v1.2\n  dep github.com/a/avr//avr v1.0\n  main Hello\n}"

private def expectedEliotToolchain: String =
   "github.com/e/eliot@v1.2/eliot-compiler.zip jvm " ++ expectedEliotAssets

private def expectedEliotAssets: String =
   "github.com/e/eliot@v1.2/eliot-compiler.zip, github.com/e/eliot@v1.2/eliot-stdlib.zip, " ++
      "github.com/e/eliot@v1.2/eliot-jvm.zip"

private def expectedCompilerConflict: String =
   "both github.com/two/compilers@v1.0/one.zip and github.com/two/compilers@v1.0/other.zip " ++
      "claim to be the compiler"

private def expectedBackendConflict: String =
   "both github.com/a/avr@v1.0/avr.zip and github.com/e/eliot@v1.2/eliot-jvm.zip " ++
      "ship a backend, so one has to be named"

private def expectedMainConflict: String =
   "both Hello and eliot.test.Runner are declared as a main, so there is no one entry point"

/**
 * The whole toolchain on one line, or the one line naming what refused — so a case says what was found
 * *and* in what order, the way `AssemblyTests` says what was mounted.
 */
private def toolchainFor(rootText: String): String = described(rootPackageName, rootText, shown)

private def toolchainForName(name: String, rootText: String): String =
   described(PackageName(name), rootText, shown)

private def assetsOf(rootText: String): String = described(rootPackageName, rootText, shownAssets)

private def backendOf(rootText: String): String = described(rootPackageName, rootText, shownBackend)

private def mainOf(rootText: String): String = described(rootPackageName, rootText, shownMain)

private def mainFor(name: String, rootText: String): String =
   described(PackageName(name), rootText, shownMain)

/**
 * Rendered *inside* the `against`, as every resolving case in this project is and for the reason
 * `eliot.build.resolve.ResolutionTests` records: two `provide[Universe, _]` instantiations whose JVM
 * descriptors agree get one native between them.
 *
 * `ToolchainError` is discharged in here too rather than travelling out, because `against` answers the
 * resolver's channel alone and a toolchain refusal is a line a user reads, not a second `Either` for a
 * test to unfold.
 */
private def described(
   name: PackageName,
   rootText: String,
   rendering: Toolchain => String
): String =
   rendered(against(universe, catching(rendering, name, descriptorOf(rootText))))

private def catching(
   rendering: Toolchain => String,
   name: PackageName,
   descriptor: Descriptor
): {PackageSource, Throw[ResolutionError]} String =
   catch[ToolchainError, String](
      rendering(toolchainOf(name, descriptor, resolve(name, descriptor))),
      problem -> show(problem)
   )

private def rendered(outcome: Either[ResolutionError, String]): String =
   foldEither(error -> show(error), found -> found, outcome)

private def shown(toolchain: Toolchain): String =
   show(toolchain.compilerAsset) ++ " " ++ toolchain.backendWord ++ " " ++ shownAssets(toolchain)

private def shownAssets(toolchain: Toolchain): String = toolchain.toolchainAssets.map(show).joined(", ")

private def shownBackend(toolchain: Toolchain): String = toolchain.backendWord

private def shownMain(toolchain: Toolchain): String = toolchain.toolchainMain

private def universe: Universe =
   universeOf(
      published("github.com/e/eliot@v1.2", eliotPackages,
         published("github.com/a/avr@v1.0", "package avr {\n  plugin avr.zip {\n    backend avr\n  }\n}",
            published("github.com/x/foo@v1.2", "",
               published("github.com/e/eliot-test@v1.0", rootPackage("main eliot.test.Runner"),
                  published("github.com/two/compilers@v1.0", twoCompilerPackages, empty))))),
      empty
   )

private def twoCompilerPackages: String =
   "package one {\n  plugin one.zip {\n    compiler\n  }\n}\n" ++
      "package other {\n  plugin other.zip {\n    compiler\n  }\n}"

private def published(key: String, text: String, entries: List[Pair[String, String]]): List[Pair[String, String]] =
   append(entries, Pair(key, text))
