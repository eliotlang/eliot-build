import eliot.collection.List
import eliot.test.Assertion
import eliot.test.Test
import eliot.build.model.PackageId
import eliot.build.model.Version
import eliot.build.model.Descriptor
import eliot.build.format.PackageFile
import eliot.build.format.DescriptorWriter

def testCases: Test = {
   "parseDescriptor" should "read the minimal library descriptor of the design" in {
      roundTrip("dep github.com/eliot-lang/eliot//stdlib v1\ndep github.com/somelib/collections v1.3")
   }
   "parseDescriptor" should "keep a package selector apart from the URL it narrows" in {
      parsed("dep github.com/eliot-lang/eliot//stdlib v1.2")
         shouldBe "dep github.com/eliot-lang/eliot//stdlib v1.2"
   }
   "parseDescriptor" should "read a sibling reference, which carries no version" in {
      parsed("package jvm {\n   dep //stdlib\n}") shouldBe "package jvm {\n  dep //stdlib\n}"
   }
   "parseDescriptor" should "read an application targeting two platforms" in {
      roundTrip(
         "dep github.com/somelib/sensor-api v2\n" ++
         "package controller-jvm {\n" ++
         "  dep //root\n" ++
         "  dep github.com/eliot-lang/eliot//jvm v1\n" ++
         "  main Controller\n" ++
         "}\n" ++
         "package controller-attiny {\n" ++
         "  dep //root\n" ++
         "  dep github.com/vendor/eliot-avr//attiny85 v1\n" ++
         "  main Controller\n" ++
         "}"
      )
   }
   "parseDescriptor" should "read a suite as an ordinary package depending on the root" in {
      roundTrip(
         "dep github.com/eliot-lang/eliot//stdlib v1\n" ++
         "package test {\n" ++
         "  dep //root\n" ++
         "  dep github.com/eliot-lang/eliot//jvm-test v1\n" ++
         "}"
      )
   }
   "parseDescriptor" should "read the eliot repository's own multi-package shape" in {
      roundTrip(
         "package lang {\n" ++
         "  at lang/eliot\n" ++
         "  plugin eliot-compiler.zip {\n    compiler\n  }\n}\n" ++
         "package jvm {\n" ++
         "  at jvm/eliot\n" ++
         "  dep //stdlib\n" ++
         "  plugin eliot-jvm.zip {\n    backend jvm\n  }\n}\n" ++
         "package examples {\n  internal\n  dep //jvm\n}"
      )
   }
   "parseDescriptor" should "read a plugin that is neither a backend nor the compiler" in {
      roundTrip("package contrib {\n  plugin eliot-contrib.zip\n}")
   }
   "parseDescriptor" should "let the root package itself be the executable" in {
      roundTrip("dep github.com/eliot-lang/eliot//jvm v1\nmain Hello")
   }
   "parseDescriptor" should "canonicalize a dependency URL, so one package is one identity" in {
      parsed("dep GitHub.com/x/foo.git v1") shouldBe "dep github.com/x/foo v1"
   }
   "parseDescriptor" should "treat a package as exported unless it says otherwise" in {
      parsed("package lang {\n   dep //other\n}") shouldBe "package lang {\n  dep //other\n}"
   }
   "parseDescriptor" should "give a package the directory its own name spells, where it says nothing" in {
      directoryOf("stdlib", "package stdlib {\n   dep //lang\n}") shouldBe "stdlib"
   }
   "parseDescriptor" should "put the root package at the repository root, which is not a choice" in {
      directoryOf("root", "dep github.com/x/foo v1") shouldBe "."
   }
   "parseDescriptor" should "let a package say where it is, for a repository that is not flat" in {
      directoryOf("stdlib", "package stdlib {\n   at stdlib/eliot\n}") shouldBe "stdlib/eliot"
   }
   "parseDescriptor" should "keep a package's directory apart from the name dependents select it by" in {
      roundTrip("package lang {\n  at lang/eliot\n  dep //stdlib\n}")
   }
   "parseDescriptor" should "write no 'at' where the directory is the package's name, which already said it" in {
      parsed("package lang {\n   at lang\n}") shouldBe "package lang"
   }
   "parseDescriptor" should "reject an 'at' naming no directory" in {
      parsed("package lang {\n   at\n}") shouldBe "an 'at' needs a directory in 'at'"
   }
   "parseDescriptor" should "reject an absolute package directory, which no checkout contains" in {
      parsed("package lang {\n   at /etc\n}")
         shouldBe "a package directory is a path inside the repository in 'at /etc'"
   }
   "parseDescriptor" should "reject a package directory climbing out of the repository" in {
      parsed("package lang {\n   at ../elsewhere\n}")
         shouldBe "a package directory is a path inside the repository in 'at ../elsewhere'"
   }
   "parseDescriptor" should "yield nothing but a bare root package for a file of comments alone" in {
      parsed("-- nothing to declare\n\n-- really") shouldBe ""
   }
   "parseDescriptor" should "read a retired 'module' block as the package it always was" in {
      parsed("module lang {\n  at lang/eliot\n  dep //stdlib\n}")
         shouldBe "package lang {\n  at lang/eliot\n  dep //stdlib\n}"
   }
   "parseDescriptor" should "drop a retired 'test' block, which never reached a consumer" in {
      parsed("dep github.com/x/foo v1\ntest {\n  dep github.com/y/bar v2\n}")
         shouldBe "dep github.com/x/foo v1"
   }
   "parseDescriptor" should "drop a retired 'artifact' block, which nothing could ever depend on" in {
      parsed("dep github.com/x/foo v1\nartifact hello {\n  backend {\n    kind exe-jar\n  }\n}")
         shouldBe "dep github.com/x/foo v1"
   }
   "parseDescriptor" should "reject an unknown top-level clause, pointing at the upgrade" in {
      parsed("registry https://example.com")
         shouldBe "unknown clause 'registry'; this descriptor may need a newer eliot in 'registry https://example.com'"
   }
   "parseDescriptor" should "reject an unknown clause inside a package" in {
      parsed("package lang {\n   exports everything\n}")
         shouldBe "unknown clause 'exports'; this descriptor may need a newer eliot in 'exports everything'"
   }
   "parseDescriptor" should "reject a dependency URL carrying a scheme" in {
      parsed("dep https://github.com/x/foo v1")
         shouldBe "a dependency URL carries no scheme in 'dep https://github.com/x/foo v1'"
   }
   "parseDescriptor" should "reject a version that is not a tag" in {
      parsed("dep github.com/x/foo 1.3") shouldBe "a version must be a tag like 'v1.3' in 'dep github.com/x/foo 1.3'"
   }
   "parseDescriptor" should "reject a version range, which the model has no way to mean" in {
      parsed("dep github.com/x/foo >=v1.3")
         shouldBe "a version must be a tag like 'v1.3' in 'dep github.com/x/foo >=v1.3'"
   }
   "parseDescriptor" should "reject a version carrying a third component" in {
      parsed("dep github.com/x/foo v1.2.3")
         shouldBe "a version must be a tag like 'v1.3' in 'dep github.com/x/foo v1.2.3'"
   }
   "parseDescriptor" should "reject a dep with no URL at all" in {
      parsed("dep") shouldBe "a dep needs a package URL in 'dep'"
   }
   "parseDescriptor" should "reject a foreign dependency that declares no minimum" in {
      parsed("dep github.com/x/foo") shouldBe "a foreign dependency needs a minimum version in 'dep github.com/x/foo'"
   }
   "parseDescriptor" should "reject a version on a sibling, which versions with its repository" in {
      parsed("package jvm {\n   dep //stdlib v1.2\n}")
         shouldBe "a sibling package versions with its repository and carries no version in 'dep //stdlib v1.2'"
   }
   "parseDescriptor" should "reject a dep carrying more than a URL and a version" in {
      parsed("dep github.com/x/foo v1 extra") shouldBe "too many arguments in 'dep github.com/x/foo v1 extra'"
   }
   "parseDescriptor" should "reject a main naming no module" in {
      parsed("package launcher {\n  main\n}") shouldBe "a main needs the module holding it in 'main'"
   }
   "parseDescriptor" should "reject a plugin naming no asset" in {
      parsed("package lang {\n  plugin\n}")
         shouldBe "a plugin needs a release asset name in 'plugin'"
   }
   "parseDescriptor" should "reject a plugin backend that does not say which word it registers" in {
      parsed("package jvm {\n  plugin eliot-jvm.zip {\n    backend\n  }\n}")
         shouldBe "a plugin's backend needs the command word it registers in 'backend'"
   }
   "parseDescriptor" should "reject the Maven-era jar pin, which the lockfile records now" in {
      parsed("package lang {\n  plugin eliot-lang.zip {\n    jar c:d:2 sha256 9f2ca9b1\n  }\n}")
         shouldBe ("unknown clause 'jar'; this descriptor may need a newer eliot in " ++
            "'jar c:d:2 sha256 9f2ca9b1'")
   }
   "parseDescriptor" should "reject a replacement, which the resolver has no way to honour" in {
      parsed("replace github.com/x/foo with ../foo-local")
         shouldBe ("unknown clause 'replace'; this descriptor may need a newer eliot in " ++
            "'replace github.com/x/foo with ../foo-local'")
   }
   "parseDescriptor" should "report a syntax error as such" in {
      parsed("dep a v1\n}") shouldBe "line 2: unmatched '}' in '}'"
   }
}

/**
 * The descriptor `text` spells, rendered back into `eliot.pkg` syntax — or the error it fails with,
 * so both outcomes are asserted the same way.
 */
private def parsed(text: String): String =
   foldEither(
      error -> show(error),
      descriptor -> renderDescriptor(descriptor),
      runThrow[DescriptorError](parseDescriptor(split("\n", text)))
   )

/**
 * Where the package called `name` says it is — the one thing the rendering cannot show, since a
 * directory that is the package's name is written as the name alone, and the root package's is never
 * written at all.
 */
private def directoryOf(name: String, text: String): String =
   foldEither(
      error -> show(error),
      descriptor -> foldOption("", built -> built.packageRoot, packageNamed(PackageName(name), descriptor)),
      runThrow[DescriptorError](parseDescriptor(split("\n", text)))
   )

/**
 * Assert that `text` survives being read into the model and written back out unchanged — the
 * strongest statement available without an `Eq` for the model: every clause was understood, and
 * nothing was invented.
 */
private def roundTrip(text: String): {Throw[AssertionError]} Unit = parsed(text) shouldBe text
