import eliot.collection.List
import eliot.file.Path
import eliot.build.format.Clause
import eliot.build.model.PackageId
import eliot.build.model.Version
import eliot.build.model.Descriptor
import eliot.build.model.Lineage
import eliot.build.format.PackageFile
import eliot.build.resolve.PackageSource
import eliot.build.resolve.Resolution

/**
 * A package source that is a table of strings: what a resolver test binds in place of git.
 *
 * It is a **named implementation**, so it is never searched and never overlaps the git-backed default
 * — there is no coherence question to answer and no "minimum" a fake has to implement to stay the
 * unique survivor. A resolver test writes one `with` and gets descriptors instead of a subprocess.
 *
 * The table itself arrives as `{Dep[Universe]}`, declared by the clauses that read it. A named
 * implementation takes no parameters and closes over nothing: what it needs at runtime it asks an
 * effect for, and `against` is where that ask is answered. The effect is charged at the binding site
 * rather than at every question the resolver asks, which is why `eliot.build.resolve.Resolution` says
 * `{PackageSource, Throw[ResolutionError]}` and nothing about tables.
 */

data Universe(publications: List[Pair[String, String]], lineages: List[Pair[String, String]])

implement tablePackages: PackageSource {
   def descriptorAt(version: Version, target: Repository): {Dep[Universe]} Option[Descriptor] =
      publicationIn(dependency, show(target) ++ "@" ++ show(version))

   def anchorAt(line: Line, target: Repository): {Dep[Universe]} Option[Commit] =
      dependency.lineages.lookupOption(show(target) ++ "@" ++ lineName(line)).mapOption(hash -> Commit(hash))

   /**
    * A table has no history either, so a version it publishes is said to be at a commit named after
    * it — `github.com/x/foo@v1.2` — which is as stable as a real tag is supposed to be and lets a case
    * read which version a commit came from.
    */
   def commitAt(version: Version, target: Repository): {Dep[Universe]} Option[Commit] =
      dependency.publications.lookupOption(show(target) ++ "@" ++ show(version))
         .mapOption(_ -> Commit(show(target) ++ "@" ++ show(version)))

   /**
    * A table has no repositories to check anything out of, so it answers where a tree *would* be: one
    * directory per commit, named by it, the way the git-backed source names one. A table's commit is
    * already `<url>@<tag>` (`commitAt` above), so the tree is `/trees/<url>@<tag>` and a case still
    * reads which version was mounted — and, since the commit is the only thing asked for, that it was
    * the commit `commitAt` answered. That is enough for an assembly test, whose subject is what gets
    * mounted under a tree rather than how the tree got there.
    */
   def sourcesAt(commit: Commit, target: Repository): Path = path("/trees/" ++ show(commit))
}

/**
 * The universe `publications` and `lineages` describe, each an association list the tests build.
 */
def universeOf(publications: List[Pair[String, String]], lineages: List[Pair[String, String]]): Universe =
   Universe(publications, lineages)

/**
 * What `computation` answers against `universe` — a case's rendering of what it resolved, or the error
 * resolution raised, shown — so both outcomes are asserted the same way, as one line.
 *
 * The one place the test source is chosen, and the one place its table is supplied: `with
 * tablePackages` binds the slot's `PackageSource`, and `provide` answers the `Dep[Universe]` those
 * clauses declare. Production code inside `computation` names neither. The `catch`'s type arguments are
 * spelled because the computation is a parameter, whose declaration cannot say which `Throw` it raises.
 */
def against(
      universe: Universe,
      computation: {PackageSource, Throw[ResolutionError]} String with tablePackages
   ): String =
   provide(universe, catch[ResolutionError, String](computation, error -> show(error)))

/**
 * The descriptor `text` spells, read as a mirror's is, and taken as empty where it spells nothing
 * readable. A malformed descriptor is `eliot.build.format.PackageFile`'s
 * subject, and nothing here is about it.
 */
def descriptorOf(text: String): Descriptor =
   parseDescriptor(split("\n", text)) catch (_ -> Descriptor(empty))

/**
 * The descriptor of a repository that is one package at its root, declaring `clauses` — the common
 * case written out the one way it is written, so a case spells its `dep` lines and nothing else.
 *
 * ```eliot
 * resolved(rootPackage("dep github.com/x/foo//root v1.2"), publishing("github.com/x/foo@v1.2", rootPackage("")))
 * ```
 */
def rootPackage(clauses: String): String =
   "package root {\n  at .\n" ++ (if(clauses == "") "" else clauses ++ "\n") ++ "}"

private def publicationIn(universe: Universe, key: String): Option[Descriptor] =
   universe.publications.lookupOption(key).mapOption(descriptorOf)
