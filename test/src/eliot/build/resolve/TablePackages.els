import eliot.collection.List
import eliot.file.Path
import eliot.build.format.Clause
import eliot.build.model.PackageId
import eliot.build.model.Version
import eliot.build.model.Descriptor
import eliot.build.model.Lineage
import eliot.build.format.PackageFile
import eliot.build.resolve.PackageSource
import eliot.build.resolve.Resolution

/**
 * A package source that is a table of strings: what a resolver test binds in place of git.
 *
 * It is a **named implementation**, so it is never searched and never overlaps the git-backed default
 * — there is no coherence question to answer and no "minimum" a fake has to implement to stay the
 * unique survivor. A resolver test writes one `with` and gets descriptors instead of a subprocess.
 *
 * The table itself arrives as `{Dep[Universe]}`, declared by the clauses that read it. A named
 * implementation takes no parameters and closes over nothing: what it needs at runtime it asks an
 * effect for, and `against` is where that ask is answered. The effect is charged at the binding site
 * rather than at every question the resolver asks, which is why `eliot.build.resolve.Resolution` says
 * `{PackageSource, Throw[ResolutionError]}` and nothing about tables.
 */

data Universe(publications: List[Pair[String, String]], lineages: List[Pair[String, String]])

implement tablePackages: PackageSource {
   def descriptorAt(version: Version, target: Repository): {Dep[Universe]} Option[Descriptor] =
      publicationIn(dependency, show(target) ++ "@" ++ show(version))

   def anchorAt(line: Line, target: Repository): {Dep[Universe]} Option[Commit] =
      foldOption(
         None,
         hash -> Some(Commit(hash)),
         dependency.lineages.lookupOption(show(target) ++ "@" ++ branchName(line))
      )

   /**
    * A table has no repositories to check anything out of, so it answers where a tree *would* be, in
    * the shape the git-backed source puts one: one directory per package, named by its version. That
    * is enough for an assembly test, whose subject is what gets mounted under a tree rather than how
    * the tree got there.
    */
   def sourcesAt(version: Version, target: Repository): Path =
      path("/trees/" ++ show(target) ++ "@" ++ show(version))
}

/**
 * The universe `publications` and `lineages` describe, each an association list the tests build.
 */
def universeOf(publications: List[Pair[String, String]], lineages: List[Pair[String, String]]): Universe =
   Universe(publications, lineages)

/**
 * What `computation` answers against `universe` — the selections, or the error resolution raised.
 *
 * The one place the test source is chosen, and the one place its table is supplied: `with
 * tablePackages` binds the slot's `PackageSource`, and `provide` answers the `Dep[Universe]` those
 * clauses declare. Production code inside `computation` names neither.
 */
def against[A](
      universe: Universe,
      computation: {PackageSource, Throw[ResolutionError]} A with tablePackages
   ): Either[ResolutionError, A] =
   provide(universe, runThrow[ResolutionError, A](computation))

/**
 * The descriptor `text` spells, taken as empty where it spells nothing readable. A malformed
 * descriptor is `eliot.build.format.PackageFile`'s subject, and nothing here is about it.
 */
def descriptorOf(text: String): Descriptor =
   foldEither(
      _ -> emptyDescriptor,
      descriptor -> descriptor,
      runThrow[DescriptorError, Descriptor](parseDescriptor(split("\n", text)))
   )

private def publicationIn(universe: Universe, key: String): Option[Descriptor] =
   foldOption(None, text -> Some(descriptorOf(text)), universe.publications.lookupOption(key))
