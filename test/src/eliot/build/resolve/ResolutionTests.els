import eliot.collection.List
import eliot.test.Assertion
import eliot.test.Test
import eliot.build.model.PackageId
import eliot.build.model.Version
import eliot.build.resolve.Configuration
import eliot.build.resolve.Selection
import eliot.build.resolve.Resolution
import eliot.build.resolve.TablePackages

def testCases: Test = {
   "resolve" should "select the version the only requirement declared" in {
      resolved(
         rootPackage("dep github.com/x/foo//root v1.2"),
         publishing("github.com/x/foo@v1.2", rootPackage(""))
      ) shouldBe "github.com/x/foo v1.2"
   }
   "resolve" should "select the maximum of two declared minimums" in {
      resolved(
         rootPackage("dep github.com/x/foo//root v1.2\ndep github.com/x/foo//root v1.4"),
         publishing("github.com/x/foo@v1.2", rootPackage("")).published("github.com/x/foo@v1.4", rootPackage(""))
      ) shouldBe "github.com/x/foo v1.4"
   }
   "resolve" should "keep a requirement that asks for less than is already selected" in {
      resolved(
         rootPackage("dep github.com/x/foo//root v1.4\ndep github.com/x/foo//root v1.1"),
         publishing("github.com/x/foo@v1.4", rootPackage(""))
      ) shouldBe "github.com/x/foo v1.4"
   }
   "resolve" should "follow what a dependency itself requires" in {
      resolved(
         rootPackage("dep github.com/x/foo//root v1.2"),
         publishing("github.com/x/foo@v1.2", rootPackage("dep github.com/x/bar//root v1.1"))
            .published("github.com/x/bar@v1.1", rootPackage(""))
      ) shouldBe "github.com/x/bar v1.1, github.com/x/foo v1.2"
   }
   "resolve" should "raise a transitive minimum above a direct one" in {
      resolved(
         rootPackage("dep github.com/x/foo//root v1.2\ndep github.com/x/bar//root v1.0"),
         publishing("github.com/x/foo@v1.2", rootPackage("dep github.com/x/bar//root v1.5"))
            .published("github.com/x/bar@v1.0", rootPackage(""))
            .published("github.com/x/bar@v1.5", rootPackage(""))
      ) shouldBe "github.com/x/bar v1.5, github.com/x/foo v1.2"
   }
   "resolve" should "follow the edges of the package a dependency line selected" in {
      resolved(
         rootPackage("dep github.com/x/foo//jvm v1.2"),
         publishing("github.com/x/foo@v1.2", "package jvm {\n  dep github.com/x/bar//root v1.1\n}")
            .published("github.com/x/bar@v1.1", rootPackage(""))
      ) shouldBe "github.com/x/bar v1.1, github.com/x/foo v1.2"
   }
   "resolve" should "leave the edges of a package nobody selected out of the closure" in {
      resolved(
         rootPackage("dep github.com/x/foo//root v1.2"),
         publishing("github.com/x/foo@v1.2", "package jvm {\n  dep github.com/x/bar//root v1.1\n}")
            .published("github.com/x/bar@v1.1", rootPackage(""))
      ) shouldBe "github.com/x/foo v1.2"
   }
   "resolve" should "follow a selected package's siblings, which is how a layer carries its base" in {
      resolved(
         rootPackage("dep github.com/e/eliot//jvm v1.2"),
         publishing(
            "github.com/e/eliot@v1.2",
            "package jvm {\n  dep //stdlib\n}\npackage stdlib {\n  dep github.com/x/bar//root v1.1\n}"
         ).published("github.com/x/bar@v1.1", rootPackage(""))
      ) shouldBe "github.com/e/eliot v1.2, github.com/x/bar v1.1"
   }
   "resolve" should "record every package of a repository the closure reached" in {
      mounted(
         "github.com/e/eliot",
         rootPackage("dep github.com/e/eliot//jvm v1.2"),
         publishing("github.com/e/eliot@v1.2", "package jvm {\n  dep //stdlib\n}\npackage stdlib {\n}")
      ) shouldBe "//jvm, //stdlib"
   }
   "resolve" should "record a package called 'root' like any other" in {
      mounted(
         "github.com/x/foo",
         rootPackage("dep github.com/x/foo//root v1.2"),
         publishing("github.com/x/foo@v1.2", rootPackage(""))
      ) shouldBe "//root"
   }
   "resolve" should "follow a package at the repository root whatever it is called" in {
      resolved(
         rootPackage("dep github.com/x/foo//core v1.2"),
         publishing("github.com/x/foo@v1.2", "package core {\n  at .\n  dep github.com/x/bar//root v1.1\n}")
            .published("github.com/x/bar@v1.1", rootPackage(""))
      ) shouldBe "github.com/x/bar v1.1, github.com/x/foo v1.2"
   }
   "resolve" should "follow a selector to its package and no further" in {
      resolved(
         rootPackage("dep github.com/x/foo//root v1.2"),
         publishing(
            "github.com/x/foo@v1.2",
            rootPackage("dep github.com/x/base//root v1.0") ++ "\npackage test {\n  dep github.com/x/tester//root v1\n}"
         ).published("github.com/x/base@v1.0", rootPackage(""))
      ) shouldBe "github.com/x/base v1.0, github.com/x/foo v1.2"
   }
   "resolve" should "leave a dependency's own suite out of the closure, since nothing deps it" in {
      resolved(
         rootPackage("dep github.com/x/foo//root v1.2"),
         publishing(
            "github.com/x/foo@v1.2",
            "package test {\n  dep github.com/x/tester//root v1.0\n}"
         ).published("github.com/x/tester@v1.0", rootPackage(""))
      ) shouldBe "github.com/x/foo v1.2"
   }
   "resolve" should "treat two package selectors into one repository as one selection" in {
      resolved(
         rootPackage("dep github.com/e/eliot//stdlib v1.2\ndep github.com/e/eliot//jvm v1.4"),
         publishing("github.com/e/eliot@v1.2", rootPackage("")).published("github.com/e/eliot@v1.4", rootPackage(""))
      ) shouldBe "github.com/e/eliot v1.4"
   }
   "resolve" should "select nothing for a sibling, which versions with its own repository" in {
      resolved(rootPackage("dep //stdlib"), publishing("unused", "")) shouldBe ""
   }
   "resolve" should "open a sibling package of the project, which is how a suite reaches its library" in {
      resolvedFor(
         "test",
         rootPackage("dep github.com/x/base//root v1.0") ++
            "\npackage test {\n  dep //root\n  dep github.com/x/tester//root v1.0\n}",
         publishing("github.com/x/base@v1.0", rootPackage("")).published("github.com/x/tester@v1.0", rootPackage(""))
      ) shouldBe "github.com/x/base v1.0, github.com/x/tester v1.0"
   }
   "resolve" should "leave the project's own library out of a package that does not dep it" in {
      resolvedFor(
         "test",
         rootPackage("dep github.com/x/base//root v1.0") ++ "\npackage test {\n  dep github.com/x/tester//root v1.0\n}",
         publishing("github.com/x/base@v1.0", rootPackage("")).published("github.com/x/tester@v1.0", rootPackage(""))
      ) shouldBe "github.com/x/tester v1.0"
   }
   "resolve" should "reach a package by every path a diamond offers, selecting it once" in {
      resolved(
         rootPackage("dep github.com/x/left//root v1.0\ndep github.com/x/right//root v1.0"),
         publishing("github.com/x/left@v1.0", rootPackage("dep github.com/x/base//root v1.1"))
            .published("github.com/x/right@v1.0", rootPackage("dep github.com/x/base//root v1.3"))
            .published("github.com/x/base@v1.1", rootPackage(""))
            .published("github.com/x/base@v1.3", rootPackage(""))
      ) shouldBe "github.com/x/base v1.3, github.com/x/left v1.0, github.com/x/right v1.0"
   }
   "resolve" should "terminate on a dependency cycle" in {
      resolved(
         rootPackage("dep github.com/x/foo//root v1.0"),
         publishing("github.com/x/foo@v1.0", rootPackage("dep github.com/x/bar//root v1.0"))
            .published("github.com/x/bar@v1.0", rootPackage("dep github.com/x/foo//root v1.0"))
      ) shouldBe "github.com/x/bar v1.0, github.com/x/foo v1.0"
   }
   "resolve" should "call two URLs one package when their anchors agree" in {
      resolvedWithAnchors(
         rootPackage("dep github.com/x/foo//root v1.2\ndep gitlab.com/mirror/foo//root v1.4"),
         publishing("github.com/x/foo@v1.2", rootPackage("")).published("github.com/x/foo@v1.4", rootPackage("")),
         anchoring("github.com/x/foo@v1", "a1b2c3").anchored("gitlab.com/mirror/foo@v1", "a1b2c3")
      ) shouldBe "github.com/x/foo v1.4"
   }
   "resolve" should "keep two packages apart when their anchors differ" in {
      resolvedWithAnchors(
         rootPackage("dep github.com/x/foo//root v1.2\ndep gitlab.com/other/foo//root v1.4"),
         publishing("github.com/x/foo@v1.2", rootPackage("")).published("gitlab.com/other/foo@v1.4", rootPackage("")),
         anchoring("github.com/x/foo@v1", "a1b2c3").anchored("gitlab.com/other/foo@v1", "d4e5f6")
      ) shouldBe "github.com/x/foo v1.2, gitlab.com/other/foo v1.4"
   }
   "resolve" should "unify nothing on a missing anchor, which is evidence of nothing" in {
      resolved(
         rootPackage("dep github.com/x/foo//root v1.2\ndep gitlab.com/mirror/foo//root v1.4"),
         publishing("github.com/x/foo@v1.2", rootPackage("")).published("gitlab.com/mirror/foo@v1.4", rootPackage(""))
      ) shouldBe "github.com/x/foo v1.2, gitlab.com/mirror/foo v1.4"
   }
   "resolve" should "refuse two compatibility lines of one package" in {
      resolved(
         rootPackage("dep github.com/x/foo//root v1.2\ndep github.com/x/foo//root v2.0"),
         publishing("github.com/x/foo@v1.2", rootPackage(""))
      ) shouldBe "github.com/x/foo is required at both v1.2 and v2.0, which are different compatibility lines"
   }
   "resolve" should "report a version the source does not publish" in {
      resolved(
         rootPackage("dep github.com/x/foo//root v1.2"),
         publishing("github.com/x/foo@v1.1", rootPackage(""))
      ) shouldBe "github.com/x/foo publishes no v1.2"
   }
   "resolve" should "resolve an executable together with the library it deps" in {
      resolvedFor(
         "controller-jvm",
         rootPackage("dep github.com/x/api//root v2.0") ++
            "\npackage controller-jvm {\n  dep //root\n  dep github.com/x/jvm//root v1.3\n}",
         publishing("github.com/x/api@v2.0", rootPackage("")).published("github.com/x/jvm@v1.3", rootPackage(""))
      ) shouldBe "github.com/x/api v2.0, github.com/x/jvm v1.3"
   }
   "resolve" should "leave another executable's platform layer out of this one" in {
      resolvedFor(
         "controller-jvm",
         "package controller-jvm {\n  dep github.com/x/jvm//root v1.3\n}\n" ++
            "package controller-attiny {\n  dep github.com/x/avr//root v1.1\n}",
         publishing("github.com/x/jvm@v1.3", rootPackage("")).published("github.com/x/avr@v1.1", rootPackage(""))
      ) shouldBe "github.com/x/jvm v1.3"
   }
   "resolve" should "report a package the descriptor does not name" in {
      resolvedFor("controller-avr", "package controller-jvm {\n}", publishing("unused", ""))
         shouldBe "no package named 'controller-avr'"
   }
   "resolutionDepthLimit" should "be the number of rounds the closure may take" in {
      show(resolutionDepthLimit) shouldBe "64"
   }
}

/**
 * A package universe held as data: what each repository publishes at each version, as descriptor
 * text, and what each compatibility line's anchor tag names.
 *
 * The resolver never sees these tables. It declares `{PackageSource}` and names no implementation, so
 * what answers its two questions is decided by whoever runs it — here `eliot.build.resolve.TablePackages`,
 * bound by the one `with` in `against` and reading them out of a `Universe`, and in the launcher the
 * git-backed default. That the same code runs on both, unchanged and unaware, is the whole point of
 * the source being an effect.
 */
private def resolved(rootText: String, universe: List[Pair[String, String]]): String =
   resolvedWithAnchors(rootText, universe, empty)

private def resolvedWithAnchors(
   rootText: String,
   universe: List[Pair[String, String]],
   lineages: List[Pair[String, String]]
): String =
   reported(
      against(
         universeOf(universe, lineages),
         renderedSelections(resolve(PackageName("root"), descriptorOf(rootText)))
      )
   )

private def resolvedFor(name: String, rootText: String, universe: List[Pair[String, String]]): String =
   reported(
      against(
         universeOf(universe, empty),
         renderedSelections(resolve(PackageName(name), descriptorOf(rootText)))
      )
   )

/**
 * The packages of `url` the root package of `rootText` reached, in the order it reached them — the
 * half of a selection that decides what a build mounts and whose edges the closure follows.
 */
private def mounted(url: String, rootText: String, universe: List[Pair[String, String]]): String =
   reported(
      against(
         universeOf(universe, empty),
         renderedPackages(Repository(url), resolve(PackageName("root"), descriptorOf(rootText)))
      )
   )

private def renderedPackages(repository: Repository, resolution: Resolution): String =
   foldOption(
      "<unselected>",
      selection -> selection.selectedPackages.map(name -> "//" ++ show(name)).joined(", "),
      resolution.selections.find(selection -> selection.selectedRepository == repository)
   )

/**
 * The answer on one line, or the error instead — both outcomes asserted the same way.
 *
 * Every case renders *inside* the `against`, so the only `provide[Universe, _]` this suite and
 * `AssemblyTests` between them instantiate is the one answering a `String`. Not by preference: as of
 * compiler `ea3e27ed` two `provide` instantiations whose JVM descriptors agree get one
 * `withCellInternal` native between them, and the other fails at run time with `NoSuchMethodError`
 * (`docs/effectful-modules.md` §11.3). Two suites resolving into two different result types is exactly
 * that case. Undo once the compiler emits both.
 */
private def reported(outcome: Either[ResolutionError, String]): String =
   foldEither(error -> show(error), rendered -> rendered, outcome)

private def renderedSelections(resolution: Resolution): String = resolution.selections.joined(", ")

private def publishing(key: String, text: String): List[Pair[String, String]] = published(key, text, empty)

private def published(key: String, text: String, entries: List[Pair[String, String]]): List[Pair[String, String]] =
   append(entries, Pair(key, text))

private def anchoring(key: String, commit: String): List[Pair[String, String]] = anchored(key, commit, empty)

private def anchored(key: String, commit: String, entries: List[Pair[String, String]]): List[Pair[String, String]] =
   append(entries, Pair(key, commit))
