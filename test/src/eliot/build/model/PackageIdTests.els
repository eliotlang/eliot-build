import eliot.collection.List
import eliot.test.Assertion
import eliot.test.Test
import eliot.build.model.PackageId

def testCases: Test = {
   "packageId" should "leave a package already written canonically alone" in {
      canonical("github.com/x/foo//core") shouldBe "github.com/x/foo//core"
   }
   "packageId" should "keep a package selector apart from the repository it narrows" in {
      canonical("github.com/eliot-lang/eliot//stdlib") shouldBe "github.com/eliot-lang/eliot//stdlib"
   }
   "packageId" should "read a sibling package, which carries no URL" in {
      canonical("//stdlib") shouldBe "//stdlib"
   }
   "packageId" should "identify nothing for a bare repository, which is a set of packages rather than one" in {
      canonical("github.com/x/foo") shouldBe "<no package>"
   }
   "packageId" should "identify nothing for a selector naming no package" in {
      canonical("github.com/x/foo//") shouldBe "<no package>"
   }
   "packageId" should "give no name a meaning of its own, 'root' included" in {
      canonical("github.com/x/foo//root") shouldBe "github.com/x/foo//root"
   }
   "packageId" should "lowercase the host, which is case-insensitive by specification" in {
      canonical("GitHub.COM/x/foo//core") shouldBe "github.com/x/foo//core"
   }
   "packageId" should "keep the path's case, which no remote promises to ignore" in {
      canonical("github.com/Acme/Foo//core") shouldBe "github.com/Acme/Foo//core"
   }
   "packageId" should "strip a '.git' suffix" in {
      canonical("github.com/x/foo.git//core") shouldBe "github.com/x/foo//core"
   }
   "packageId" should "strip a scheme, which is a transport rather than an identity" in {
      canonical("https://github.com/x/foo//core") shouldBe "github.com/x/foo//core"
   }
   "packageId" should "canonicalize the repository a selector narrows" in {
      canonical("SSH://GitHub.com/x/foo.git//jvm") shouldBe "github.com/x/foo//jvm"
   }
   "PackageId" should "call every spelling of one package the same package" in {
      same("https://GitHub.com/x/foo.git//core", "github.com/x/foo//core") shouldBe "same"
   }
   "PackageId" should "tell two packages of one repository apart" in {
      same("github.com/eliot-lang/eliot//stdlib", "github.com/eliot-lang/eliot//jvm") shouldBe "different"
   }
   "PackageId" should "tell two repositories of one host apart" in {
      same("github.com/x/foo//core", "github.com/x/bar//core") shouldBe "different"
   }
   "PackageId" should "order packages stably, so anything keyed by package has one line order" in {
      sortedIds shouldBe "github.com/a/two//root github.com/b/one//core github.com/b/one//jvm"
   }
   "repositoryOf" should "drop the package selector, since a tag versions the whole repository" in {
      canonicalRepository("github.com/eliot-lang/eliot//stdlib") shouldBe "github.com/eliot-lang/eliot"
   }
   "repositoryOf" should "answer nothing for a sibling, which is a package of whatever is being read" in {
      canonicalRepository("//stdlib") shouldBe "<sibling>"
   }
   "repositoryAt" should "canonicalize a repository URL the way a dependency line is" in {
      show(repositoryAt("https://GitHub.com/x/foo.git/")) shouldBe "github.com/x/foo"
   }
   "repositoryAt" should "strip a trailing slash" in {
      show(repositoryAt("github.com/x/foo/")) shouldBe "github.com/x/foo"
   }
   "repositoryAt" should "strip a slash written behind the '.git'" in {
      show(repositoryAt("github.com/x/foo.git/")) shouldBe "github.com/x/foo"
   }
   "PackageId" should "read a package of the repository being read as a sibling" in {
      kindOfReference("//stdlib") shouldBe "sibling"
   }
   "PackageId" should "read a selector into a foreign repository as foreign" in {
      kindOfReference("github.com/eliot-lang/eliot//stdlib") shouldBe "foreign"
   }
}

/**
 * The canonical form of the package `text` identifies — the spelling everything downstream compares,
 * writes and fetches with — or `<no package>` where it identifies none.
 */
private def canonical(text: String): String = show(packageId(text)) else "<no package>"

private def canonicalRepository(text: String): String =
   foldOption("<sibling>", found -> show(found), repositoryOf(idOf(text)))

private def same(a: String, b: String): String = fold(idOf(a) == idOf(b), "same", "different")

private def kindOfReference(text: String): String = idOf(text) match {
   case Sibling(_) -> "sibling"
   case Foreign(_) -> "foreign"
}

/**
 * Three packages given out of order and sorted back, rendered on one line: the property a lockfile
 * needs, which is that the order depends on the packages and not on how they arrived.
 */
private def sortedIds: String = {
   val given = append(
      append(append(empty, idOf("github.com/b/one//jvm")), idOf("github.com/a/two//root")),
      idOf("github.com/b/one//core")
   )

   given.sorted.joined(" ")
}

/**
 * The package `text` identifies, for the cases that are about something other than whether it
 * identifies one — which every text they pass does.
 */
private def idOf(text: String): PackageId = packageId(text) else Sibling(PackageName("<no package>"))
