import eliot.collection.List
import eliot.test.Assertion
import eliot.test.Test
import eliot.build.model.PackageId
import eliot.build.git.Git

/**
 * The vocabulary the operations are said in: how a repository is reached.
 *
 * One case, and that is the point of the module it exercises — everything `eliot.build.git.Git`
 * still decides *outside* the effect is the scheme a descriptor deliberately omits. What a listing
 * says is read by `eliot.build.git.Tags` and asserted in `TagsTests`; what a subprocess does is
 * `ShellGitTests`.
 *
 * The bare `Test` keeps this pure: a case may assert and nothing else.
 */
def testCases: Test = {
   "remoteOf" should "supply the scheme a descriptor deliberately does not carry" in {
      remoteOf(Repository("github.com/x/foo")).remoteUrl shouldBe "https://github.com/x/foo"
   }
}
