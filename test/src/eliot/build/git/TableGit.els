import eliot.collection.List
import eliot.file.Path
import eliot.file.File
import eliot.build.model.Version
import eliot.build.model.Lineage
import eliot.test.Mock
import eliot.build.git.Git
import eliot.build.git.Tags

/**
 * A git that is a table: what a test of anything *using* git binds in place of the one that spawns.
 *
 * It is a **named implementation**, so it is never searched and never overlaps `shellGit` — a test of
 * cache policy writes `provide(mirrors, publishedTags(root, id) with tableGit)` and gets tags and file
 * contents instead of a scripted `ls-remote` listing. What it answers arrives as `{Dep[Mirrors]}`,
 * declared by the clauses that read it and supplied by that `provide`, the way `eliot.build.resolve.TablePackages`
 * takes its universe.
 *
 * **Bind it with an expression `with`, inside the mocked body, and not on a slot's type.** A clause row is
 * bound in the scope of the `with` that binds the name: written inside `mocked { … }`, this double's
 * `Mocking` reaches the framework's journal and file system; written on a slot's type — `computation: {Git}
 * A with tableGit`, the shape `against` uses — the scope that would cover it is the caller's, which the slot
 * cannot see. `against` gets away with it because `Dep` is discharged by a frame rather than bound by a scope.
 *
 * Two things make it at home inside `mocked`. It **records every operation with `recordCall`** into the one
 * journal every verification reads — so `calls` shows a cache's `isDirectory` and its `cloneMirror` in the
 * order they happened, one line apiece, each reading like the framework's own. And a clone — or a checkout —
 * **leaves its directory behind** by arranging it with `withDirectory`, which is what lets a test observe
 * "clone on the first visit, not on the second" rather than seed it.
 */

/**
 * What every repository answers: the tags a listing announces — a mirror's and a checkout's `origin`'s
 * alike — the files `fileAt` can read keyed `<version>:<path>`, the checkout a release is asked about,
 * and the refusal — if any — every operation that can refuse raises.
 */
data Mirrors(
   announcedTags: List[TagRef],
   heldFiles: List[Pair[String, String]],
   working: Working,
   refusal: Option[GitError]
)

/**
 * The project's own checkout, as a release asks about it: what is not committed, the commit checked out,
 * the commit its upstream was last seen at, and which commits descend from which — each pair an ancestor
 * and a descendant, a commit always counting as its own.
 */
data Working(
   pendingEntries: List[String],
   checkedOutCommit: Commit,
   pushedCommit: Commit,
   ancestry: List[Pair[Commit, Commit]]
)

implement tableGit: Git {
   def cloneMirror(remote: Remote, target: Path): {Dep[Mirrors], Mocking, Throw[GitError]} Mirror = {
      recordCall("cloneMirror", append(singleton(remote.remoteUrl), show(target)))
      withDirectory(target)

      unlessRefused(Mirror(target))
   }

   def fetch(mirror: Mirror): {Dep[Mirrors], Mocking, Throw[GitError]} Unit = {
      recordCall("fetch", singleton(show(mirror.mirrorDirectory)))

      unlessRefused(unit)
   }

   def tags(mirror: Mirror): {Dep[Mirrors], Mocking, Throw[GitError]} List[TagRef] = {
      recordCall("tags", singleton(show(mirror.mirrorDirectory)))

      unlessRefused(dependency.announcedTags)
   }

   def fileAt(version: Version, path: String, mirror: Mirror): {Dep[Mirrors], Mocking} Option[String] = {
      recordCall("fileAt", append(singleton(show(version) ++ ":" ++ path), show(mirror.mirrorDirectory)))

      dependency.heldFiles.lookupOption(show(version) ++ ":" ++ path)
   }

   def addWorktree(commit: Commit, target: Path, mirror: Mirror): {Dep[Mirrors], Mocking, Throw[GitError]} Worktree = {
      recordCall("addWorktree", append(append(singleton(show(commit)), show(target)), show(mirror.mirrorDirectory)))
      withDirectory(target)

      unlessRefused(Worktree(target))
   }

   def uncommittedChanges(checkout: Checkout): {Dep[Mirrors], Mocking, Throw[GitError]} List[String] = {
      recordCall("uncommittedChanges", singleton(show(checkout.checkoutDirectory)))

      unlessRefused(dependency.working.pendingEntries)
   }

   def headCommit(checkout: Checkout): {Dep[Mirrors], Mocking, Throw[GitError]} Commit = {
      recordCall("headCommit", singleton(show(checkout.checkoutDirectory)))

      unlessRefused(dependency.working.checkedOutCommit)
   }

   def upstreamCommit(checkout: Checkout): {Dep[Mirrors], Mocking, Throw[GitError]} Commit = {
      recordCall("upstreamCommit", singleton(show(checkout.checkoutDirectory)))

      unlessRefused(dependency.working.pushedCommit)
   }

   def isAncestor(ancestor: Commit, descendant: Commit, checkout: Checkout): {Dep[Mirrors], Mocking, Throw[GitError]} Bool = {
      recordCall(
         "isAncestor",
         append(append(singleton(show(ancestor)), show(descendant)), show(checkout.checkoutDirectory))
      )

      unlessRefused(
         ancestor == descendant ||
            dependency.working.ancestry.any(pair -> pair.first == ancestor && pair.second == descendant)
      )
   }

   def publishedReleases(checkout: Checkout): {Dep[Mirrors], Mocking, Throw[GitError]} List[TagRef] = {
      recordCall("publishedReleases", singleton(show(checkout.checkoutDirectory)))

      unlessRefused(dependency.announcedTags)
   }

   def tagRelease(version: Version, commit: Commit, checkout: Checkout): {Dep[Mirrors], Mocking, Throw[GitError]} Unit = {
      recordCall(
         "tagRelease",
         append(append(singleton(show(version)), show(commit)), show(checkout.checkoutDirectory))
      )

      unlessRefused(unit)
   }

   def pushRelease(version: Version, checkout: Checkout): {Dep[Mirrors], Mocking, Throw[GitError]} Unit = {
      recordCall("pushRelease", append(singleton(show(version)), show(checkout.checkoutDirectory)))

      unlessRefused(unit)
   }
}

/**
 * Repositories publishing what `listing` says — spelled as `git ls-remote --tags` would print it, and read
 * by the same function the shell implementation reads with — and holding `files`, keyed `<revision>:<path>`.
 */
def mirrorsOf(listing: String, files: List[Pair[String, String]]): Mirrors =
   Mirrors(parseTagRefs(listing), files, cleanCheckout, None)

/**
 * Repositories that say no: every operation that can refuse raises `error`.
 */
def refusingWith(error: GitError): Mirrors = Mirrors(empty, empty, cleanCheckout, Some(error))

/**
 * A checkout whose `origin` announces what `listing` says, and which is as `working` describes.
 */
def checkoutOf(listing: String, working: Working): Mirrors = Mirrors(parseTagRefs(listing), empty, working, None)

/**
 * A checkout with nothing uncommitted, at `head`, pushed, and descending from nothing but itself.
 */
def cleanCheckout: Working = Working(empty, Commit("head"), Commit("head"), empty)

/**
 * `answer`, unless the table says every operation is refused — the one decision the three raising
 * clauses share.
 */
private def unlessRefused[A](answer: A): {Dep[Mirrors], Throw[GitError]} A = {
   dependency.refusal.foreachOption(error -> raise(error))

   answer
}
