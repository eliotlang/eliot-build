import eliot.collection.List
import eliot.file.Path
import eliot.test.Assertion
import eliot.test.Test
import eliot.test.Mock
import eliot.build.model.PackageId
import eliot.build.model.Version
import eliot.build.model.Lineage
import eliot.build.git.Git
import eliot.build.git.Tags
import eliot.build.git.Cache
import eliot.build.git.TableGit

/**
 * Cache policy, run against a table instead of against git — where a mirror goes, when one has to be
 * made, and which directory each operation is told to stand in.
 *
 * Nothing here reaches a real process, a real file, or the implementation that spawns: `mocked` binds the
 * framework's doubles for the filesystem, and `with tableGit` binds `eliot.build.git.TableGit` for `{Git}`, so
 * a body that tried to reach the world would not compile. What git *runs* is `eliot.build.git.Git`'s own business
 * and `GitTests`' subject; this suite sees operations, not command lines.
 */
def testCases: Test = {
   "cacheDirectory" should "give one directory per canonical URL segment" in {
      show(cacheDirectory(cacheRoot, cached)) shouldBe "target/cache/github.com/x/foo"
   }
   "publishedTags" should "clone a mirror this build has never seen, then list what it publishes" in mocked {
      provide(listed, publishedTags(cacheRoot, cached) with tableGit)

      calls shouldBe expectedFirstVisit
   }
   "publishedTags" should "not clone again what its own clone left on disk" in mocked {
      provide(listed, {
         publishedTags(cacheRoot, cached)
         publishedTags(cacheRoot, cached)
      } with tableGit)

      wasCalledOnce("cloneMirror")
      wasCalledTimes(2, "log tags")
   }
   "publishedTags" should "not clone a mirror that was already on disk" in mocked {
      withDirectory(mirrorPath)

      provide(listed, publishedTags(cacheRoot, cached) with tableGit)

      wasNeverCalled("cloneMirror")
      calls shouldBe (expectedPresenceCheck ++ "; " ++ expectedListing)
   }
   "publishedTags" should "read the versions the mirror announces" in mocked {
      renderedTags(provide(listed, publishedTags(cacheRoot, cached) with tableGit)) shouldBe "v1.2 aaa1, v1.3 bbb2"
   }
   "publishedTags" should "raise what git said when git said no" in mocked {
      raising[GitError](expectedRefusal, provide(refusingWith(refused), {
         publishedTags(cacheRoot, cached)
         unit
      } with tableGit))
   }
   "anchorOf" should "answer the commit the line's first release names" in mocked {
      provide(anchoredAt, renderedCommit(anchorOf(cacheRoot, Line(1), cached)) with tableGit) shouldBe "aaa1"
   }
   "anchorOf" should "answer nothing for a line the mirror does not publish" in mocked {
      provide(anchoredAt, renderedCommit(anchorOf(cacheRoot, Line(3), cached)) with tableGit) shouldBe "<none>"
   }
   "refreshed" should "fetch the mirror it found" in mocked {
      withDirectory(mirrorPath)

      provide(listed, refreshed(cacheRoot, cached) with tableGit)

      calls shouldBe (expectedPresenceCheck ++ "; " ++ expectedFetch)
   }
   "refreshed" should "clone first when the build has never seen the package" in mocked {
      provide(listed, refreshed(cacheRoot, cached) with tableGit)

      wereCalledInOrder(append(singleton("cloneMirror"), "fetch "))
   }
   "descriptorTextAt" should "read a descriptor out of the object database" in mocked {
      withDirectory(mirrorPath)

      provide(listed, renderedText(descriptorTextAt(cacheRoot, Version(Line(1), Some(2)), cached)) with tableGit)
         shouldBe "dep github.com/x/bar//root v1.1"
   }
   "descriptorTextAt" should "answer absent, not raise, where the version publishes no descriptor" in mocked {
      withDirectory(mirrorPath)

      provide(listed, renderedText(descriptorTextAt(cacheRoot, Version(Line(1), Some(9)), cached)) with tableGit)
         shouldBe "<none>"
   }
   "descriptorTextAt" should "fetch and ask again where the mirror has never heard of that version" in mocked {
      withDirectory(mirrorPath)

      provide(listed, renderedText(descriptorTextAt(cacheRoot, Version(Line(1), Some(9)), cached)) with tableGit)

      wasCalledOnce("fetch")
      wasCalledTimes(2, "fileAt v1.9:eliot.pkg")
   }
   "descriptorTextAt" should "fetch nothing for a version the mirror already holds" in mocked {
      withDirectory(mirrorPath)

      provide(listed, renderedText(descriptorTextAt(cacheRoot, Version(Line(1), Some(2)), cached)) with tableGit)

      wasNeverCalled("fetch")
   }
   "sourceDirectory" should "put a tree beside the mirror, named by the version it holds" in {
      show(sourceDirectory(cacheRoot, Version(Line(1), Some(2)), cached)) shouldBe "target/cache/github.com/x/foo@v1.2"
   }
   "sourceTreeAt" should "clone the mirror it has never seen, then check the version out of it" in mocked {
      provide(listed, sourceTreeAt(cacheRoot, Version(Line(1), Some(2)), cached) with tableGit)

      calls shouldBe expectedFirstCheckout
   }
   "sourceTreeAt" should "answer where the tree is" in mocked {
      show(provide(listed, sourceTreeAt(cacheRoot, Version(Line(1), Some(2)), cached) with tableGit))
         shouldBe "target/cache/github.com/x/foo@v1.2"
   }
   "sourceTreeAt" should "not check out again what its own checkout left on disk" in mocked {
      provide(listed, {
         sourceTreeAt(cacheRoot, Version(Line(1), Some(2)), cached)
         sourceTreeAt(cacheRoot, Version(Line(1), Some(2)), cached)
      } with tableGit)

      wasCalledOnce("addWorktree")
   }
   "sourceTreeAt" should "check out each selected version into a tree of its own" in mocked {
      provide(listed, {
         sourceTreeAt(cacheRoot, Version(Line(1), Some(2)), cached)
         sourceTreeAt(cacheRoot, Version(Line(1), Some(3)), cached)
      } with tableGit)

      wasCalledTimes(2, "addWorktree")
      wasCalledOnce("cloneMirror")
   }
   "the cache" should "clone once and read the mirror it made for every later question" in mocked {
      provide(listed, {
         publishedTags(cacheRoot, cached)
         descriptorTextAt(cacheRoot, Version(Line(1), Some(2)), cached)
      } with tableGit)

      wasCalledOnce("cloneMirror")
      lastCall shouldBe expectedShow
   }
}

/**
 * The repositories every cache scenario runs against: they announce a listing, and hold a descriptor at
 * `v1.2`. A clone leaves the mirror on disk — the table git arranges that itself — which is what makes
 * "clone on the first visit, not on the second" something these tests *observe* rather than seed. Getting
 * the clone target wrong would show up here as a second clone.
 */
private def listed: Mirrors = mirrorsOf(listing, singleton(Pair("v1.2:eliot.pkg", "dep github.com/x/bar//root v1.1")))

private def anchoredAt: Mirrors = mirrorsOf(anchored, empty)

/**
 * The first visit: look, make the root, clone, list. Which directory each git command stands in is
 * `shellGit`'s decision now and `GitTests`' subject; what this line pins is that the cache asks for the
 * clone at the directory it will later look for.
 */
private def expectedFirstVisit: String =
   expectedPresenceCheck ++ "; createDirectories target/cache; " ++
      "log cloneMirror https://github.com/x/foo target/cache/github.com/x/foo; " ++
      expectedListing

/**
 * Every question the cache asks starts by looking whether the mirror is there — recorded like any other call,
 * which the hand-written fixture this replaced quietly dropped.
 */
private def expectedPresenceCheck: String = "isDirectory target/cache/github.com/x/foo"

private def expectedListing: String = "log tags target/cache/github.com/x/foo"

/**
 * The first checkout: look for the tree, look for the mirror, make the root, clone, check out. The
 * mirror's own presence check is in the middle because a tree is checked out *of* a mirror, and the
 * first verb to want a tree may well be the first to want the package at all.
 */
private def expectedFirstCheckout: String =
   "isDirectory target/cache/github.com/x/foo@v1.2; " ++ expectedPresenceCheck ++
      "; createDirectories target/cache; " ++
      "log cloneMirror https://github.com/x/foo target/cache/github.com/x/foo; " ++
      "log addWorktree v1.2 target/cache/github.com/x/foo@v1.2 target/cache/github.com/x/foo"

private def expectedFetch: String = "log fetch target/cache/github.com/x/foo"

private def expectedShow: String = "log fileAt v1.2:eliot.pkg target/cache/github.com/x/foo"

private def refused: GitError = GitError("git ls-remote --tags target/cache/github.com/x/foo", 128, "no such repository")

private def expectedRefusal: String =
   "'git ls-remote --tags target/cache/github.com/x/foo' failed with exit code 128: no such repository"

private def cacheRoot: Path = path("target/cache")

private def cached: Repository = Repository("github.com/x/foo")

private def mirrorPath: Path = path("target/cache/github.com/x/foo")

private def listing: String = "aaa1\trefs/tags/v1.2\nbbb2\trefs/tags/v1.3\n"

private def anchored: String = "aaa1\trefs/tags/v1.0\nbbb2\trefs/tags/v1.4"

/**
 * The tags of an answer, rendered `<tag> <commit>` apiece — both halves, so a test says which commit a version
 * resolved to rather than merely that it appeared.
 */
private def renderedTags(refs: List[TagRef]): String =
   refs.map(ref -> show(ref.taggedVersion) ++ " " ++ show(ref.taggedCommit)).joined(", ")

/**
 * Rendered *inside* the `provide` wherever an answer is an `Option`, and not by preference: as of compiler
 * `ea3e27ed` two `provide[Mirrors, Option[_]]` instantiations at different element types get one
 * `withCellInternal` native between them — their JVM descriptors are identical — and the other fails at
 * run time with `NoSuchMethodError`. A `String` result sidesteps it. Undo once the compiler emits both.
 */
private def renderedCommit(commit: Option[Commit]): String = foldOption("<none>", found -> show(found), commit)

private def renderedText(text: Option[String]): String = foldOption("<none>", found -> found, text)
