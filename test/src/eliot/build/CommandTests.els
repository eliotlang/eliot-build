import eliot.collection.List
import eliot.file.Path
import eliot.test.Assertion
import eliot.test.Test
import eliot.build.model.PackageId
import eliot.build.model.Version
import eliot.build.model.Lineage
import eliot.build.Command

/**
 * The half of the tool that is about text rather than about running: what a command line asks for,
 * and how the compiler it runs is spelled.
 *
 * These cases declare nothing and arrange nothing — there is no platform under any of them, which is
 * the reason the module exists apart from `eliot.build.Launcher`. What the launcher does instead is
 * checked by running it.
 */
def testCases: Test = {
   "requested" should "read the package the command line names" in {
      described(requested(commandLine("controller-jvm"))) shouldBe "controller-jvm"
   }
   "requested" should "read the suite by the word that spells it, which is a package name like any other" in {
      described(requested(commandLine("test"))) shouldBe "test"
   }
   "requested" should "read a package whose name was once a verb as that package" in {
      described(requested(commandLine("build"))) shouldBe "build"
   }
   "requested" should "ask for nothing where the old verb spelling puts a word before the package" in {
      described(requested(append(commandLine("build"), "test"))) shouldBe "<none>"
   }
   "requested" should "ask for nothing rather than read an option as a package" in {
      described(requested(commandLine("--offline"))) shouldBe "<none>"
   }
   "requested" should "ask for nothing where the package name is empty" in {
      described(requested(commandLine(""))) shouldBe "<none>"
   }
   "requested" should "ask for nothing on an empty command line" in {
      described(requested(empty)) shouldBe "<none>"
   }
   "requested" should "read the package before the separator" in {
      described(requested(words("test -- eliot.build.resolve"))) shouldBe "test"
   }
   "requested" should "read the package before a separator with nothing after it" in {
      described(requested(words("test --"))) shouldBe "test"
   }
   "requested" should "ask for nothing where a word other than the separator follows the package" in {
      described(requested(words("test eliot.build.resolve --"))) shouldBe "<none>"
   }
   "requested" should "ask for nothing where the separator comes first" in {
      described(requested(words("-- test"))) shouldBe "<none>"
   }

   "forwarded" should "answer the words after the separator, in order" in {
      joined(" ", forwarded(words("test -- eliot.build.resolve eliot.build.git"))) shouldBe
         "eliot.build.resolve eliot.build.git"
   }
   "forwarded" should "pass a second separator and words like options on verbatim" in {
      joined(" ", forwarded(words("test -- --format=plain -- -o x"))) shouldBe "--format=plain -- -o x"
   }
   "forwarded" should "answer nothing where the command line has no separator" in {
      isEmpty(forwarded(commandLine("test"))).shouldBeTrue
   }
   "forwarded" should "answer nothing where nothing follows the separator" in {
      isEmpty(forwarded(words("test --"))).shouldBeTrue
   }
   "forwarded" should "answer nothing where the separator does not follow a package name" in {
      isEmpty(forwarded(words("-- test"))).shouldBeTrue
   }

   "modelRequested" should "read the project-model option" in {
      modelRequested(commandLine("--project-model")).shouldBeTrue
   }
   "modelRequested" should "not read a package name as the option" in {
      modelRequested(commandLine("test")).shouldBeFalse
   }
   "modelRequested" should "not read the option with a package after it" in {
      modelRequested(append(commandLine("--project-model"), "test")).shouldBeFalse
   }
   "modelRequested" should "not read the option with forwarded words after it" in {
      modelRequested(words("--project-model -- test")).shouldBeFalse
   }
   "modelRequested" should "not read an empty command line as the option" in {
      modelRequested(empty).shouldBeFalse
   }
   "requested" should "not read the project-model option as a package" in {
      described(requested(commandLine("--project-model"))) shouldBe "<none>"
   }

   "releaseRequested" should "read a release of the next version from the option alone" in {
      releaseDescribed(releaseRequested(commandLine("--release"))) shouldBe "next"
   }
   "releaseRequested" should "read a release of the version named after the option" in {
      releaseDescribed(releaseRequested(append(commandLine("--release"), "v1.0"))) shouldBe "v1.0"
   }
   "releaseRequested" should "ask for nothing where the word after the option is not a version" in {
      releaseDescribed(releaseRequested(append(commandLine("--release"), "test"))) shouldBe "<none>"
   }
   "releaseRequested" should "ask for nothing where more than a version follows the option" in {
      releaseDescribed(releaseRequested(append(append(commandLine("--release"), "v1.0"), "v1.1")))
         shouldBe "<none>"
   }
   "releaseRequested" should "not read a package name as a release" in {
      releaseDescribed(releaseRequested(commandLine("test"))) shouldBe "<none>"
   }
   "releaseRequested" should "ask for nothing on an empty command line" in {
      releaseDescribed(releaseRequested(empty)) shouldBe "<none>"
   }
   "requested" should "not read the release option as a package" in {
      described(requested(commandLine("--release"))) shouldBe "<none>"
   }

   "releaseReport" should "name the version a consumer would require and the commit their lock will record" in {
      joined("/", releaseReport(Version(Line(0), Some(6)), Commit("ccc3"))) shouldBe "eliot: released v0.6 at ccc3"
   }

   "compilerCommand" should "put the line's words between the entry point and the first source root" in {
      joined(" ", compilerCommand(compilationOf("run -m eliot.test.Runner"))) shouldBe expectedCompilerCommand
   }
   "compilerCommand" should "pass the line's words through untouched, whatever they say" in {
      joined(" ", compilerCommand(compilationOf("jvm exe-jar --statistics -m App")))
         .contains("compiler.Main jvm exe-jar --statistics -m App /project/src").shouldBeTrue
   }
   "compilerCommand" should "put forwarded words last, behind a separator of its own" in {
      joined(" ", compilerCommand(forwarding("eliot.build.resolve", compilationOf("run -m eliot.test.Runner"))))
         shouldBe (expectedCompilerCommand ++ " -- eliot.build.resolve")
   }
   "compilerCommand" should "add no separator where nothing is forwarded" in {
      joined(" ", compilerCommand(compilationOf("run -m eliot.test.Runner"))).endsWith("-o /project/target")
         .shouldBeTrue
   }
   "compilerCommand" should "run the java it was given rather than one it decided" in {
      joined(" ", compilerCommand(compilationOf("apidoc"))).startsWith("/opt/jdk/bin/java -cp")
         .shouldBeTrue
   }

   "classpathOf" should "name each unpacked asset by a wildcard the jvm expands itself" in {
      classpathOf(append(singleton(path("/cache/assets/a")), path("/cache/assets/b")))
         shouldBe "/cache/assets/a/*:/cache/assets/b/*"
   }
   "classpathOf" should "answer nothing for a toolchain of no assets at all" in {
      classpathOf(empty) shouldBe ""
   }

   "failed" should "attribute the failure to what could not be done" in {
      joined("/", failed("git refused", "no such repository")) shouldBe "eliot: git refused: no such repository"
   }

   "usage" should "name the one argument, what naming it does, and every package the descriptor declares" in {
      joined("/", usage(Some(declaredNames))) shouldBe (expectedUsage ++ expectedListing)
   }
   "usage" should "list nothing where the descriptor could not be read" in {
      joined("/", usage(None)) shouldBe expectedUsage
   }
   "usage" should "say so where the descriptor declares no packages at all" in {
      joined("/", usage(Some(empty))) shouldBe (expectedUsage ++ "/eliot.pkg declares no packages")
   }

   "unknownPackage" should "name the package that is not declared, then list the ones that are" in {
      joined("/", unknownPackage(PackageName("nosuch"), declaredNames)) shouldBe expectedRefusal
   }
}

private def expectedUsage: String =
   "usage: eliot <package> [-- <argument>...]/" ++
      "   runs every compiler line in the package's closure over the package's sources/" ++
      "   and passes the arguments after -- to the program a line runs/" ++
      "usage: eliot --project-model/" ++
      "   prints what every package resolves to, as JSON, from what is already fetched/" ++
      "usage: eliot --release [<version>]/" ++
      "   tags the pushed commit checked out as the next release, or as <version>, and pushes the tag"

private def expectedListing: String = "/packages in eliot.pkg:/   root/   launcher/   test"

private def expectedRefusal: String =
   "eliot: no package named 'nosuch': not declared in eliot.pkg/" ++ expectedUsage ++ expectedListing

private def declaredNames: List[PackageName] =
   append(append(singleton(PackageName("root")), PackageName("launcher")), PackageName("test"))

/**
 * The order is the compiler's own argument parser's: the line's mode and its `-m` before the first
 * positional root, because the mode opens a subcommand scope that the first root closes.
 */
private def expectedCompilerCommand: String =
   "/opt/jdk/bin/java -cp /cache/assets/eliot-compiler.zip/* " ++
      "com.vanillasource.eliot.eliotc.compiler.Main run -m eliot.test.Runner " ++
      "/project/src /project/test --progress -o /project/target"

/**
 * A compilation running the `compiler` line `line` — its words split at single spaces, the way the
 * descriptor's reader hands them over.
 */
private def compilationOf(line: String): Compilation =
   Compilation(
      "/opt/jdk/bin/java",
      singleton(path("/cache/assets/eliot-compiler.zip")),
      split(" ", line),
      append(singleton(path("/project/src")), path("/project/test")),
      path("/project/target"),
      empty
   )

/**
 * `compilation` with `line`'s words forwarded to the program it runs.
 */
private def forwarding(line: String, compilation: Compilation): Compilation =
   Compilation(
      compilation.javaCommand,
      compilation.toolchainClasspath,
      compilation.compilerArguments,
      compilation.compiledRoots,
      compilation.outputDirectory,
      split(" ", line)
   )

private def described(name: Option[PackageName]): String = name.mapOption(show) orElse "<none>"

/**
 * A release request as one word: the version it names, `next` where it names none, `<none>` where the
 * command line asked for no release.
 */
private def releaseDescribed(request: Option[ReleaseRequest]): String =
   request.mapOption(asked -> asked.requestedVersion.mapOption(show) orElse "next") orElse "<none>"

private def commandLine(argument: String): List[String] = singleton(argument)
