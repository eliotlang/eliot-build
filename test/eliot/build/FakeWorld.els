import eliot.carrier.Effect
import eliot.collection.List
import eliot.file.Path
import eliot.file.File
import eliot.system.Process
import eliot.build.Git

/**
 * The world an effectful module is run against under test: which directories exist, what each command
 * it spawns answers, and a journal of everything it did.
 *
 * Not a suite — the fixture every suite over `{Process, FileSystem}` code shares. Production code
 * declaring an effect row names no carrier, so it commits to no interpretation of it; instantiating it
 * at `Fake` is what makes the interpretation this file's, and nothing in `src/` knows a test exists.
 *
 * **The carrier implements the whole row, flat.** All five instances — `Effect`, `Process`,
 * `FileSystem` and one `Throw` per failure channel — are its own. Discharging the `Throw`s with the
 * real `runThrow` over `Fake` as a base is not an alternative: `Process[ThrowCarrier[E, Fake]]` would
 * need a lift of this `Process` through `ThrowCarrier`, the real effects get theirs for free by riding
 * `Suspend`, and writing one here would be an orphan instance. So a raise lands in this carrier's own
 * result slot, rendered, and `answerOf` reads it back.
 *
 * **What it deliberately does not implement is `Throw[AssertionError]`**, which is what a body
 * asserting *between* its own steps would need. Not a design choice: `AssertionError` lives in
 * `eliot.test.Assertion` and `IoError` in `eliot.file.File`, and both modules export a `message`, so a
 * file faking `FileSystem` cannot import the assertions too ("Imported names shadow other imported
 * names"). It costs nothing here — the journal accumulates, so asserting it after a two-step script
 * says everything asserting it between the steps would have.
 *
 * **It cannot cheat.** `Fake` has no `Suspend` instance and `Suspend` is the only route to a native
 * side effect, so no line of production code run on it can reach a real process or a real file — an
 * accidental one is a compile error rather than a test that quietly does I/O.
 *
 * **A faked case costs no helper definitions.** Both slots that take a computation here are declared
 * with the **capture tag** `{| Fake}` — the pinned row at zero entries, the same type as `Fake[A]` but
 * declaring that the slot hosts a computation on that carrier — so a run, or a whole script of them,
 * is written inline inside an ordinary `pure` body rather than in a `def` with no ambient carrier of
 * its own. Which of the two words a test wants is the shape of what it asserts: `journalOf` answers
 * what a run *did*, `answerOf` what it *yielded* or raised.
 */

/**
 * What a spawned command answers: the three things a `ProcessResult` carries.
 */
data Reply(replyExitCode: Int, replyOutput: String, replyError: String)

/**
 * A reply, and the command it is the reply to — matched by containment, so a test says `"ls-remote"`
 * rather than spelling a whole command line it is not asserting about.
 */
data Canned(whenCommandContains: String, cannedReply: Reply)

data World(existingDirectories: List[String], journal: List[String], replies: List[Canned])

/**
 * A world in, a value or a raised error out, and the world after. A raise lands in the result slot
 * already rendered by the error's own `Show`, which is what a user would have been shown, so a test
 * asserting a failure asserts the report.
 */
data Fake[A](runFake: Function[World, Pair[Either[String, A], World]])

implement Effect[Fake] {
   def pure[A](a: A): Fake[A] = Fake(w -> Pair(Right(a), w))

   def flatMap[A, B](f: Function[A, Fake[B]], fa: Fake[A]): Fake[B] =
      Fake(w -> foldPair(
         outcome -> after -> foldEither(err -> Pair(Left(err), after), a -> runFake(f(a))(after), outcome),
         runFake(fa)(w)
      ))

   def map[A, B](f: Function[A, B], fa: Fake[A]): Fake[B] =
      Fake(w -> foldPair(
         outcome -> after -> Pair(foldEither(err -> Left(err), a -> Right(f(a)), outcome), after),
         runFake(fa)(w)
      ))
}

/**
 * Spawning: nothing runs, the command and the directory it would have run in are journalled, and the
 * canned reply is what it "wrote". Recording the working directory is the point — it is the half of a
 * git invocation a command line does not carry, and the half that has actually been wrong.
 *
 * A successful `git clone --mirror` also **makes its target directory exist**, because that is what
 * the real one does and it is the only thing the cache's presence test looks at. So "clone on the
 * first visit, not on the second" is something a test observes within one run rather than seeds, and a
 * clone landing anywhere other than where `cacheDirectory` looks is a failing test rather than a
 * second clone nobody notices.
 */
implement Process[Fake] {
   def run(command: List[String], workingDirectory: Path): Fake[ProcessResult] =
      Fake(w -> spawned(command, workingDirectory, w))

   def runInheritingIo(command: List[String], workingDirectory: Path): Fake[Int] =
      Fake(w -> foldPair(
         outcome -> after -> Pair(foldEither(err -> Left(err), result -> Right(result.exitCode), outcome), after),
         spawned(command, workingDirectory, w)
      ))
}

/**
 * The filesystem: directories a test seeded or a command created exist, creating one makes it exist
 * and says so, and every read nobody has needed yet answers empty. The unused ones are here because an
 * ability is all-or-nothing, not because they mean anything.
 */
implement FileSystem[Fake] {
   def readFile(path: Path): Fake[String] = constantly("")
   def writeFile(content: String, path: Path): Fake[Unit] = noting("write " ++ show(path))
   def appendFile(content: String, path: Path): Fake[Unit] = noting("append " ++ show(path))
   def foldLines[B](initial: B, step: B => String => B, path: Path): Fake[B] = constantly(initial)
   def foldCodePoints[B](initial: B, step: B => Int => B, path: Path): Fake[B] = constantly(initial)
   def readLines(path: Path): Fake[List[String]] = constantly(empty)
   def exists(path: Path): Fake[Bool] = present(path)
   def isDirectory(path: Path): Fake[Bool] = present(path)
   def listDirectory(path: Path): Fake[List[Path]] = constantly(empty)
   def walk(path: Path): Fake[List[Path]] = constantly(empty)
   def createDirectories(path: Path): Fake[Unit] = Fake(w -> Pair(Right(unit), created(show(path), w)))
   def delete(path: Path): Fake[Unit] = noting("delete " ++ show(path))
}

implement Throw[GitError, Fake] {
   def raise[A](err: GitError): Fake[A] = failed(show(err))
}

implement Throw[IoError, Fake] {
   def raise[A](err: IoError): Fake[A] = failed(show(err))
}

/**
 * A world where nothing exists, nothing has happened, and every command succeeds saying nothing.
 */
def emptyWorld: World = World(empty, empty, empty)

/**
 * `world` with a directory that already exists — a mirror this build has seen before.
 */
def withDirectory(directory: String, world: World): World =
   World(append(world.existingDirectories, directory), world.journal, world.replies)

/**
 * `world` in which any command line containing `commandFragment` answers `output` and exits zero.
 */
def answering(commandFragment: String, output: String, world: World): World =
   World(
      world.existingDirectories,
      world.journal,
      append(world.replies, Canned(commandFragment, Reply(0, output, "")))
   )

/**
 * `world` in which any command line containing `commandFragment` fails, saying `diagnostics`.
 */
def failing(commandFragment: String, exitCode: Int, diagnostics: String, world: World): World =
   World(
      world.existingDirectories,
      world.journal,
      append(world.replies, Canned(commandFragment, Reply(exitCode, "", diagnostics)))
   )

/**
 * Everything `computation` did against `world`, one entry per act, in order — a spawn as
 * `<directory>$ <command line>`, a directory creation as `mkdir <path>`.
 *
 * `computation` may be a whole script written inline, since the slot is a capture: two operations in
 * one block share a world, so what the first one left behind is what the second one finds.
 */
def journalOf[A](world: World, computation: {| Fake} A): String =
   second(runFake(computation)(world)).journal.joined("; ")

/**
 * What `computation` answered against `world`, rendered by `rendering` — or the error it raised,
 * rendered by that error's own `Show`. One helper for both outcomes, so a test asserts a failure the
 * same way it asserts a success.
 */
def answerOf[A](world: World, rendering: A => String, computation: {| Fake} A): String =
   foldEither(err -> "raised: " ++ err, a -> rendering(a), first(runFake(computation)(world)))

/**
 * The tags of an answer, rendered `<tag> <commit>` apiece — both halves, so a test says which commit a
 * version resolved to rather than merely that it appeared.
 */
def renderedTags(tags: List[TagRef]): String =
   tags.map(ref -> show(ref.taggedVersion) ++ " " ++ ref.taggedCommit).joined(", ")

/**
 * An optional answer, rendered — absence being an outcome several operations deliberately have.
 */
def renderedText(text: Option[String]): String = foldOption("<none>", found -> found, text)

private def failed[A](rendered: String): Fake[A] = Fake(w -> Pair(Left(rendered), w))

private def spawned(
   command: List[String],
   workingDirectory: Path,
   world: World
): Pair[Either[String, ProcessResult], World] = {
   val result = replied(command, world)
   val spawnedIn = noted(spawnNote(command, workingDirectory), world)

   Pair(Right(result), afterCloning(command, result, spawnedIn))
}

/**
 * What a command left behind besides its output: a successful mirror clone makes its target exist, and
 * nothing else does. Learned rather than journalled — the journal already carries the clone, and this
 * is the directory git itself made.
 */
private def afterCloning(command: List[String], result: ProcessResult, world: World): World =
   fold(
      contains(cloneFragment, command.joined(" ")) && result.exitCode == 0,
      foldOption(world, target -> withDirectory(target, world), command.last),
      world
   )

private def cloneFragment: String = "clone --mirror"

private def spawnNote(command: List[String], workingDirectory: Path): String =
   show(workingDirectory) ++ "$ " ++ command.joined(" ")

private def replied(command: List[String], world: World): ProcessResult =
   foldOption(
      ProcessResult(0, "", ""),
      canned -> ProcessResult(
         canned.cannedReply.replyExitCode,
         canned.cannedReply.replyOutput,
         canned.cannedReply.replyError
      ),
      world.replies.find(canned -> contains(canned.whenCommandContains, command.joined(" ")))
   )

private def noted(note: String, world: World): World =
   World(world.existingDirectories, append(world.journal, note), world.replies)

private def created(directory: String, world: World): World =
   World(
      append(world.existingDirectories, directory),
      append(world.journal, "mkdir " ++ directory),
      world.replies
   )

private def noting(note: String): Fake[Unit] = Fake(w -> Pair(Right(unit), noted(note, w)))

private def present(path: Path): Fake[Bool] =
   Fake(w -> Pair(Right(w.existingDirectories.any(directory -> directory == show(path))), w))

private def constantly[A](value: A): Fake[A] = Fake(w -> Pair(Right(value), w))
