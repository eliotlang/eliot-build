import eliot.collection.List
import eliot.file.Path
import eliot.file.File
import eliot.system.Process
import eliot.test.Assertion
import eliot.test.Test
import eliot.test.Mock
import eliot.build.PackageId
import eliot.build.Version
import eliot.build.Git

/**
 * Talking to git, with git faked: what each operation runs and where, what it reads back out of what
 * git said, and which refusals it raises rather than answers.
 *
 * The reading half is pure, and the bare `Test` this suite declares is what keeps it so: a case may
 * assert and nothing else, so `in { … }` is already the strictest body there is. The spawning half is
 * `shellGit`, bound by a `with` written inside `mocked`'s body so that its clauses' `{Process}` resolves
 * to the framework's process double — which records the command *and the directory it ran in*, the half
 * of a git invocation a command line does not carry, the half `shellGit` now decides from the subject's
 * type, and the half that has actually been wrong.
 */
def testCases: Test = {
   "parseTagRefs" should "read a lightweight tag, which is listed once" in {
      parsed("aaa1\trefs/tags/v1.2") shouldBe "v1.2 aaa1"
   }
   "parseTagRefs" should "answer an annotated tag with the commit it was peeled to" in {
      parsed("bbb1\trefs/tags/v1.2\nccc2\trefs/tags/v1.2^{}") shouldBe "v1.2 ccc2"
   }
   "parseTagRefs" should "keep the peeled commit whichever order the listing arrived in" in {
      parsed("ccc2\trefs/tags/v1.2^{}\nbbb1\trefs/tags/v1.2") shouldBe "v1.2 ccc2"
   }
   "parseTagRefs" should "read every version a repository publishes" in {
      parsed("aaa1\trefs/tags/v1.2\nbbb2\trefs/tags/v1.3\nccc3\trefs/tags/v2.0")
         shouldBe "v1.2 aaa1, v1.3 bbb2, v2.0 ccc3"
   }
   "parseTagRefs" should "keep a bare major tag, which names the start of its line" in {
      parsed("aaa1\trefs/tags/v1") shouldBe "v1 aaa1"
   }
   "parseTagRefs" should "drop a tag that names no version, which resolution could not select" in {
      parsed("aaa1\trefs/tags/latest\nbbb2\trefs/tags/v1.2\nccc3\trefs/tags/v1.0-rc1") shouldBe "v1.2 bbb2"
   }
   "parseTagRefs" should "drop a branch, since the resolver selects tags and never heads" in {
      parsed("aaa1\trefs/heads/v1\nbbb2\trefs/tags/v1.2") shouldBe "v1.2 bbb2"
   }
   "parseTagRefs" should "survive the trailing empty line every listing ends with" in {
      parsed("aaa1\trefs/tags/v1.2\n") shouldBe "v1.2 aaa1"
   }
   "parseTagRefs" should "yield nothing for a repository publishing no tags at all" in {
      parsed("") shouldBe ""
   }
   "commitOf" should "find the commit a version names" in {
      commit("v1.3", "aaa1\trefs/tags/v1.2\nbbb2\trefs/tags/v1.3") shouldBe "bbb2"
   }
   "commitOf" should "answer a v1.0 requirement with the repository's bare v1 tag" in {
      commit("v1.0", "aaa1\trefs/tags/v1") shouldBe "aaa1"
   }
   "commitOf" should "find nothing for a version the repository does not publish" in {
      commit("v1.9", "aaa1\trefs/tags/v1.2") shouldBe "<none>"
   }
   "anchorCommit" should "answer the first release of the line asked about" in {
      anchor(1, "aaa1\trefs/tags/v1.0\nbbb2\trefs/tags/v1.4\nccc3\trefs/tags/v2.0") shouldBe "aaa1"
   }
   "anchorCommit" should "accept a bare v1 as the first release of the v1 line" in {
      anchor(1, "aaa1\trefs/tags/v1\nbbb2\trefs/tags/v1.4") shouldBe "aaa1"
   }
   "anchorCommit" should "find no anchor for a line whose history starts later" in {
      anchor(1, "aaa1\trefs/tags/v1.3\nbbb2\trefs/tags/v1.4") shouldBe "<none>"
   }
   "anchorCommit" should "find no anchor for a line the repository does not publish" in {
      anchor(3, "aaa1\trefs/tags/v1.0") shouldBe "<none>"
   }
   "TagRef" should "order by version, so the newest release sorts last" in {
      newestOf("aaa1\trefs/tags/v1.10\nbbb2\trefs/tags/v1.9\nccc3\trefs/tags/v1.2") shouldBe "v1.10 aaa1"
   }
   "remoteTags" should "ask a remote what it publishes, without fetching it" in mocked {
      remoteTags(remoteOf(repositoryAt("github.com/x/foo"))) with shellGit

      calls shouldBe ".$ git ls-remote --tags https://github.com/x/foo"
   }
   "remoteTags" should "read the versions the remote announced" in mocked {
      whenSpawning("ls-remote", succeeding(listing))

      renderedTags(remoteTags(remoteOf(repositoryAt("github.com/x/foo"))) with shellGit) shouldBe "v1.2 aaa1, v1.3 bbb2"
   }
   "remoteTags" should "raise exactly what git ran and exactly what it said back" in mocked {
      whenSpawning("ls-remote", failing(128, "no such repository"))

      raising[GitError](expectedRefusal, {
         remoteTags(remoteOf(repositoryAt("github.com/x/foo"))) with shellGit
         unit
      })
   }
   "cloneMirror" should "clone without a working tree, standing where this program stands" in mocked {
      cloneMirror(remoteOf(repositoryAt("github.com/x/foo")), mirrorPath) with shellGit

      calls shouldBe ".$ git clone --mirror https://github.com/x/foo /cache/github.com/x/foo"
   }
   "cloneMirror" should "answer the mirror it made, at the directory it was asked for" in mocked {
      val made = cloneMirror(remoteOf(repositoryAt("github.com/x/foo")), mirrorPath) with shellGit

      show(made.mirrorDirectory) shouldBe "/cache/github.com/x/foo"
   }
   "fetch" should "prune, so a withdrawn tag stops being selectable" in mocked {
      fetch(mirror) with shellGit

      calls shouldBe "/cache/github.com/x/foo$ git fetch --tags --prune"
   }
   "fetch" should "run inside the mirror, naming nothing" in mocked {
      whenSpawning("fetch", failing(128, "not a repository"))

      raising[GitError]("'git fetch --tags --prune' failed with exit code 128: not a repository", fetch(mirror) with shellGit)
   }
   "tags" should "list the mirror by naming its directory, from where this program stands" in mocked {
      tags(mirror) with shellGit

      calls shouldBe ".$ git ls-remote --tags /cache/github.com/x/foo"
   }
   "tags" should "read the versions the mirror holds" in mocked {
      whenSpawning("ls-remote", succeeding(listing))

      renderedTags(tags(mirror) with shellGit) shouldBe "v1.2 aaa1, v1.3 bbb2"
   }
   "fileAt" should "read one file out of the object database, inside the mirror" in mocked {
      fileAt(AtVersion(version("v1.2")), "eliot.pkg", mirror) with shellGit

      calls shouldBe "/cache/github.com/x/foo$ git show v1.2:eliot.pkg"
   }
   "fileAt" should "read at a commit by its hash" in mocked {
      fileAt(AtCommit(Commit("aaa1")), "eliot.pkg", mirror) with shellGit

      calls shouldBe "/cache/github.com/x/foo$ git show aaa1:eliot.pkg"
   }
   "fileAt" should "answer what that revision holds" in mocked {
      whenSpawning("show v1.2:eliot.pkg", succeeding("dep github.com/x/bar v1.1"))

      val shown = fileAt(AtVersion(version("v1.2")), "eliot.pkg", mirror) with shellGit

      (shown orElse "<none>") shouldBe "dep github.com/x/bar v1.1"
   }
   "fileAt" should "answer absent, not raise, where the revision holds no such file" in mocked {
      whenSpawning("show v1.9:eliot.pkg", failing(128, "path does not exist"))

      val shown = fileAt(AtVersion(version("v1.9")), "eliot.pkg", mirror) with shellGit

      (shown orElse "<none>") shouldBe "<none>"
   }
   "git" should "name a repository from this program's frame and stand in the one it fetches into" in mocked {
      cloneMirror(remoteOf(repositoryAt("github.com/x/foo")), mirrorPath) with shellGit
      fetch(mirror) with shellGit

      calls shouldBe (
         ".$ git clone --mirror https://github.com/x/foo /cache/github.com/x/foo; " ++
            "/cache/github.com/x/foo$ git fetch --tags --prune")
   }
   "remoteOf" should "supply the scheme a descriptor deliberately does not carry" in {
      remoteOf(repositoryAt("github.com/x/foo")).remoteUrl shouldBe "https://github.com/x/foo"
   }
   "revisionName" should "spell a version as the tag it was published as" in {
      revisionName(AtVersion(version("v1.2"))) shouldBe "v1.2"
   }
   "revisionName" should "spell a commit as its hash" in {
      revisionName(AtCommit(Commit("aaa1"))) shouldBe "aaa1"
   }
}

private def mirrorPath: Path = path("/cache/github.com/x/foo")

private def mirror: Mirror = Mirror(mirrorPath)

private def listing: String = "aaa1\trefs/tags/v1.2\nbbb2\trefs/tags/v1.3\n"

private def expectedRefusal: String =
   "'git ls-remote --tags https://github.com/x/foo' failed with exit code 128: no such repository"

/**
 * The tags `output` announces, rendered as `<tag> <commit>` per version — both halves asserted at
 * once, so a test says which commit a version resolved to rather than merely that it appeared.
 */
private def parsed(output: String): String = renderedTags(parseTagRefs(output))

private def renderedTags(refs: List[TagRef]): String =
   refs.map(ref -> show(ref.taggedVersion) ++ " " ++ show(ref.taggedCommit)).joined(", ")

private def renderedText(text: Option[String]): String = foldOption("<none>", found -> found, text)

private def renderedCommit(commit: Option[Commit]): String = foldOption("<none>", found -> show(found), commit)

private def newestOf(output: String): String =
   foldOption("<none>", newest -> renderedTags(singleton(newest)), parseTagRefs(output).sorted.last)

private def commit(tag: String, output: String): String =
   renderedCommit(commitOf(version(tag), parseTagRefs(output)))

private def anchor(majorLine: Int, output: String): String =
   renderedCommit(anchorCommit(Line(majorLine), parseTagRefs(output)))

private def version(tag: String): Version = parseVersion(tag) else Version(Line(0), None)
