import eliot.collection.List
import eliot.file.Path
import eliot.file.File
import eliot.test.Mock
import eliot.build.Git

/**
 * A git that is a table: what a test of anything *using* git binds in place of the one that spawns.
 *
 * It is a **named implementation**, so it is never searched and never overlaps `shellGit` — a test of
 * cache policy writes `provide(mirrors, publishedTags(root, id) with tableGit)` and gets tags and file
 * contents instead of a scripted `ls-remote` listing. What it answers arrives as `{Dep[Mirrors]}`,
 * declared by the clauses that read it and supplied by that `provide`, the way `eliot.build.TablePackages`
 * takes its universe.
 *
 * **Bind it with an expression `with`, inside the mocked body, and not on a slot's type.** A clause row is
 * bound in the scope of the `with` that binds the name: written inside `mocked { … }`, this double's `Log`
 * and `Mocking` reach the framework's doubles; written on a slot's type — `computation: {Git} A with
 * tableGit`, the shape `against` uses — the scope that would cover them is the caller's, which the slot
 * cannot see, so they bind the platform's own, and the journal goes to standard output. `against` gets
 * away with it because `Dep` is discharged by a frame rather than bound by a scope.
 *
 * Two things make it at home inside `mocked`. It **reports every operation through `Log`**, which the
 * framework's own double records into the one journal every verification reads — so `calls` shows a
 * cache's `isDirectory` and its `mirrorClone` in the order they happened, one line apiece, prefixed with
 * `log`. And a clone **leaves the directory behind** by arranging it with `withDirectory`, which is what
 * lets a test observe "clone on the first visit, not on the second" rather than seed it.
 */

/**
 * What every repository answers: the tags a listing announces, the files `showFile` can read keyed
 * `<revision>:<file>`, and the refusal — if any — every operation that can refuse raises.
 */
data Mirrors(announcedTags: List[TagRef], heldFiles: List[Pair[String, String]], refusal: Option[GitError])

implement tableGit: Git {
   def lsRemoteTags(target: String, from: Path): {Dep[Mirrors], Log, Throw[GitError]} List[TagRef] = {
      log("lsRemoteTags " ++ target ++ " in " ++ show(from))

      unlessRefused(dependency.announcedTags)
   }

   def mirrorClone(source: String, target: String, from: Path): {Dep[Mirrors], Log, Mocking, Throw[GitError]} Unit = {
      log("mirrorClone " ++ source ++ " " ++ target ++ " in " ++ show(from))
      withDirectory(path(target))

      unlessRefused(unit)
   }

   def fetchTags(mirror: Path): {Dep[Mirrors], Log, Throw[GitError]} Unit = {
      log("fetchTags in " ++ show(mirror))

      unlessRefused(unit)
   }

   def showFile(revision: String, file: String, mirror: Path): {Dep[Mirrors], Log} Option[String] = {
      log("showFile " ++ revision ++ ":" ++ file ++ " in " ++ show(mirror))

      dependency.heldFiles.lookupOption(revision ++ ":" ++ file)
   }
}

/**
 * Repositories publishing what `listing` says — spelled as `git ls-remote --tags` would print it, and read
 * by the same function the shell implementation reads with — and holding `files`, keyed `<revision>:<file>`.
 */
def mirrorsOf(listing: String, files: List[Pair[String, String]]): Mirrors =
   Mirrors(parseTagRefs(listing), files, None)

/**
 * Repositories that say no: every operation that can refuse raises `error`.
 */
def refusingWith(error: GitError): Mirrors = Mirrors(empty, empty, Some(error))

/**
 * `answer`, unless the table says every operation is refused — the one decision the three raising
 * clauses share.
 */
private def unlessRefused[A](answer: A): {Dep[Mirrors], Throw[GitError]} A =
   foldOption(answer, error -> raise(error), dependency.refusal)
