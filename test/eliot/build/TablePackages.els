import eliot.lang.Id
import eliot.carrier.Effect
import eliot.collection.List
import eliot.build.PackageId
import eliot.build.Version
import eliot.build.Descriptor
import eliot.build.PackageSource
import eliot.build.Resolution

/**
 * A package source that is a table of strings: the carrier a resolver test runs on.
 *
 * It implements `PackageSource`, the failure channel resolution raises on, and nothing else —
 * deliberately. The production source is a catch-all over any carrier that can spawn and touch files,
 * so a carrier that *also* faked `Process` and `FileSystem` would match it too and the query would be
 * ambiguous ("Multiple ability implementations found"). One fake per seam, each implementing the
 * minimum, is what keeps the answer unique — and a resolver test wants descriptors, not a fake git.
 *
 * `Throw[ResolutionError]` is implemented here rather than discharged with `runThrow`:
 * `PackageSource[ThrowCarrier[E, Packages]]` would need a lift this ability has no way to earn, so the
 * carrier is flat and `against` reads the outcome out as the `Either` the assertions already expect.
 *
 * **Why this is not `eliot.test.Mock`.** The framework's carrier doubles every *base* effect, and this
 * project's own ability is not one of them — an instance may live only with its ability or with a type
 * argument, so `implement PackageSource[Mock]` could go in `PackageSource`'s module (production code
 * importing the test framework) or in the framework (which has never heard of it), and neither is right.
 * A carrier of one's own is the answer, and it is also required here: the production instance is a
 * constrained catch-all that the framework's wide `Mock` would satisfy, and two candidates is
 * "Multiple ability implementations found".
 */

/**
 * What a universe of packages publishes: descriptor text per `<url>@<tag>`, and anchor commits per
 * `<url>@v<major>`.
 */
data Universe(publications: List[Pair[String, String]], lineages: List[Pair[String, String]])

data Packages[A](runPackages: Function[Universe, Either[ResolutionError, A]])

implement Effect[Packages] {
   def pure[A](a: A): Packages[A] = Packages(_ -> Right(a))

   def flatMap[A, B](f: Function[A, Packages[B]], fa: Packages[A]): Packages[B] =
      Packages(universe -> foldEither(error -> Left(error), a -> runPackages(f(a))(universe), runPackages(fa)(universe)))

   def map[A, B](f: Function[A, B], fa: Packages[A]): Packages[B] =
      Packages(universe -> foldEither(error -> Left(error), a -> Right(f(a)), runPackages(fa)(universe)))
}

implement Throw[ResolutionError, Packages] {
   def raise[A](err: ResolutionError): Packages[A] = Packages(_ -> Left(err))
}

implement PackageSource[Packages] {
   def descriptorAt(version: Version, target: PackageId): Packages[Option[Descriptor]] =
      Packages(universe -> Right(publicationIn(universe, show(target) ++ "@" ++ show(version))))

   def anchorAt(majorLine: Int, target: PackageId): Packages[Option[String]] =
      Packages(universe -> Right(universe.lineages.lookupOption(show(target) ++ "@v" ++ show(majorLine))))
}

/**
 * The universe `publications` and `lineages` describe, each an association list the tests build.
 */
def universeOf(publications: List[Pair[String, String]], lineages: List[Pair[String, String]]): Universe =
   Universe(publications, lineages)

/**
 * What `computation` answers against `universe` — the selections, or the error resolution raised.
 */
def against[A](universe: Universe, computation: Packages[A]): Either[ResolutionError, A] =
   runPackages(computation)(universe)

/**
 * The descriptor `text` spells, taken as empty where it spells nothing readable. A malformed
 * descriptor is `eliot.build.Descriptor`'s subject, and nothing here is about it.
 */
def descriptorOf(text: String): Descriptor =
   foldEither(
      _ -> emptyDescriptor,
      descriptor -> descriptor,
      runId(runThrow[DescriptorError](parseDescriptor(split("\n", text))))
   )

private def publicationIn(universe: Universe, key: String): Option[Descriptor] =
   foldOption(None, text -> Some(descriptorOf(text)), universe.publications.lookupOption(key))
