import eliot.collection.List
import eliot.test.Assertion
import eliot.test.Test
import eliot.build.model.PackageId
import eliot.build.model.Version
import eliot.build.model.Descriptor
import eliot.build.format.PackageFile
import eliot.build.format.DescriptorWriter

def testCases: Test = {
   "parseDescriptor" should "read the minimal library descriptor of the design" in {
      roundTrip("dep github.com/eliot-lang/eliot//stdlib v1\ndep github.com/somelib/collections v1.3")
   }
   "parseDescriptor" should "keep a module selector apart from the URL it narrows" in {
      parsed("dep github.com/eliot-lang/eliot//stdlib v1.2")
         shouldBe "dep github.com/eliot-lang/eliot//stdlib v1.2"
   }
   "parseDescriptor" should "read a sibling module reference, which carries no version" in {
      parsed("module jvm {\n   dep //stdlib\n}") shouldBe "module jvm {\n  dep //stdlib\n}"
   }
   "parseDescriptor" should "read an application targeting two platforms" in {
      roundTrip(
         "dep github.com/somelib/sensor-api v2\n" ++
         "artifact controller-jvm {\n" ++
         "  dep github.com/eliot-lang/eliot//jvm v1\n" ++
         "  backend {\n    kind exe-jar\n    main Controller\n  }\n" ++
         "}"
      )
   }
   "parseDescriptor" should "read a backend written inline" in {
      parsed("artifact hello {\n   backend { kind exe-jar, main HelloWorld }\n}")
         shouldBe "artifact hello {\n  backend {\n    kind exe-jar\n    main HelloWorld\n  }\n}"
   }
   "parseDescriptor" should "read the eliot repository's own multi-module shape" in {
      roundTrip(
         "module lang {\n" ++
         "  plugin com.vanillasource:eliot-lang:0.5.0 {\n" ++
         "    jar org.ow2.asm:asm:9.9 sha256 9f2ca9b1\n  }\n}\n" ++
         "module examples {\n  internal\n  dep //jvm\n}"
      )
   }
   "parseDescriptor" should "read a backend naming the package whose plugin to call" in {
      roundTrip("artifact hello {\n  backend github.com/eliot-lang/eliot//jvm {\n    kind exe-jar\n  }\n}")
   }
   "parseDescriptor" should "canonicalize a dependency URL, so one package is one identity" in {
      parsed("dep GitHub.com/x/foo.git v1") shouldBe "dep github.com/x/foo v1"
   }
   "parseDescriptor" should "read a test block" in {
      roundTrip("test {\n  dep github.com/eliot-lang/eliot-test v1\n}")
   }
   "parseDescriptor" should "treat a module as exported unless it says otherwise" in {
      parsed("module lang {\n   dep //other\n}") shouldBe "module lang {\n  dep //other\n}"
   }
   "parseDescriptor" should "give a module the directory its own name spells, where it says nothing" in {
      firstModuleDirectory("module stdlib {\n   dep //lang\n}") shouldBe "stdlib"
   }
   "parseDescriptor" should "let a module say where it is, for a repository that is not flat" in {
      firstModuleDirectory("module stdlib {\n   at stdlib/eliot\n}") shouldBe "stdlib/eliot"
   }
   "parseDescriptor" should "keep a module's directory apart from the name dependents select it by" in {
      roundTrip("module lang {\n  at lang/eliot\n  dep //stdlib\n}")
   }
   "parseDescriptor" should "write no 'at' where the directory is the module's name, which already said it" in {
      parsed("module lang {\n   at lang\n}") shouldBe "module lang"
   }
   "parseDescriptor" should "reject an 'at' naming no directory" in {
      parsed("module lang {\n   at\n}") shouldBe "an 'at' needs a directory in 'at'"
   }
   "parseDescriptor" should "reject an absolute module directory, which no checkout contains" in {
      parsed("module lang {\n   at /etc\n}")
         shouldBe "a module directory is a path inside the repository in 'at /etc'"
   }
   "parseDescriptor" should "reject a module directory climbing out of the repository" in {
      parsed("module lang {\n   at ../elsewhere\n}")
         shouldBe "a module directory is a path inside the repository in 'at ../elsewhere'"
   }
   "parseDescriptor" should "yield nothing for a file of comments alone" in {
      parsed("-- nothing to declare\n\n-- really") shouldBe ""
   }
   "parseDescriptor" should "reject an unknown top-level clause, pointing at the upgrade" in {
      parsed("registry https://example.com")
         shouldBe "unknown clause 'registry'; this descriptor may need a newer eliot in 'registry https://example.com'"
   }
   "parseDescriptor" should "reject an unknown clause inside a module" in {
      parsed("module lang {\n   exports everything\n}")
         shouldBe "unknown clause 'exports'; this descriptor may need a newer eliot in 'exports everything'"
   }
   "parseDescriptor" should "reject a dependency URL carrying a scheme" in {
      parsed("dep https://github.com/x/foo v1")
         shouldBe "a dependency URL carries no scheme in 'dep https://github.com/x/foo v1'"
   }
   "parseDescriptor" should "reject a version that is not a tag" in {
      parsed("dep github.com/x/foo 1.3") shouldBe "a version must be a tag like 'v1.3' in 'dep github.com/x/foo 1.3'"
   }
   "parseDescriptor" should "reject a version range, which the model has no way to mean" in {
      parsed("dep github.com/x/foo >=v1.3")
         shouldBe "a version must be a tag like 'v1.3' in 'dep github.com/x/foo >=v1.3'"
   }
   "parseDescriptor" should "reject a version carrying a third component" in {
      parsed("dep github.com/x/foo v1.2.3")
         shouldBe "a version must be a tag like 'v1.3' in 'dep github.com/x/foo v1.2.3'"
   }
   "parseDescriptor" should "reject a dep with no URL at all" in {
      parsed("dep") shouldBe "a dep needs a package URL in 'dep'"
   }
   "parseDescriptor" should "reject a foreign dependency that declares no minimum" in {
      parsed("dep github.com/x/foo") shouldBe "a foreign dependency needs a minimum version in 'dep github.com/x/foo'"
   }
   "parseDescriptor" should "reject a version on a sibling module, which versions with its repository" in {
      parsed("module jvm {\n   dep //stdlib v1.2\n}")
         shouldBe "a sibling module versions with its repository and carries no version in 'dep //stdlib v1.2'"
   }
   "parseDescriptor" should "reject a dep carrying more than a URL and a version" in {
      parsed("dep github.com/x/foo v1 extra") shouldBe "too many arguments in 'dep github.com/x/foo v1 extra'"
   }
   "parseDescriptor" should "reject a jar pin without its hash" in {
      parsed("module lang {\n  plugin a:b:1 {\n    jar c:d:2\n  }\n}")
         shouldBe "a jar needs 'sha256 <hex>' in 'jar c:d:2'"
   }
   "parseDescriptor" should "reject a replacement, which the resolver has no way to honour" in {
      parsed("replace github.com/x/foo with ../foo-local")
         shouldBe ("unknown clause 'replace'; this descriptor may need a newer eliot in " ++
            "'replace github.com/x/foo with ../foo-local'")
   }
   "parseDescriptor" should "report a syntax error as such" in {
      parsed("dep a v1\n}") shouldBe "line 2: unmatched '}' in '}'"
   }
}

/**
 * The descriptor `text` spells, rendered back into `eliot.pkg` syntax — or the error it fails with,
 * so both outcomes are asserted the same way.
 */
private def parsed(text: String): String =
   foldEither(
      error -> show(error),
      descriptor -> renderDescriptor(descriptor),
      runThrow[DescriptorError](parseDescriptor(split("\n", text)))
   )

/**
 * Where the first module of the descriptor `text` spells says it is — the one thing the rendering
 * cannot show, since a directory that is the module's name is written as the name alone.
 */
private def firstModuleDirectory(text: String): String =
   foldEither(
      error -> show(error),
      descriptor -> foldOption("", built -> built.moduleDirectory, descriptor.modules.head),
      runThrow[DescriptorError](parseDescriptor(split("\n", text)))
   )

/**
 * Assert that `text` survives being read into the model and written back out unchanged — the
 * strongest statement available without an `Eq` for the model: every clause was understood, and
 * nothing was invented.
 */
private def roundTrip(text: String): {Throw[AssertionError]} Unit = parsed(text) shouldBe text
