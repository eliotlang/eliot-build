import eliot.lang.Id
import eliot.collection.List
import eliot.test.Assertion
import eliot.test.Test
import eliot.build.Strings
import eliot.build.Lists

def testCases: Test = {
   "before" should "yield the characters ahead of the first separator" in {
      before("=", "key=value") shouldBe "key"
   }
   "before" should "yield the whole string when the separator does not occur" in {
      before("=", "keyvalue") shouldBe "keyvalue"
   }
   "after" should "yield the characters past the first separator only" in {
      after("=", "key=value=more") shouldBe "value=more"
   }
   "after" should "yield the empty string when the separator does not occur" in {
      after("=", "keyvalue") shouldBe ""
   }
   "split" should "cut a string at every separator" in {
      joined("|", split(" ", "dep github.com/x/foo v1.3")) shouldBe "dep|github.com/x/foo|v1.3"
   }
   "split" should "keep empty pieces between adjacent separators" in {
      joined("|", split(" ", "a  b")) shouldBe "a||b"
   }
   "split" should "yield the whole string when the separator does not occur" in {
      joined("|", split(" ", "single")) shouldBe "single"
   }
   "split" should "split on a multi-character separator" in {
      joined("|", split("//", "github.com/eliot-lang/eliot//stdlib")) shouldBe "github.com/eliot-lang/eliot|stdlib"
   }
   "words" should "drop the empty pieces a run of spaces produces" in {
      joined("|", words("  dep   github.com/x/foo    v1.3 ")) shouldBe "dep|github.com/x/foo|v1.3"
   }
   "words" should "treat a tab as a separator" in {
      joined("|", words("dep\tgithub.com/x/foo")) shouldBe "dep|github.com/x/foo"
   }
   "words" should "yield nothing for a blank line" in {
      joined("|", words("   ")) shouldBe ""
   }
   "parseNatural" should "read a multi-digit number" in {
      show(parseNatural("1024") else 0) shouldBe "1024"
   }
   "parseNatural" should "read zero" in {
      show(parseNatural("0") else 0) shouldBe "0"
   }
   "parseNatural" should "abort on a non-digit" in {
      show(parseNatural("1a") else 0) shouldBe "0"
   }
   "parseNatural" should "abort on the empty string" in {
      show(parseNatural("") else 0) shouldBe "0"
   }
   "isNatural" should "accept digits and reject anything else" in {
      (rendered(isNatural("12")) ++ " " ++ rendered(isNatural("v1"))) shouldBe "true false"
   }
}

/**
 * `Bool` has no `Show` instance in the standard library, so tests render one themselves.
 */
private def rendered(flag: Bool): String = fold(flag, "true", "false")
