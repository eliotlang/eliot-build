import eliot.collection.List
import eliot.file.Path
import eliot.test.Assertion
import eliot.test.Test
import eliot.build.model.PackageId
import eliot.build.model.Version
import eliot.build.model.Descriptor
import eliot.build.resolve.Configuration
import eliot.build.resolve.Resolution
import eliot.build.resolve.TablePackages
import eliot.build.assemble.Assembly

/**
 * What a resolution mounts: which directories one configuration compiles from, and which it leaves
 * out.
 *
 * Run against `eliot.build.resolve.TablePackages`, whose trees are at `/trees/<url>@<tag>` and exist
 * only as answers — the subject here is the layout read off a descriptor, not how a version got onto
 * disk, which is `eliot.build.git.Cache`'s and `GitTests`' business.
 */
def testCases: Test = {
   "sourceRoots" should "mount the project's own sources, and its tests for the test scope" in {
      assembled("", publishing("unused", "")) shouldBe "/project/src, /project/test"
   }
   "sourceRoots" should "leave the project's tests out of an artifact" in {
      assembledFor("app", "artifact app {\n}", publishing("unused", "")) shouldBe "/project/src"
   }
   "sourceRoots" should "mount every module the project declares, at the directory it declares" in {
      assembled(
         "module lang {\n  at lang/eliot\n}\nmodule stdlib {\n  at stdlib/eliot\n}",
         publishing("unused", "")
      ) shouldBe expectedProjectModules
   }
   "sourceRoots" should "mount a dependency that declares no modules at its repository root" in {
      assembled(
         "test {\n  dep github.com/x/foo v1.2\n}",
         publishing("github.com/x/foo@v1.2", "")
      ) shouldBe "/project/src, /project/test, /trees/github.com/x/foo@v1.2/src"
   }
   "sourceRoots" should "mount a dependency's selected module at the directory that module declares" in {
      assembled(
         "dep github.com/e/eliot//jvm v1.2",
         publishing("github.com/e/eliot@v1.2", "module jvm {\n  at jvm/eliot\n}")
      ) shouldBe "/project/src, /project/test, /trees/github.com/e/eliot@v1.2/jvm/eliot/src"
   }
   "sourceRoots" should "leave a module nobody selected out of the mount" in {
      assembled(
         "dep github.com/e/eliot//stdlib v1.2",
         publishing("github.com/e/eliot@v1.2", "module stdlib {\n}\nmodule jvm {\n}")
      ) shouldBe "/project/src, /project/test, /trees/github.com/e/eliot@v1.2/stdlib/src"
   }
   "sourceRoots" should "mount the sibling a selected module carries, which is how a layer brings its base" in {
      assembled(
         "dep github.com/e/eliot//jvm v1.2",
         publishing("github.com/e/eliot@v1.2", "module stdlib {\n}\nmodule jvm {\n  dep //stdlib\n}")
      ) shouldBe expectedSiblingMount
   }
   "sourceRoots" should "never mount a dependency's test track, whatever the configuration" in {
      assembled(
         "test {\n  dep github.com/x/foo v1.2\n}",
         publishing("github.com/x/foo@v1.2", "test {\n  dep github.com/x/tester v1.0\n}")
      ) shouldBe "/project/src, /project/test, /trees/github.com/x/foo@v1.2/src"
   }
   "sourceRoots" should "mount every selected package, in the resolution's own order" in {
      assembled(
         "dep github.com/x/foo v1.2",
         publishing("github.com/x/foo@v1.2", "dep github.com/x/bar v1.1").published("github.com/x/bar@v1.1", "")
      ) shouldBe "/project/src, /project/test, /trees/github.com/x/bar@v1.1/src, /trees/github.com/x/foo@v1.2/src"
   }
   "sourceRoots" should "report a selected version whose sources cannot be read back" in {
      assembled("dep github.com/x/foo v1.2", publishing("github.com/x/foo@v1.1", ""))
         shouldBe "github.com/x/foo publishes no v1.2"
   }
}

private def expectedProjectModules: String =
   "/project/lang/eliot/src, /project/lang/eliot/test, " ++
      "/project/stdlib/eliot/src, /project/stdlib/eliot/test"

/**
 * The sibling arrives as a module of the same repository, so both trees are one tree, and the order
 * is the descriptor's declaration order rather than the order the closure reached them in.
 */
private def expectedSiblingMount: String =
   "/project/src, /project/test, /trees/github.com/e/eliot@v1.2/stdlib/src, " ++
      "/trees/github.com/e/eliot@v1.2/jvm/src"

/**
 * The roots of `rootText`'s test scope, resolved against `universe` — one line, so a case says both
 * what is mounted and in what order.
 */
private def assembled(rootText: String, universe: List[Pair[String, String]]): String =
   rendered(
      against(universeOf(universe, empty), renderedRoots(sourceRoots(TestScope, projectOf(rootText))))
   )

private def assembledFor(
   configurationName: String,
   rootText: String,
   universe: List[Pair[String, String]]
): String =
   rendered(
      against(
         universeOf(universe, empty),
         renderedRoots(sourceRoots(ArtifactNamed(configurationName), projectOf(rootText)))
      )
   )

/**
 * The package being built always stands at `/project`, so a root of the project and a root of a
 * dependency are told apart by reading a line rather than by counting.
 */
private def projectOf(rootText: String): Project = Project(path("/project"), descriptorOf(rootText))

/**
 * Rendered *inside* the `against`, as every case of `ResolutionTests` is and for the reason recorded
 * there: two `provide[Universe, _]` instantiations whose JVM descriptors agree get one native between
 * them, so both suites answer a `String` and there is one instantiation to emit.
 */
private def rendered(outcome: Either[ResolutionError, String]): String =
   foldEither(error -> show(error), roots -> roots, outcome)

private def renderedRoots(roots: List[Path]): String = roots.joined(", ")

private def publishing(key: String, text: String): List[Pair[String, String]] = published(key, text, empty)

private def published(key: String, text: String, entries: List[Pair[String, String]]): List[Pair[String, String]] =
   append(entries, Pair(key, text))
