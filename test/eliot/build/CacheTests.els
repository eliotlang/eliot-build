import eliot.collection.List
import eliot.file.Path
import eliot.test.Assertion
import eliot.test.Test
import eliot.test.Mock
import eliot.build.PackageId
import eliot.build.Version
import eliot.build.Git
import eliot.build.Cache
import eliot.build.TableGit

/**
 * Cache policy, run against a table instead of against git — where a mirror goes, when one has to be
 * made, and which directory each operation is told to stand in.
 *
 * Nothing here reaches a real process, a real file, or the implementation that spawns: `mocked` binds the
 * framework's doubles for the filesystem, and `with tableGit` binds `eliot.build.TableGit` for `{Git}`, so
 * a body that tried to reach the world would not compile. What git *runs* is `eliot.build.Git`'s own business
 * and `GitTests`' subject; this suite sees operations, not command lines.
 */
def testCases: Test = {
   "cacheDirectory" should "give one directory per canonical URL segment" in {
      show(cacheDirectory(cacheRoot, packageId("github.com/x/foo"))) shouldBe "target/cache/github.com/x/foo"
   }
   "cacheDirectory" should "key the repository, since a module selector is not what git fetches" in {
      show(cacheDirectory(cacheRoot, packageId("github.com/e/eliot//stdlib")))
         shouldBe "target/cache/github.com/e/eliot"
   }
   "publishedTags" should "clone a mirror this build has never seen, then list what it publishes" in mocked {
      provide(listed, publishedTags(cacheRoot, cached) with tableGit)

      calls shouldBe expectedFirstVisit
   }
   "publishedTags" should "not clone again what its own clone left on disk" in mocked {
      provide(listed, {
         publishedTags(cacheRoot, cached)
         publishedTags(cacheRoot, cached)
      } with tableGit)

      wasCalledOnce("mirrorClone")
      wasCalledTimes(2, "lsRemoteTags")
   }
   "publishedTags" should "not clone a mirror that was already on disk" in mocked {
      withDirectory(mirrorDirectory)

      provide(listed, publishedTags(cacheRoot, cached) with tableGit)

      wasNeverCalled("mirrorClone")
      calls shouldBe (expectedPresenceCheck ++ "; " ++ expectedListing)
   }
   "publishedTags" should "read the versions the mirror announces" in mocked {
      renderedTags(provide(listed, publishedTags(cacheRoot, cached) with tableGit)) shouldBe "v1.2 aaa1, v1.3 bbb2"
   }
   "publishedTags" should "raise what git said when git said no" in mocked {
      raising[GitError](expectedRefusal, provide(refusingWith(refused), {
         publishedTags(cacheRoot, cached)
         unit
      } with tableGit))
   }
   "anchorOf" should "answer the commit the line's first release names" in mocked {
      val anchor = provide(anchoredAt, anchorOf(cacheRoot, 1, cached) with tableGit)

      (anchor orElse "<none>") shouldBe "aaa1"
   }
   "anchorOf" should "answer nothing for a line the mirror does not publish" in mocked {
      val anchor = provide(anchoredAt, anchorOf(cacheRoot, 3, cached) with tableGit)

      (anchor orElse "<none>") shouldBe "<none>"
   }
   "refreshed" should "fetch in the mirror, which is the repository that operation stands in" in mocked {
      withDirectory(mirrorDirectory)

      provide(listed, refreshed(cacheRoot, cached) with tableGit)

      calls shouldBe (expectedPresenceCheck ++ "; " ++ expectedFetch)
   }
   "refreshed" should "clone first when the build has never seen the package" in mocked {
      provide(listed, refreshed(cacheRoot, cached) with tableGit)

      wereCalledInOrder(append(singleton("mirrorClone"), "fetchTags"))
   }
   "descriptorTextAt" should "read a descriptor out of the object database" in mocked {
      withDirectory(mirrorDirectory)

      val text = provide(listed, descriptorTextAt(cacheRoot, Version(1, Some(2)), cached) with tableGit)

      (text orElse "<none>") shouldBe "dep github.com/x/bar v1.1"
   }
   "descriptorTextAt" should "answer absent, not raise, where the version publishes no descriptor" in mocked {
      withDirectory(mirrorDirectory)

      val text = provide(listed, descriptorTextAt(cacheRoot, Version(1, Some(9)), cached) with tableGit)

      (text orElse "<none>") shouldBe "<none>"
   }
   "the cache" should "clone once and read the mirror it made for every later question" in mocked {
      provide(listed, {
         publishedTags(cacheRoot, cached)
         descriptorTextAt(cacheRoot, Version(1, Some(2)), cached)
      } with tableGit)

      wasCalledOnce("mirrorClone")
      lastCall shouldBe expectedShow
   }
}

/**
 * The repositories every cache scenario runs against: they announce a listing, and hold a descriptor at
 * `v1.2`. A clone leaves the mirror on disk — the table git arranges that itself — which is what makes
 * "clone on the first visit, not on the second" something these tests *observe* rather than seed. Getting
 * the clone target wrong would show up here as a second clone.
 */
private def listed: Mirrors = mirrorsOf(listing, singleton(Pair("v1.2:eliot.pkg", "dep github.com/x/bar v1.1")))

private def anchoredAt: Mirrors = mirrorsOf(anchored, empty)

/**
 * A clone is told to stand in `.` and *names* its target, so a relative cache root is resolved in this
 * program's frame exactly once. Standing inside the root would resolve the same relative path a second time
 * and bury the mirror at `target/cache/target/cache/…` — the bug this line pins.
 */
private def expectedFirstVisit: String =
   expectedPresenceCheck ++ "; createDirectories target/cache; " ++
      "log mirrorClone https://github.com/x/foo target/cache/github.com/x/foo in .; " ++
      expectedListing

/**
 * Every question the cache asks starts by looking whether the mirror is there — recorded like any other call,
 * which the hand-written fixture this replaced quietly dropped.
 */
private def expectedPresenceCheck: String = "isDirectory target/cache/github.com/x/foo"

private def expectedListing: String = "log lsRemoteTags target/cache/github.com/x/foo in ."

private def expectedFetch: String = "log fetchTags in target/cache/github.com/x/foo"

private def expectedShow: String = "log showFile v1.2:eliot.pkg in target/cache/github.com/x/foo"

private def refused: GitError = GitError("git ls-remote --tags target/cache/github.com/x/foo", 128, "no such repository")

private def expectedRefusal: String =
   "'git ls-remote --tags target/cache/github.com/x/foo' failed with exit code 128: no such repository"

private def cacheRoot: Path = path("target/cache")

private def cached: PackageId = packageId("github.com/x/foo")

private def mirrorDirectory: Path = path("target/cache/github.com/x/foo")

private def listing: String = "aaa1\trefs/tags/v1.2\nbbb2\trefs/tags/v1.3\n"

private def anchored: String = "aaa1\trefs/tags/v1.0\nbbb2\trefs/tags/v1.4"

/**
 * The tags of an answer, rendered `<tag> <commit>` apiece — both halves, so a test says which commit a version
 * resolved to rather than merely that it appeared.
 */
private def renderedTags(tags: List[TagRef]): String =
   tags.map(ref -> show(ref.taggedVersion) ++ " " ++ ref.taggedCommit).joined(", ")
