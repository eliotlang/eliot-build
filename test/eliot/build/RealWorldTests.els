import eliot.collection.List
import eliot.file.Path
import eliot.jvm.IO
import eliot.test.Assertion
import eliot.test.Test
import eliot.build.RealWorld

/**
 * The two cases that run on the **platform carrier** instead of on a fake — what the deleted `probe/`
 * used to be, as ordinary tests.
 *
 * They prove what a faked suite by construction cannot: that the production instances exist and bind.
 * Ability resolution happens at monomorphization, so production code instantiated at `Fake` resolves
 * `Process[Fake]` and never `Process[IO]`; these two reach `Process[IO]`, `Throw[IoError]` and
 * `Throw[GitError]` over it, and `eliot.build.Git`'s own raise path through all three.
 *
 * **The carrier is the injection point here exactly as it is for a fake.** A test runs production code
 * on a fake by naming that carrier at a slot that fixes it (`journalOf`, `answerOf`); it runs the same
 * code on the *platform's* carrier by naming `runMain`, which is the jvm layer's **run boundary** —
 * `def runMain[A](io: IO[A]): A`, the very call the synthesized entry point wraps a program's `main`
 * in. A run boundary's slot fixes the concrete carrier, so what is handed to it is performed *in `IO`*
 * rather than in the carrier of the case that wrote it.
 *
 * Which is why this suite declares **no row beyond `Writer`** and these cases are written `in pure` —
 * the strictest body the framework has, `Id`, which cannot itself perform anything. Nothing propagates
 * to `eliot.test.Runner`, so the framework needs no knowledge of `Process`, and would need none of an
 * ability this project invented yesterday. A suite never grows a row; the effect is discharged where
 * it is performed, at a carrier the test named.
 *
 * The cost, stated plainly: naming `runMain` means `import eliot.jvm.IO`, so **this file is pinned to
 * the jvm platform** — correctly, since a test about what the platform's instances do is a test about
 * that platform. Portable suites stay carrier-generic and use fakes.
 *
 * **They do no network and write nothing**: one asks git about a repository that does not exist, the
 * other asks for a program that does not exist. Both assert the *shape* of the report rather than a
 * diagnostic, because the wording belongs to whichever git and whichever operating system is running
 * the suite.
 */
def testCases: {Writer[List[TestResult]]} Unit = {
   "the platform" should "run git for real, and report what git said when it said no" in pure {
      opening(refusalPrefix, runMain(tagReportOf("no-such-repository-anywhere", here))) shouldBe refusalPrefix
   }
   "the platform" should "raise, not answer, when a program cannot be started at all" in pure {
      opening("io: ", runMain(spawnReportOf("no-such-program-anywhere", here))) shouldBe "io: "
   }
}

private def here: Path = path(".")

private def refusalPrefix: String =
   "'git ls-remote --tags no-such-repository-anywhere' failed with exit code "

/**
 * As much of `report` as `expected` is long — the report's opening, so a case pins the shape of what
 * was reported without pinning a diagnostic that belongs to whichever git is installed.
 */
private def opening(expected: String, report: String): String = take(length(expected), report)
