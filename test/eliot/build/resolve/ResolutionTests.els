import eliot.collection.List
import eliot.test.Assertion
import eliot.test.Test
import eliot.build.model.PackageId
import eliot.build.model.Version
import eliot.build.resolve.Configuration
import eliot.build.resolve.Selection
import eliot.build.resolve.Resolution
import eliot.build.resolve.TablePackages

def testCases: Test = {
   "resolve" should "select the version the only requirement declared" in {
      resolved("test {\n  dep github.com/x/foo v1.2\n}", publishing("github.com/x/foo@v1.2", ""))
         shouldBe "github.com/x/foo v1.2"
   }
   "resolve" should "select the maximum of two declared minimums" in {
      resolved(
         "dep github.com/x/foo v1.2\ntest {\n  dep github.com/x/foo v1.4\n}",
         publishing("github.com/x/foo@v1.2", "").published("github.com/x/foo@v1.4", "")
      ) shouldBe "github.com/x/foo v1.4"
   }
   "resolve" should "keep a requirement that asks for less than is already selected" in {
      resolved(
         "dep github.com/x/foo v1.4\ntest {\n  dep github.com/x/foo v1.1\n}",
         publishing("github.com/x/foo@v1.4", "")
      ) shouldBe "github.com/x/foo v1.4"
   }
   "resolve" should "follow what a dependency itself requires" in {
      resolved(
         "dep github.com/x/foo v1.2",
         publishing("github.com/x/foo@v1.2", "dep github.com/x/bar v1.1").published("github.com/x/bar@v1.1", "")
      ) shouldBe "github.com/x/bar v1.1, github.com/x/foo v1.2"
   }
   "resolve" should "raise a transitive minimum above a direct one" in {
      resolved(
         "dep github.com/x/foo v1.2\ndep github.com/x/bar v1.0",
         publishing("github.com/x/foo@v1.2", "dep github.com/x/bar v1.5")
            .published("github.com/x/bar@v1.0", "")
            .published("github.com/x/bar@v1.5", "")
      ) shouldBe "github.com/x/bar v1.5, github.com/x/foo v1.2"
   }
   "resolve" should "follow the edges of the module a dependency line selected" in {
      resolved(
         "dep github.com/x/foo//jvm v1.2",
         publishing("github.com/x/foo@v1.2", "module jvm {\n  dep github.com/x/bar v1.1\n}")
            .published("github.com/x/bar@v1.1", "")
      ) shouldBe "github.com/x/bar v1.1, github.com/x/foo v1.2"
   }
   "resolve" should "leave the edges of a module nobody selected out of the closure" in {
      resolved(
         "dep github.com/x/foo v1.2",
         publishing("github.com/x/foo@v1.2", "module jvm {\n  dep github.com/x/bar v1.1\n}")
            .published("github.com/x/bar@v1.1", "")
      ) shouldBe "github.com/x/foo v1.2"
   }
   "resolve" should "follow a selected module's siblings, which is how a layer carries its base" in {
      resolved(
         "dep github.com/e/eliot//jvm v1.2",
         publishing(
            "github.com/e/eliot@v1.2",
            "module jvm {\n  dep //stdlib\n}\nmodule stdlib {\n  dep github.com/x/bar v1.1\n}"
         ).published("github.com/x/bar@v1.1", "")
      ) shouldBe "github.com/e/eliot v1.2, github.com/x/bar v1.1"
   }
   "resolve" should "record every module of a repository the closure reached" in {
      mounted(
         "github.com/e/eliot",
         "dep github.com/e/eliot//jvm v1.2",
         publishing("github.com/e/eliot@v1.2", "module jvm {\n  dep //stdlib\n}\nmodule stdlib {\n}")
      ) shouldBe "//jvm, //stdlib"
   }
   "resolve" should "record the root module for a dependency line carrying no selector" in {
      mounted("github.com/x/foo", "dep github.com/x/foo v1.2", publishing("github.com/x/foo@v1.2", ""))
         shouldBe "<root>"
   }
   "resolve" should "leave a dependency's own test and artifact scopes out of the closure" in {
      resolved(
         "dep github.com/x/foo v1.2",
         publishing(
            "github.com/x/foo@v1.2",
            "dep github.com/x/base v1.0\n" ++
               "test {\n  dep github.com/x/tester v1\n}\nartifact app {\n  dep github.com/x/jvm v1\n}"
         ).published("github.com/x/base@v1.0", "")
      ) shouldBe "github.com/x/base v1.0, github.com/x/foo v1.2"
   }
   "resolve" should "treat two module selectors into one repository as one selection" in {
      resolved(
         "dep github.com/e/eliot//stdlib v1.2\ndep github.com/e/eliot//jvm v1.4",
         publishing("github.com/e/eliot@v1.2", "").published("github.com/e/eliot@v1.4", "")
      ) shouldBe "github.com/e/eliot v1.4"
   }
   "resolve" should "select nothing for a sibling module, which versions with its own repository" in {
      resolved("dep //stdlib", publishing("unused", "")) shouldBe ""
   }
   "resolve" should "reach a package by every path a diamond offers, selecting it once" in {
      resolved(
         "dep github.com/x/left v1.0\ndep github.com/x/right v1.0",
         publishing("github.com/x/left@v1.0", "dep github.com/x/base v1.1")
            .published("github.com/x/right@v1.0", "dep github.com/x/base v1.3")
            .published("github.com/x/base@v1.1", "")
            .published("github.com/x/base@v1.3", "")
      ) shouldBe "github.com/x/base v1.3, github.com/x/left v1.0, github.com/x/right v1.0"
   }
   "resolve" should "terminate on a dependency cycle" in {
      resolved(
         "dep github.com/x/foo v1.0",
         publishing("github.com/x/foo@v1.0", "dep github.com/x/bar v1.0")
            .published("github.com/x/bar@v1.0", "dep github.com/x/foo v1.0")
      ) shouldBe "github.com/x/bar v1.0, github.com/x/foo v1.0"
   }
   "resolve" should "call two URLs one package when their anchors agree" in {
      resolvedWithAnchors(
         "dep github.com/x/foo v1.2\ntest {\n  dep gitlab.com/mirror/foo v1.4\n}",
         publishing("github.com/x/foo@v1.2", "").published("github.com/x/foo@v1.4", ""),
         anchoring("github.com/x/foo@v1", "a1b2c3").anchored("gitlab.com/mirror/foo@v1", "a1b2c3")
      ) shouldBe "github.com/x/foo v1.4"
   }
   "resolve" should "keep two packages apart when their anchors differ" in {
      resolvedWithAnchors(
         "dep github.com/x/foo v1.2\ntest {\n  dep gitlab.com/other/foo v1.4\n}",
         publishing("github.com/x/foo@v1.2", "").published("gitlab.com/other/foo@v1.4", ""),
         anchoring("github.com/x/foo@v1", "a1b2c3").anchored("gitlab.com/other/foo@v1", "d4e5f6")
      ) shouldBe "github.com/x/foo v1.2, gitlab.com/other/foo v1.4"
   }
   "resolve" should "unify nothing on a missing anchor, which is evidence of nothing" in {
      resolved(
         "dep github.com/x/foo v1.2\ntest {\n  dep gitlab.com/mirror/foo v1.4\n}",
         publishing("github.com/x/foo@v1.2", "").published("gitlab.com/mirror/foo@v1.4", "")
      ) shouldBe "github.com/x/foo v1.2, gitlab.com/mirror/foo v1.4"
   }
   "resolve" should "refuse two compatibility lines of one package" in {
      resolved(
         "dep github.com/x/foo v1.2\ntest {\n  dep github.com/x/foo v2.0\n}",
         publishing("github.com/x/foo@v1.2", "")
      ) shouldBe "github.com/x/foo is required at both v1.2 and v2.0, which are different compatibility lines"
   }
   "resolve" should "report a version the source does not publish" in {
      resolved("dep github.com/x/foo v1.2", publishing("github.com/x/foo@v1.1", ""))
         shouldBe "github.com/x/foo publishes no v1.2"
   }
   "resolve" should "resolve the base dependencies together with the artifact's own" in {
      resolvedFor(
         "controller-jvm",
         "dep github.com/x/api v2.0\nartifact controller-jvm {\n  dep github.com/x/jvm v1.3\n}",
         publishing("github.com/x/api@v2.0", "").published("github.com/x/jvm@v1.3", "")
      ) shouldBe "github.com/x/api v2.0, github.com/x/jvm v1.3"
   }
   "resolve" should "leave another artifact's platform layer out of this one" in {
      resolvedFor(
         "controller-jvm",
         "artifact controller-jvm {\n  dep github.com/x/jvm v1.3\n}\n" ++
            "artifact controller-attiny {\n  dep github.com/x/avr v1.1\n}",
         publishing("github.com/x/jvm@v1.3", "").published("github.com/x/avr@v1.1", "")
      ) shouldBe "github.com/x/jvm v1.3"
   }
   "resolve" should "report a configuration the descriptor does not name" in {
      resolvedFor("controller-avr", "artifact controller-jvm {\n}", publishing("unused", ""))
         shouldBe "no configuration named 'controller-avr'"
   }
   "resolutionDepthLimit" should "be the number of rounds the closure may take" in {
      show(resolutionDepthLimit) shouldBe "64"
   }
   "selectedVersionOf" should "answer the version a package was selected at" in {
      versionSelected(
         "github.com/x/foo",
         "dep github.com/x/foo v1.2",
         publishing("github.com/x/foo@v1.2", "")
      ) shouldBe "v1.2"
   }
   "selectedVersionOf" should "answer nothing for a package the closure never reached" in {
      versionSelected(
         "github.com/x/elsewhere",
         "dep github.com/x/foo v1.2",
         publishing("github.com/x/foo@v1.2", "")
      ) shouldBe "<unselected>"
   }
}

/**
 * A package universe held as data: what each repository publishes at each version, as descriptor
 * text, and what each compatibility line's anchor tag names.
 *
 * The resolver never sees these tables. It declares `{PackageSource}` and names no implementation, so
 * what answers its two questions is decided by whoever runs it — here `eliot.build.resolve.TablePackages`,
 * bound by the one `with` in `against` and reading them out of a `Universe`, and in the launcher the
 * git-backed default. That the same code runs on both, unchanged and unaware, is the whole point of
 * the source being an effect.
 */
private def resolved(rootText: String, universe: List[Pair[String, String]]): String =
   resolvedWithAnchors(rootText, universe, empty)

private def resolvedWithAnchors(
   rootText: String,
   universe: List[Pair[String, String]],
   lineages: List[Pair[String, String]]
): String =
   reported(
      against(universeOf(universe, lineages), renderedSelections(resolve(TestScope, descriptorOf(rootText))))
   )

private def resolvedFor(configurationName: String, rootText: String, universe: List[Pair[String, String]]): String =
   reported(
      against(
         universeOf(universe, empty),
         renderedSelections(resolve(ArtifactNamed(configurationName), descriptorOf(rootText)))
      )
   )

/**
 * The modules of `url` the test configuration of `rootText` reached, in the order it reached them —
 * the half of a selection that decides what a build mounts and whose edges the closure follows.
 */
private def mounted(url: String, rootText: String, universe: List[Pair[String, String]]): String =
   reported(
      against(
         universeOf(universe, empty),
         renderedModules(repositoryAt(url), resolve(TestScope, descriptorOf(rootText)))
      )
   )

private def renderedModules(repository: Repository, resolution: Resolution): String =
   foldOption(
      "<unselected>",
      selection -> selection.selectedModules.map(namedSelector).joined(", "),
      resolution.selections.find(selection -> selection.selectedRepository == repository)
   )

/**
 * The root module spells itself as nothing — that is what a `dep` line with no selector carries — so
 * it is named here rather than asserted as the empty string it renders as.
 */
private def namedSelector(selector: ModuleSelector): String =
   fold(show(selector) == "", "<root>", show(selector))

/**
 * The version `url` was selected at in the test configuration of `rootText`, so the reading side of a
 * resolution is exercised rather than only its rendering.
 */
private def versionSelected(url: String, rootText: String, universe: List[Pair[String, String]]): String =
   reported(
      against(
         universeOf(universe, empty),
         renderedVersion(selectedVersionOf(repositoryAt(url), resolve(TestScope, descriptorOf(rootText))))
      )
   )

private def renderedVersion(version: Option[Version]): String =
   foldOption("<unselected>", selected -> show(selected), version)

/**
 * The answer on one line, or the error instead — both outcomes asserted the same way.
 *
 * Every case renders *inside* the `against`, so the only `provide[Universe, _]` this suite and
 * `AssemblyTests` between them instantiate is the one answering a `String`. Not by preference: as of
 * compiler `ea3e27ed` two `provide` instantiations whose JVM descriptors agree get one
 * `withCellInternal` native between them, and the other fails at run time with `NoSuchMethodError`
 * (`docs/effectful-modules.md` §11.3). Two suites resolving into two different result types is exactly
 * that case. Undo once the compiler emits both.
 */
private def reported(outcome: Either[ResolutionError, String]): String =
   foldEither(error -> show(error), rendered -> rendered, outcome)

private def renderedSelections(resolution: Resolution): String = resolution.selections.joined(", ")

private def publishing(key: String, text: String): List[Pair[String, String]] = published(key, text, empty)

private def published(key: String, text: String, entries: List[Pair[String, String]]): List[Pair[String, String]] =
   append(entries, Pair(key, text))

private def anchoring(key: String, commit: String): List[Pair[String, String]] = anchored(key, commit, empty)

private def anchored(key: String, commit: String, entries: List[Pair[String, String]]): List[Pair[String, String]] =
   append(entries, Pair(key, commit))
