/**
 * What identifies a package, and the canonical form two spellings of one package are compared in.
 *
 * **The URL is the identity** — there is no name, because a name needs a central place to live and
 * that place is the registry this design does without. The consequence is that URL equality has to
 * be *defined*, not assumed: `GitHub.com/x/foo.git`, `https://github.com/x/foo` and
 * `github.com/x/foo/` are one package, and a resolver that missed that would resolve it twice and
 * collide far away, at the merge of fully qualified names, with an error naming nothing that caused
 * it.
 *
 * Canonicalizing at the one place identities are built settles that case with no network, which is
 * why it is done here — but it is deliberately *not* where correctness lives. A URL is exactly what
 * does not survive a rename, an org transfer or a host migration, so resolution also calls two
 * packages the same when their `vM.0` tags name the same commit (see `docs/build-system.md`). This
 * type answers the offline half of that question; the lineage half belongs to the resolver, which is
 * the part holding a remote.
 *
 * A `//name` selector names one of the packages inside a repository, and it is never optional: a
 * repository is not a package, so a URL alone names nothing a build could mount. It is part of the
 * identity — `…/eliot//stdlib` and `…/eliot//jvm` are different dependencies — but not of the
 * *repository*, which is what git fetches and what tags version: packages of one repository version
 * together, since a tag is repository-wide. That is why there are four types here rather than one:
 * a `Repository` is what is cloned, tagged, cached and selected; a `PackageName` is which package of
 * one is wanted; a `Package` is the two together; a `PackageId` is what a `dep` line spells, which
 * may also be a *sibling* — a package of the repository being read, with no URL and no version of its
 * own.
 */
/**
 * A repository, by its canonical URL: the unit git works in — what is cloned, what a version tag
 * applies to, what the cache keys a mirror by, and what resolution selects a version of.
 */
data Repository(repositoryUrl: String)

/**
 * The name of a package inside a repository — what `//name` selects and what a `package` clause
 * declares.
 */
data PackageName(packageNameText: String)

/**
 * A foreign package a dependency refers to: a repository and the one package of it wanted.
 */
data Package(packageRepository: Repository, selectedPackage: PackageName)

/**
 * What a `dep` line, or a `backend` clause, names: a package of the repository being read
 * (`//stdlib`), or a package in a foreign repository. A sibling is a *constructor* rather than a
 * package with an empty URL, so the code that must treat the two differently — resolution selects
 * nothing for a sibling — matches on it rather than testing a sentinel.
 */
data PackageId = Sibling(siblingPackage: PackageName) | Foreign(foreignPackage: Package)

/**
 * The package `text` identifies, in canonical form — aborting where it identifies none, which is what
 * a URL with no `//name` selector is.
 *
 * ```eliot
 * val stdlib = packageId("github.com/eliot-lang/eliot//stdlib")
 * ```
 *
 * Canonical means: no scheme (descriptors are scheme-less by invariant — transports are the
 * consumer's configuration, not the package's identity), no trailing slash, no `.git` suffix, and a
 * lowercase host. The *path* keeps its case, because only the host is case-insensitive by
 * specification — lowercasing `github.com/Acme/Foo` would invent an identity no remote answers to.
 */
def packageId(text: String): {Abort} PackageId = {
   val body = withoutScheme(text)
   val url = before("//", body)
   val name = orAbort(selectorOf(body))

   fold(url == "", Sibling(name), Foreign(Package(Repository(canonicalUrl(url)), name)))
}

implement Show[Repository] {
   def show(value: Repository): String = value.repositoryUrl
}

implement Eq[Repository] {
   def equals(a: Repository, b: Repository): Bool = a.repositoryUrl == b.repositoryUrl
}

/**
 * An arbitrary but stable total order, so anything the tool writes out keyed by repository — a
 * lockfile above all — has one canonical line order and diffs only where the resolution changed.
 */
implement Compare[Repository] {
   def lessThanOrEqual(a: Repository, b: Repository): Bool = a.repositoryUrl <= b.repositoryUrl
}

implement Show[PackageName] {
   def show(value: PackageName): String = value.packageNameText
}

implement Eq[PackageName] {
   def equals(a: PackageName, b: PackageName): Bool = a.packageNameText == b.packageNameText
}

/**
 * The canonical spelling, which is also what a descriptor is written back out as.
 */
implement Show[Package] {
   def show(value: Package): String = show(value.packageRepository) ++ "//" ++ show(value.selectedPackage)
}

/**
 * Identity, compared in canonical form. Both sides are already canonical by construction, so
 * comparing the rendering is comparing the identity — and it stays right by construction as the
 * canonical form grows.
 */
implement Eq[Package] {
   def equals(a: Package, b: Package): Bool = show(a) == show(b)
}

implement Show[PackageId] {
   def show(value: PackageId): String = value match {
      case Sibling(name)    -> "//" ++ show(name)
      case Foreign(package) -> show(package)
   }
}

implement Eq[PackageId] {
   def equals(a: PackageId, b: PackageId): Bool = show(a) == show(b)
}

private def withoutScheme(text: String): String = fold(contains("://", text), after("://", text), text)

/**
 * The name after the `//`, where there is one and it is not empty — `…/foo//` selects no more than
 * `…/foo` does.
 */
private def selectorOf(body: String): Option[PackageName] =
   fold(isEmpty(after("//", body)), None, Some(PackageName(after("//", body))))

/**
 * The suffixes are stripped outermost first, so a URL wearing both (`…/foo.git/`) loses both.
 */
private def canonicalUrl(url: String): String = {
   val trimmed = withoutSuffix(".git", withoutSuffix("/", url))
   val host = before("/", trimmed)

   toLowerCase(host) ++ drop(length(host), trimmed)
}

private def withoutSuffix(suffix: String, text: String): String =
   fold(endsWith(suffix, text), take(length(text) - length(suffix), text), text)
