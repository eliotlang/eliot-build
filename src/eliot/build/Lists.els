import eliot.carrier.Effect
import eliot.collection.List

/**
 * The list operations the build system needs beyond the three the standard library declares
 * (`empty`, `append`, `foldLeft`).
 *
 * Every one of them is derived from `foldLeft` alone — no natives, no recursion — which is what a
 * total language buys: iteration is a value the platform hands you, and everything else is folding.
 * They live here rather than in `eliot.collection.List` only because this repository cannot add to
 * the standard library; each is a candidate to move there unchanged.
 *
 * The subject is last throughout, so they dot-chain: `list.map(f).filter(p)`. The standard library's
 * own `append` is the exception — it takes the list *first*, so it is always written as a plain call.
 */
def isEmpty[A](list: List[A]): Bool = list.foldLeft(true, _ -> _ -> false)

def size[A](list: List[A]): Int = list.foldLeft(0, _ -> acc -> acc + 1)

/**
 * The single-element list — the missing constructor between `empty` and `append`.
 */
def singleton[A](element: A): List[A] = append(empty, element)

def map[A, B](f: A => B, list: List[A]): List[B] =
   list.foldLeft(empty, e -> acc -> append(acc, f(e)))

/**
 * `map` for a transformation that performs effects — the same fold, with the effect row declared so
 * it can ride out to the caller. Separate from `map` rather than replacing it, because a payload
 * type parameter can never stand for a computation: a pure `map` cannot be handed an effectful
 * function, and an effectful `mapEffect` would force a carrier on every pure use.
 */
def mapEffect[A, B](f: A => {Effect} B, list: List[A]): {Effect} List[B] =
   list.foldLeft(empty, e -> acc -> {
      val mapped = f(e)

      append(acc, mapped)
   })

def flatMapEffect[A, B](f: A => {Effect} List[B], list: List[A]): {Effect} List[B] =
   list.foldLeft(empty, e -> acc -> {
      val mapped = f(e)

      acc ++ mapped
   })

def filter[A](keep: A => Bool, list: List[A]): List[A] =
   list.foldLeft(empty, e -> acc -> fold(keep(e), append(acc, e), acc))

/**
 * The *first* element satisfying `predicate`, or `None` when none does — the accumulator is only
 * reconsidered while it is still `None`.
 */
def find[A](predicate: A => Bool, list: List[A]): Option[A] =
   list.foldLeft(None, e -> acc -> foldOption(firstMatch(predicate, e), _ -> acc, acc))

def any[A](predicate: A => Bool, list: List[A]): Bool =
   list.foldLeft(false, e -> acc -> acc || predicate(e))

def all[A](predicate: A => Bool, list: List[A]): Bool =
   list.foldLeft(true, e -> acc -> acc && predicate(e))

def reverse[A](list: List[A]): List[A] =
   list.foldLeft(empty, e -> acc -> singleton(e) ++ acc)

/**
 * The last element of `list`, or `None` when it is empty. Cheaper than `head`, because a left fold
 * arrives at the end anyway — which is why the descriptor parser keeps its open clauses stacked with
 * the innermost one *last*.
 */
def last[A](list: List[A]): Option[A] = list.foldLeft(None, e -> _ -> Some(e))

def head[A](list: List[A]): Option[A] =
   list.foldLeft(None, e -> acc -> foldOption(Some(e), _ -> acc, acc))

/**
 * `list` without its leading element, or `empty` when it has none — `head`'s counterpart, and how a
 * clause's arguments are taken from its tokens once the keyword is off the front.
 */
def tail[A](list: List[A]): List[A] = {
   val walked: Pair[List[A], Bool] = list.foldLeft(
      Pair(empty, false),
      e -> acc -> fold(acc.second, Pair(append(acc.first, e), true), Pair(acc.first, true))
   )

   walked.first
}

/**
 * `list` without its last element, or `empty` when it has none — the pop half of the stack whose
 * push is `append` and whose peek is `last`. Folds carrying each element one step behind, so the
 * final element is the one never emitted.
 */
def dropLast[A](list: List[A]): List[A] = {
   val walked: Pair[List[A], Option[A]] = list.foldLeft(
      Pair(empty, None),
      e -> acc -> Pair(foldOption(acc.first, held -> append(acc.first, held), acc.second), Some(e))
   )

   walked.first
}

/**
 * `list` with its last element replaced by `element`, or `list` unchanged when it is empty — the
 * update-the-stack-top operation.
 */
def replaceLast[A](element: A, list: List[A]): List[A] =
   fold(list.isEmpty, list, append(list.dropLast, element))

def concat[A](lists: List[List[A]]): List[A] =
   lists.foldLeft(empty, e -> acc -> acc ++ e)

def flatMap[A, B](f: A => List[B], list: List[A]): List[B] =
   list.foldLeft(empty, e -> acc -> acc ++ f(e))

/**
 * The value stored under `key`, aborting when the association list holds no such key. `{Abort}`
 * rather than `Option`, so a lookup answers itself at the use site with `else`; `runAbort` recovers
 * the optional form.
 */
def lookup[K ~ Eq, V](key: K, entries: List[Pair[K, V]]): {Abort} V = orAbort(entries.lookupOption(key))

/**
 * The optional half of `lookup`. Folded directly rather than written as `find` composed with a map
 * over the `Option`: that composition type-checks but makes the backend drop the `foldLeft`
 * specialization it needs, and the program dies with a `NoSuchMethodError` at run time.
 */
def lookupOption[K ~ Eq, V](key: K, entries: List[Pair[K, V]]): Option[V] =
   entries.foldLeft(None, entry -> acc -> foldOption(matchingValue(key, entry), _ -> acc, acc))

/**
 * `entries` with `key` bound to `value`: an existing binding is replaced where it stands, a new key
 * is appended. The association-list stand-in for a map update — adequate while the build system's
 * maps hold one entry per declared dependency.
 */
def put[K ~ Eq, V](key: K, value: V, entries: List[Pair[K, V]]): List[Pair[K, V]] =
   fold(
      entries.any(entry -> entry.first == key),
      entries.map(entry -> fold(entry.first == key, Pair(key, value), entry)),
      append(entries, Pair(key, value))
   )

/**
 * `list` in ascending order, by insertion sort over the fold. Quadratic, and deliberately so: it is
 * the sort a language without recursion can express, and the build system's lists — the dependencies
 * of one package, the entries of one directory — are short.
 */
def sorted[A ~ Compare](list: List[A]): List[A] =
   list.foldLeft(empty, e -> acc -> insert(e, acc))

/**
 * `element` inserted into the already-ascending `sortedList`, before the first element greater than
 * it. Carries a "placed yet?" flag through the fold, since the insertion point is decided once and
 * every later element simply follows.
 */
def insert[A ~ Compare](element: A, sortedList: List[A]): List[A] = {
   val placed: Pair[List[A], Bool] = sortedList.foldLeft(
      Pair(empty, false),
      e -> acc -> fold(
         acc.second || e <= element,
         Pair(append(acc.first, e), acc.second),
         Pair(append(append(acc.first, element), e), true)
      )
   )

   fold(placed.second, placed.first, append(placed.first, element))
}

/**
 * The elements of `list` rendered and joined with `separator` — the inverse of splitting a line into
 * tokens, and the workhorse of every diagnostic the build system prints.
 */
def joined[A ~ Show](separator: String, list: List[A]): String =
   list.foldLeft("", e -> acc -> fold(acc == "", show(e), acc ++ separator ++ show(e)))

/**
 * `f` applied inside an `Option`. It belongs in `eliot.lang.Option` — an instance-free combinator
 * over a standard type — and sits here only because this repository cannot add to that module.
 */
def mapOption[A, B](f: A => B, o: Option[A]): Option[B] = o.foldOption(None, a -> Some(f(a)))

/**
 * `Some(element)` when it satisfies `predicate`, `None` otherwise — `find`'s per-element test, named
 * so that its fold reads as a single expression.
 */
private def firstMatch[A](predicate: A => Bool, element: A): Option[A] =
   fold(predicate(element), Some(element), None)

/**
 * `Some` of the entry's value when its key matches, `None` otherwise — `lookupOption`'s per-entry
 * test.
 */
private def matchingValue[K ~ Eq, V](key: K, entry: Pair[K, V]): Option[V] =
   fold(entry.first == key, Some(entry.second), None)
