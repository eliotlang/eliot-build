import eliot.collection.List
import eliot.file.Path
import eliot.file.File
import eliot.build.PackageId
import eliot.build.Version
import eliot.build.Descriptor
import eliot.build.Git
import eliot.build.Cache

/**
 * Where a resolver's answers come from: the two questions minimal version selection asks of the world,
 * as an algebra rather than as arguments.
 *
 * Resolution asks a remote exactly two things — *what does this package require at this version*, and
 * *is this URL a package I already have* — and notably not a third: MVS never enumerates what a
 * package offers, so discovering that a newer release exists belongs to `eliot get` rather than here.
 *
 * This used to be a pair of callbacks threaded through every private function of
 * `eliot.build.Resolution`. Declaring it as an effect is what removed the plumbing: the algorithm
 * says `{PackageSource}` and the question of *which* source answers is the caller's, all the way up
 * to whoever runs it.
 *
 * **What a member declares is what the resolver must handle.** Neither question fails in a way MVS
 * can act on, so neither member declares a row: a missing descriptor is `None`, and the ways the
 * *git-backed* source can fail — a process that will not start, a repository that is not there, a
 * descriptor that will not parse — are declared by that implementation's own clauses and charged
 * where it is bound, not at every call in the algorithm. A test binds a source that cannot fail at
 * all and is charged nothing, which is why a resolver test declares no row beyond its own.
 */
effect PackageSource {
   /**
    * What `target` published at `version`, absent where it publishes nothing there.
    */
   def descriptorAt(version: Version, target: Repository): Option[Descriptor]

   /**
    * The commit `target`'s `line` starts at, absent where that line has no first release.
    */
   def anchorAt(line: Line, target: Repository): Option[Commit]
}

/**
 * Where mirrors live, until there is a launcher to decide it.
 *
 * A constant rather than a parameter, and not an oversight: the effect's operations carry what the
 * *resolver* knows, which is a repository and a version and never a cache directory. So the source's own
 * configuration sits here, at the one place that binds resolution to a cache, and moves into the
 * launcher's hands when the launcher exists. `eliot.build.Cache` itself takes its root as a parameter
 * and is indifferent. A `{Dep[Path]}` on the default implementation's clauses is what this becomes
 * when there is a launcher to supply it — the shape `eliot.build.TablePackages` already uses.
 */
def packageCacheRoot: Path = path("target/cache")

/**
 * The git-backed source: it asks `Git` about the local mirror and reads what the mirror holds.
 *
 * Its clauses declare what it runs on — `{Git}` and the mirror on disk — and the three ways that can
 * fail: a repository git says no to, a cache directory that cannot be made, a descriptor that will not
 * parse. Those are bound where *this* implementation is bound rather than at every question the resolver
 * asks, and `Git` is bound one step further out again, so nothing here says whether git is a subprocess.
 *
 * Named rather than the default for the reason `eliot.build.Git` gives for `shellGit`: a clause row is
 * bound in the scope of the `with` that binds the name, so a test can write
 * `descriptorAt(…) with gitPackages with tableGit` and reach these clauses with a table beneath them,
 * where an anonymous default would bind them to whatever `Git` the platform has — which is none. The
 * launcher's run boundary writes `with gitPackages with shellGit` once, and that is the whole of the
 * tool's composition.
 */
implement gitPackages: PackageSource {
   def descriptorAt(
         version: Version,
         target: Repository
      ): {Git, FileSystem, Throw[IoError], Throw[GitError], Throw[DescriptorError]} Option[Descriptor] = {
      val published = descriptorTextAt(packageCacheRoot, version, target)

      foldOption(None, text -> Some(parseDescriptor(split("\n", text))), published)
   }

   def anchorAt(
         line: Line,
         target: Repository
      ): {Git, FileSystem, Throw[IoError], Throw[GitError]} Option[Commit] =
      anchorOf(packageCacheRoot, line, target)
}
