import eliot.carrier.Effect
import eliot.collection.List
import eliot.file.Path
import eliot.file.File
import eliot.system.Process
import eliot.build.PackageId
import eliot.build.Version
import eliot.build.Descriptor
import eliot.build.Git
import eliot.build.Cache

/**
 * Where a resolver's answers come from: the two questions minimal version selection asks of the world,
 * as an algebra rather than as arguments.
 *
 * Resolution asks a remote exactly two things — *what does this package require at this version*, and
 * *is this URL a package I already have* — and notably not a third: MVS never enumerates what a
 * package offers, so discovering that a newer release exists belongs to `eliot get` rather than here.
 *
 * This used to be a pair of callbacks threaded through every private function of
 * `eliot.build.Resolution`, because an ability method that declares a row *is* an effect, and an
 * effect with no carrier and no handler could never be discharged. A test now brings its own carrier
 * and implements the ability for it (`eliot.build.TablePackages`), which is the handler that was
 * missing, so the plumbing goes and the algorithm reads as what it is.
 *
 * **One implementation per carrier, and the production one is a constrained catch-all** — the only
 * placement the orphan rule allows for an instance over an arbitrary carrier is the ability's own
 * module, which is why the git-backed source lives here rather than next to the cache it uses. The
 * consequence is a rule for tests: a fake that happens to satisfy those same constraints matches this
 * instance too and the query becomes ambiguous, so a test carrier implements the *minimum* — a
 * resolver test wants a table of descriptors, not a fake process.
 */
ability PackageSource[F[_]] {
   /**
    * What `target` published at `version`, absent where it publishes nothing there.
    */
   def descriptorAt(version: Version, target: PackageId): {PackageSource} Option[Descriptor]

   /**
    * The commit `target`'s `majorLine` line starts at, absent where that line has no first release.
    */
   def anchorAt(majorLine: Int, target: PackageId): {PackageSource} Option[String]
}

/**
 * Where mirrors live, until there is a launcher to decide it.
 *
 * A constant rather than a parameter or a `{Dep[…]}`, and neither is an oversight: the ability's
 * methods carry what the *resolver* knows, which is a package and a version and never a cache
 * directory, and `Dep` cannot ride the same carrier stack as `Throw` — the cross-lift matrix is
 * partial and that pair is one of the holes. So the source's own configuration sits here, at the one
 * place that binds resolution to a cache, and moves into the launcher's hands when the launcher
 * exists. `eliot.build.Cache` itself takes its root as a parameter and is indifferent.
 */
def packageCacheRoot: Path = path("target/cache")

/**
 * The git-backed source: any carrier that can spawn, touch the filesystem, and carry the three ways
 * this can fail.
 *
 * A pure carrier implementing only `PackageSource` declines this candidate for want of `Process`,
 * which is what keeps a test's own instance the unique survivor — and in production nothing changes,
 * because a real carrier has all of them.
 */
implement[F[_] ~ Process & FileSystem & Throw[IoError] & Throw[GitError] & Throw[DescriptorError] & Effect] PackageSource[F] {
   def descriptorAt(version: Version, target: PackageId): F[Option[Descriptor]] = {
      val published = descriptorTextAt(packageCacheRoot, version, target)

      foldOption(None, text -> Some(parseDescriptor(split("\n", text))), published)
   }

   def anchorAt(majorLine: Int, target: PackageId): F[Option[String]] =
      anchorOf(packageCacheRoot, majorLine, target)
}
