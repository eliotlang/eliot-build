import eliot.collection.List
import eliot.file.Path
import eliot.file.File
import eliot.system.Process
import eliot.build.Version

/**
 * Talking to git: the operations the tool performs on a repository, as an effect, and the reading of what
 * git says back, as plain functions.
 *
 * There is no embedded git library and there will not be one: the tool shells out to the `git` the
 * user already has, which is Go's original choice and the reason process spawning is the launcher's
 * load-bearing capability. That is `shellGit`'s business, though, and nobody else's: `Git`'s members say
 * what an operation means and which refusal it raises, and `{Process}` and `{Throw[IoError]}` appear
 * only on the clauses of the implementation that spawns, charged where it is bound. A caller declares
 * `{Git}` and says nothing about subprocesses — exactly as it declares `{Console}` and says nothing
 * about file descriptors — and a test of a caller binds a double for `Git` rather than scripting what
 * `ls-remote` would print. The decisions the operations are made of live here either way: which refs
 * count, which commit a tag names, what a version tag even looks like, and which of those questions a
 * non-zero exit answers rather than fails.
 *
 * **Every operation says where it runs.** Git resolves a relative path against *its* working
 * directory, not this program's, and the split is git's own: a command that *names* a repository by
 * path (`clone`, `ls-remote`) is given that path in the caller's frame and so must run where the
 * caller stands, while one that operates on the repository it is standing in (`fetch`, `show`) runs in
 * the mirror and names nothing. Getting it backwards is silent — git reports a missing repository —
 * so the frame is a parameter of the operation rather than a convention of the implementation.
 *
 * Failure has two channels and they are different reports to a user: `GitError` is this module's,
 * raised when git ran fine and *said no*, and `IoError` is the standard library's, raised when a
 * program cannot be started at all. Only the first is part of what an operation *means* — any
 * implementation, a double included, may be asked about a repository that is not there — so only the
 * first is on the members. The second is how the shell implementation fails, and stays on its clauses.
 */

/**
 * A git command that ran and failed — as distinct from a git that could not be run at all, which is
 * the standard library's `IoError`.
 *
 * The command is carried whole rather than summarised. A build tool that shells out is a build tool
 * whose errors are somebody else's, and the only useful thing to say about one is exactly what was
 * run and exactly what it said back, so the user can run it themselves.
 */
data GitError(failedCommand: String, failedExitCode: Int, failedDiagnostics: String)

implement Show[GitError] {
   def show(value: GitError): String =
      "'" ++ value.failedCommand ++ "' failed with exit code " ++ show(value.failedExitCode) ++
         ": " ++ value.failedDiagnostics
}

/**
 * A tag naming a version, and the commit that tag ultimately points at.
 *
 * "Ultimately" is the whole subtlety of reading `git ls-remote`: an annotated tag — which is what a
 * release is — is an object in its own right, so it appears twice, once as itself and once peeled to
 * the commit it wraps. The commit is what a lockfile pins and what an ancestry check compares, so the
 * peeled line is the one that matters and the tag object's own hash is noise.
 */
data TagRef(taggedVersion: Version, taggedCommit: String)

/**
 * Tags order by the version they name, newest last — so the newest release a repository publishes is
 * the last of its sorted tags. That is not a question resolution asks, since MVS selects the maximum
 * of the declared *minimums* and never enumerates; it is what `eliot get` will ask when raising a
 * minimum to what is actually available.
 */
implement Compare[TagRef] {
   def lessThanOrEqual(a: TagRef, b: TagRef): Bool = a.taggedVersion <= b.taggedVersion
}

/**
 * What the tool asks of a repository. Four operations, each saying where it runs, and nothing about
 * how they are carried out: `shellGit` below spawns `git`, a test's double answers from a table, and a
 * caller declaring `{Git}` cannot tell them apart.
 *
 * The members carry `Throw[GitError]` where the operation can be refused, because a refusal is part of
 * what the operation means and a caller may want to handle one per call. `showFile` carries none: it is
 * the one operation that *reads* a refusal rather than raising it.
 */
effect Git {
   /**
    * The versions the repository at `target` publishes — a listing that fetches none of it.
    *
    * `target` is a URL or a path indifferently, which is why one operation serves both discovery against
    * a remote and reading back a mirror already on disk. Either way it is spelled in the caller's frame,
    * so the operation runs in `from` rather than in the repository it asks about.
    */
   def lsRemoteTags(target: String, from: Path): {Throw[GitError]} List[TagRef]

   /**
    * Clone `source` to `target` as a mirror — the whole repository, no working tree.
    *
    * A mirror rather than a checkout because nothing here wants files on disk: a descriptor is read out
    * of the object database with `showFile`, and the ancestry check the design owes reads objects too. A
    * working tree would be a second copy of every source file per package, checked out at one version at
    * a time, for no question anybody asks.
    *
    * Runs in `from` because `target` is a path in the caller's frame — a clone launched from inside the
    * cache root would resolve a relative root a second time and bury the mirror beneath itself.
    */
   def mirrorClone(source: String, target: String, from: Path): {Throw[GitError]} Unit

   /**
    * Bring the mirror at `mirror` up to date with what its remote publishes now, forgetting the tags it
    * has withdrawn.
    *
    * Pruning matters more here than it looks: a tag that stopped existing is a tag the resolver must stop
    * selecting, and a mirror that only ever accumulates would answer with releases the package has
    * withdrawn.
    */
   def fetchTags(mirror: Path): {Throw[GitError]} Unit

   /**
    * One file's content at one point in `mirror`'s history, straight from the object database — absent
    * where the revision or the file is not there.
    *
    * The one operation that *reads* a refusal rather than raising it, and the signature says so by
    * carrying no `Throw[GitError]`. A version nobody tagged and a tag carrying no such file are equally
    * "there is nothing to read", and a caller that reached either has a dependency line to blame that
    * this module cannot see.
    */
   def showFile(revision: String, file: String, mirror: Path): Option[String]
}

/**
 * The `Git` that talks to a repository: it spawns the `git` the user already has, once per operation, in
 * the directory the operation names.
 *
 * **Named, and deliberately not the default.** An implementation's clause rows are bound where the *name*
 * is bound, and the binding comes from the scope of that `with` — so `lsRemoteTags(…) with shellGit`
 * inside a mocked test reaches the framework's process double, which is how this implementation is
 * tested at all. An anonymous default is bound at a slot or at `main` with nothing written, and its
 * clauses then bind the platform's own `Process`: nothing short of a real subprocess could ever check it.
 * The price is one `with shellGit` at the program's run boundary, where the launcher composes the tool,
 * and a `{Git}` reaching `main` without it is a compile error naming the effect — which is the honest
 * state of an effect the program has not yet decided how to run.
 *
 * Its clauses are where `{Process}` and `{Throw[IoError]}` enter the program: git failing to *start* is
 * this implementation's failure, and no caller declaring `{Git}` ever names it.
 */
implement shellGit: Git {
   def lsRemoteTags(target: String, from: Path): {Process, Throw[IoError], Throw[GitError]} List[TagRef] = {
      val listed = checked(command("git").withArgument("ls-remote").withArgument("--tags").withArgument(target), from)

      parseTagRefs(listed)
   }

   def mirrorClone(source: String, target: String, from: Path): {Process, Throw[IoError], Throw[GitError]} Unit = {
      val cloned = checked(
         command("git").withArgument("clone").withArgument("--mirror").withArgument(source).withArgument(target),
         from
      )

      unit
   }

   def fetchTags(mirror: Path): {Process, Throw[IoError], Throw[GitError]} Unit = {
      val fetched = checked(command("git").withArgument("fetch").withArgument("--tags").withArgument("--prune"), mirror)

      unit
   }

   /**
    * `Throw[IoError]` is a different statement from the refusal this reads, and stays: git refusing to
    * answer is what this reads, git failing to *start* is not.
    */
   def showFile(revision: String, file: String, mirror: Path): {Process, Throw[IoError]} Option[String] = {
      val shown = run(command("git").withArgument("show").withArgument(revision ++ ":" ++ file), mirror)

      fold(shown.exitCode == 0, Some(shown.standardOutput), None)
   }
}

/**
 * The versions `output` announces, where `output` is what `git ls-remote --tags` wrote.
 *
 * Anything that is not a version tag is dropped rather than reported. A repository is free to carry
 * `latest`, `2024-06-release` or `v1.0-rc1`, and none of them is a thing resolution can order or
 * select; refusing the whole listing over a tag nobody asked for would make a package unusable for
 * decorating its own history. The tags that *are* versions are exactly the tags MVS can choose
 * between, which is the question being asked.
 */
def parseTagRefs(output: String): List[TagRef] =
   split("\n", output).foldLeft(empty, line -> refs -> withTagLine(line, refs))

/**
 * The commit `version` names, absent when the repository publishes no such version.
 *
 * Versions are compared as the ordering sees them, so a repository that tagged `v1` answers a
 * requirement written `v1.0` — the two spell one point on one line, and only the spelling the author
 * used was ever a tag.
 */
def commitOf(version: Version, tags: List[TagRef]): Option[String] =
   foldOption(None, ref -> Some(ref.taggedCommit), tags.find(ref -> ref.taggedVersion == version))

/**
 * The lineage anchor of the `majorLine` compatibility line: the commit its *first* release names.
 *
 * This is the identity test the resolver falls back on when two canonical URLs disagree. It works
 * because git is content-addressed and the first release tag of a line is immutable, carried by every
 * mirror and every fork, and per-major — precisely the granularity of the append-only contract that
 * the identity question is about. Absent is a legitimate answer and unifies nothing: a line whose
 * history was migrated may start at `v1.3` and have no first release at all.
 */
def anchorCommit(majorLine: Int, tags: List[TagRef]): Option[String] =
   commitOf(Version(majorLine, Some(0)), tags)

/**
 * How to actually reach `url`, which a descriptor deliberately does not say.
 *
 * Dependency URLs are scheme-less by invariant — that is what keeps `//` unambiguously the module
 * selector and what stops two spellings of one transport becoming two identities. So the scheme is
 * supplied here, at the one place bytes are fetched, and `https` is the default rather than the rule:
 * where a package is fetched from is consumer configuration, and this is the function that will grow
 * a mirror table when there is one to grow.
 */
def transportUrl(url: String): String = "https://" ++ url

/**
 * Run `arguments` in `workingDirectory` and answer what it wrote, raising when it exited non-zero —
 * the step every clause of `shellGit` is made of, bar one.
 *
 * The standard library is right that a non-zero exit is data rather than a failure — it is how a
 * program reports a decision — but the decisions reported by the operations above are all the same
 * one: git was asked about a repository and could not answer. The single operation that genuinely
 * wants to *read* a refusal is `showFile`, and it calls `run` itself.
 */
private def checked(arguments: List[String], workingDirectory: Path): {Process, Throw[IoError], Throw[GitError]} String = {
   val result = run(arguments, workingDirectory)
   val failure = failureOf(arguments, result)

   foldOption(result.standardOutput, error -> raise(error), failure)
}

private def failureOf(arguments: List[String], result: ProcessResult): Option[GitError] =
   fold(
      result.exitCode == 0,
      None,
      Some(GitError(arguments.joined(" "), result.exitCode, result.standardError))
   )

private def withTagLine(line: String, refs: List[TagRef]): List[TagRef] =
   foldOption(refs, name -> withTagName(name, before("\t", line), refs), tagNameOf(line))

/**
 * The tag a listing line is about, absent for anything that is not one. A line reads
 * `<commit>\t<ref>`, and `after` answers `""` for a line carrying no tab at all — the trailing empty
 * line every listing ends with — so the `refs/tags/` test rejects those without a length check first.
 */
private def tagNameOf(line: String): Option[String] = {
   val reference = after("\t", line)

   fold(startsWith(tagPrefix, reference), Some(drop(length(tagPrefix), reference)), None)
}

private def withTagName(name: String, commit: String, refs: List[TagRef]): List[TagRef] =
   foldOption(refs, version -> withTag(version, commit, isPeeled(name), refs), versionOfTag(bareTagName(name)))

/**
 * A peeled entry replaces what is known, a plain one only fills a gap. Stated as two rules rather
 * than as "the second line wins" because git's listing order is git's business, and an annotated tag
 * whose peeled line arrived first must not be overwritten by the tag object's own hash.
 *
 * A repository tagging one version twice — `v1` *and* `v1.0`, which the ordering reads as one point —
 * is degenerate, and the first spelling seen is kept. There is no right answer to give it, and it is
 * not worth an error path of its own.
 */
private def withTag(version: Version, commit: String, peeled: Bool, refs: List[TagRef]): List[TagRef] =
   fold(peeled, replacedTag(TagRef(version, commit), refs), addedTag(TagRef(version, commit), refs))

private def replacedTag(ref: TagRef, refs: List[TagRef]): List[TagRef] =
   append(refs.filter(other -> other.taggedVersion != ref.taggedVersion), ref)

private def addedTag(ref: TagRef, refs: List[TagRef]): List[TagRef] =
   fold(refs.any(other -> other.taggedVersion == ref.taggedVersion), refs, append(refs, ref))

private def versionOfTag(name: String): Option[Version] = runAbort(parseVersion(name))

private def isPeeled(name: String): Bool = endsWith(peeledSuffix, name)

private def bareTagName(name: String): String =
   fold(isPeeled(name), take(length(name) - length(peeledSuffix), name), name)

private def tagPrefix: String = "refs/tags/"

/**
 * What git appends to a ref that has been followed to the object it wraps.
 */
private def peeledSuffix: String = "^{}"
