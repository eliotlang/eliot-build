import eliot.collection.List
import eliot.file.Path
import eliot.build.model.PackageId
import eliot.build.model.Version
import eliot.build.model.Descriptor
import eliot.build.model.Lineage


/**
 * Where a build's answers about a package come from: what the tool asks of the world about somebody
 * else's repository, as an algebra rather than as arguments.
 *
 * Resolution asks exactly two things — *what does this package require at this version*, and *is this
 * URL a package I already have* — and notably not a third about *versions*: MVS never enumerates what
 * a package offers, so discovering that a newer release exists belongs to `eliot get` rather than
 * here. The lockfile asks the third: *which commit does this version's tag name*, the fact a tag cannot
 * promise about itself. Assembly asks the one question that is not about the graph at all: *where are
 * this commit's sources*, which is what turns a locked resolution into something a compiler can be
 * pointed at. Four members, and a caller declares `{PackageSource}` whether it wants the graph, the files or
 * the facts.
 *
 * This used to be a pair of callbacks threaded through every private function of
 * `eliot.build.resolve.Resolution`. Declaring it as an effect is what removed the plumbing: the algorithm
 * says `{PackageSource}` and the question of *which* source answers is the caller's, all the way up
 * to whoever runs it.
 *
 * **What a member declares is what the caller must handle.** No question fails in a way the caller can
 * act on, so no member declares a row: a missing descriptor is `None`, and the ways the *git-backed*
 * source can fail — a process that will not start, a repository that is not there, a descriptor that
 * will not parse — are declared by that implementation's own clauses and charged where it is bound,
 * not at every call in the algorithm. A test binds a source that cannot fail at all and is charged
 * nothing, which is why a resolver test declares no row beyond its own.
 */
effect PackageSource {
   /**
    * What `target` published at `version`, absent where it publishes nothing there.
    */
   def descriptorAt(version: Version, target: Repository): Option[Descriptor]

   /**
    * The commit `target`'s `line` starts at, absent where that line has no first release.
    */
   def anchorAt(line: Line, target: Repository): Option[Commit]

   /**
    * The commit `target`'s tag for `version` names, absent where it publishes no such version.
    *
    * The question a lockfile asks once resolution is done: not which version — that is MVS's, and the
    * same everywhere — but what the tag a build selected is *pointing at* today, which a tag, being a
    * ref, cannot promise about itself.
    */
   def commitAt(version: Version, target: Repository): Option[Commit]

   /**
    * Where `target`'s sources at `commit` are, as a directory that exists: the question assembly asks
    * once resolution has decided which version that is and `commitAt` has said which commit it names.
    *
    * By commit rather than by version, so that what is mounted is what was locked: the tag is looked up
    * once, by `commitAt`, and the answer is checked against `eliot.lock` before it is handed back here.
    * A source asked by version would look the tag up a second time, and a tag is a ref that can move.
    *
    * A `Path` and not an `Option[Path]`, because this is the one member that may *make* its answer.
    * The three above read what a repository already published and answer nothing where it published
    * nothing; this one is asked about a commit the source itself just named, so there is no honest
    * absence left — either the sources are put somewhere or the implementation
    * refuses through a channel of its own.
    */
   def sourcesAt(commit: Commit, target: Repository): Path
}
