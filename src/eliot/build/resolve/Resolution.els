import eliot.collection.List
import eliot.build.model.PackageId
import eliot.build.model.Version
import eliot.build.model.Descriptor
import eliot.build.model.Lineage
import eliot.build.resolve.PackageSource
import eliot.build.resolve.Configuration
import eliot.build.resolve.Selection

/**
 * Minimal version selection: the closure of what a build configuration depends on, and the version
 * chosen for each package in it.
 *
 * A declared version is a **minimum**, never a range and never an upper bound, so selection is the
 * maximum of the declared minimums — the oldest version satisfying everyone. That is the whole
 * algorithm: no solver, no backtracking, and the same answer on every machine without consulting a
 * lockfile. Publishing a new version changes nobody's build; only raising a minimum does.
 *
 * What is resolved is a `Configuration` and what comes out is a `Resolution` of `Selection`s, both of
 * them next door: `eliot.build.resolve.Configuration` says which of a descriptor's scopes a
 * configuration opens, and `eliot.build.resolve.Selection` says what a chosen version is and when two
 * spellings are one package. What is left here is the part that is genuinely an algorithm — the
 * closure, the merging of two minimums, and the ceiling it gives up at.
 *
 * **The closure is a fold over rounds.** User code cannot recurse and cannot loop, so a fixpoint is a
 * fixed list of expansions with a frontier carried through it, and a frontier that is still not empty
 * when the rounds are spent raises rather than answering partially.
 *
 * **The source is an effect, not an argument.** Everything here declares `{PackageSource}` — the two
 * questions the algorithm asks the world, declared as an effect in `eliot.build.resolve.PackageSource` and
 * answered by whichever implementation the caller binds: the git-backed cache by default, a table of
 * descriptors under test. Nothing in this module names one, and no function takes a source.
 * Notably absent from the algebra is version listing: MVS never enumerates what a package offers, so
 * discovering that a newer release exists belongs to `eliot get` rather than here.
 */

/**
 * Why a configuration could not be resolved. Each constructor is a question the graph could not
 * answer, and each names the package it is about, because a resolution failure the user cannot
 * attribute to a dependency line is a failure they cannot fix.
 */
data ResolutionError =
   NoSuchConfiguration(missingConfiguration: Configuration) |
   Unavailable(missingRepository: Repository, missingVersion: Version) |
   MajorConflict(conflictedRepository: Repository, oneVersion: Version, otherVersion: Version) |
   TooDeep(reachedDepth: Int)

implement Show[ResolutionError] {
   def show(value: ResolutionError): String = value match {
      case NoSuchConfiguration(configuration) -> "no configuration named '" ++ show(configuration) ++ "'"
      case Unavailable(absent, version) -> show(absent) ++ " publishes no " ++ show(version)
      case MajorConflict(conflicted, one, other) ->
         show(conflicted) ++ " is required at both " ++ show(one) ++ " and " ++ show(other) ++
            ", which are different compatibility lines"
      case TooDeep(depth) -> "dependency graph deeper than " ++ show(depth)
   }
}

/**
 * What `configuration` resolves to: the repository's base dependencies plus the configuration's own
 * — for an artifact, the platform layers among them; for the test scope, the framework and a platform
 * the build host can run — closed over the graph.
 *
 * ```eliot
 * val resolution = resolve(ArtifactNamed("controller-jvm"), descriptor)
 * ```
 */
def resolve(
   configuration: Configuration,
   descriptor: Descriptor
): {PackageSource, Throw[ResolutionError]} Resolution =
   foldOption(
      raise(NoSuchConfiguration(configuration)),
      resolveRequirements,
      configuredDependencies(configuration, descriptor)
   )

/**
 * How many rounds of expansion a closure may take before resolution gives up — one round per level
 * of the dependency graph, so this is the deepest chain of packages a build may have.
 *
 * A declared ceiling rather than a fixpoint loop: user code cannot recurse, so the closure is a fold
 * over a fixed list of rounds and the bound is what the list's length says. Sixty-four is far past
 * anything a real graph reaches, and reaching it raises `TooDeep` rather than silently answering with
 * a partial closure — a wrong answer being the one outcome not on offer.
 */
def resolutionDepthLimit: Int = rounds.size

/**
 * The closure so far: what has been selected, and which of those selections still owe their own
 * requirements to the graph. A selection joins `pending` exactly when it is new, when its version went
 * up, or when it gained a module — which is what makes a cycle terminate, since versions only rise and
 * a module set only grows within what the descriptors name: the second visit learns nothing, so nothing
 * is pending and the remaining rounds are folds over an empty list.
 */
data ResolutionState(selected: List[Selection], pending: List[Selection])

/**
 * The selection this requirement is about, if the closure already has one, together with the anchor
 * that was looked up on the way — kept so a new selection records its lineage without asking twice.
 */
data Identified(matched: Option[Selection], anchorFound: Option[Commit])

private def resolveRequirements(requirements: List[Dependency]): {PackageSource, Throw[ResolutionError]} Resolution = {
   val seeded = withRequirements(None, requirements, emptyState)

   completed(rounds.foldLeft(seeded, _ -> state -> expanded(state)))
}

private def emptyState: ResolutionState = ResolutionState(empty, empty)

/**
 * One round: every pending selection's own requirements folded in, and the frontier replaced by
 * whatever those requirements newly selected or raised.
 */
private def expanded(state: ResolutionState): {PackageSource, Throw[ResolutionError]} ResolutionState = {
   val ready = ResolutionState(state.selected, empty)

   state.pending.foldLeft(ready, selection -> acc -> withDependenciesOf(selection, acc))
}

private def withDependenciesOf(
   selection: Selection,
   state: ResolutionState
): {PackageSource, Throw[ResolutionError]} ResolutionState = {
   val published = descriptorAt(selection.selectedVersion, selection.selectedRepository)

   foldOption(
      raise(Unavailable(selection.selectedRepository, selection.selectedVersion)),
      descriptor -> withRequirements(
         Some(selection.selectedRepository),
         mountedDependencies(selection, descriptor),
         state
      ),
      published
   )
}

/**
 * What a *dependency's* descriptor contributes to the closure: its base dependencies, and those of the
 * modules this selection actually wants. An artifact's dependencies are its own build's business and a
 * test block's are its own suite's — neither travels to a consumer, which is exactly why platform
 * layers are declared there.
 *
 * **The selector narrows the closure, not only the mount.** Feeding every exported module's edges in
 * was harmless while a selector merely picked source directories; it is wrong now that `//stdlib` must
 * not drag in what `//jvm` depends on, which in one repository shipping a base layer and a platform
 * layer is the difference between a base scope that resolves and one that mounts a platform nobody
 * asked for. `exported` still gates: a module a dependent may not mount is a module whose edges are
 * none of the dependent's business either.
 */
private def mountedDependencies(selection: Selection, descriptor: Descriptor): List[Dependency] =
   descriptor.baseDependencies ++
      descriptor.modules
         .filter(module -> module.exported && mounts(module.moduleName, selection))
         .flatMap(module -> module.moduleDependencies)

/**
 * `owner` is the repository whose descriptor `requirements` were read from — absent for the root
 * project, which is the one package a resolution never selects a version of. It is what a sibling line
 * is resolved against: `dep //stdlib` names a module of whoever wrote it.
 */
private def withRequirements(
   owner: Option[Repository],
   requirements: List[Dependency],
   state: ResolutionState
): {PackageSource, Throw[ResolutionError]} ResolutionState =
   requirements.foldLeft(state, dependency -> acc -> withRequirement(owner, dependency, acc))

/**
 * A sibling (`dep //stdlib`) selects no version: it names a module of the repository that declared it,
 * which is already selected at the version its tag gave it. What it does say is that one more module of
 * that repository is in the build — `//jvm` depending on `//stdlib` is how a platform layer carries the
 * base it is written against — so it is added to the owner's selection, and a selection that gained a
 * module owes the graph that module's own edges. A requirement selects its *repository*, and records
 * which module of it was asked for; the module has no bearing on which version is chosen, since a tag
 * is repository-wide.
 */
private def withRequirement(
   owner: Option[Repository],
   dependency: Dependency,
   state: ResolutionState
): {PackageSource, Throw[ResolutionError]} ResolutionState = dependency match {
   case SiblingDependency(name)       -> withSibling(owner, name, state)
   case Requirement(package, minimum) -> withMinimum(package, minimum, state)
}

/**
 * A sibling of the root project's own descriptor reaches nothing: the root is not selected, so there is
 * no selection to add a module to, and what the root mounts of itself is the assembler's question.
 */
private def withSibling(
   owner: Option[Repository],
   name: ModuleName,
   state: ResolutionState
): ResolutionState =
   foldOption(state, known -> wanting(ModuleSelected(name), known, state), ownerSelection(owner, state))

private def ownerSelection(owner: Option[Repository], state: ResolutionState): Option[Selection] =
   foldOption(
      None,
      repository -> state.selected.find(selection -> selection.selectedRepository == repository),
      owner
   )

private def withMinimum(
   package: Package,
   minimum: Version,
   state: ResolutionState
): {PackageSource, Throw[ResolutionError]} ResolutionState = {
   val target = package.packageRepository
   val identity = identified(target, minimum, state)

   foldOption(
      inserted(Selection(target, minimum, identity.anchorFound, singleton(package.selectedModule)), state),
      known -> merged(known, package.selectedModule, minimum, state),
      identity.matched
   )
}

/**
 * Identity, URL first: the canonical URL settles the common case with no source call at all, and only
 * a requirement naming an unfamiliar URL is worth a lineage lookup.
 */
private def identified(target: Repository, minimum: Version, state: ResolutionState): {PackageSource} Identified = {
   val byUrl = state.selected.find(selection -> selection.selectedRepository == target)

   foldOption(byLineage(target, minimum, state), known -> Identified(Some(known), known.lineageAnchor), byUrl)
}

private def byLineage(target: Repository, minimum: Version, state: ResolutionState): {PackageSource} Identified = {
   val anchor = anchorAt(minimum.major, target)

   Identified(state.selected.find(selection -> sameLineage(anchor, minimum, selection)), anchor)
}

/**
 * Two minimums on one package: the higher wins, unless they are not the same compatibility line at
 * all, in which case nothing wins — two majors of one package would collide at the merge of fully
 * qualified names, so the resolver refuses rather than picking.
 */
private def merged(
   known: Selection,
   selector: ModuleSelector,
   minimum: Version,
   state: ResolutionState
): {Throw[ResolutionError]} ResolutionState = {
   val conflict = conflictBetween(known, minimum)

   foldOption(upgraded(known, selector, minimum, state), error -> raise(error), conflict)
}

private def conflictBetween(known: Selection, minimum: Version): Option[ResolutionError] =
   fold(
      sameLine(known.selectedVersion, minimum),
      None,
      Some(MajorConflict(known.selectedRepository, known.selectedVersion, minimum))
   )

/**
 * The known selection keeps its repository — the URL the closure reached first, which is the root's
 * spelling before any dependency's — and takes the higher version and the wider set of modules. A
 * requirement that asks for no more than what is already selected changes nothing, and so queues
 * nothing.
 */
private def upgraded(
   known: Selection,
   selector: ModuleSelector,
   minimum: Version,
   state: ResolutionState
): ResolutionState =
   replacedWhenGrown(
      known,
      Selection(
         known.selectedRepository,
         max(known.selectedVersion, minimum),
         known.lineageAnchor,
         withModule(selector, known.selectedModules)
      ),
      state
   )

/**
 * `known` with one more module among the ones it wants — the sibling half of the same step `upgraded`
 * makes for a requirement, which is why both end in `replacedWhenGrown`.
 */
private def wanting(selector: ModuleSelector, known: Selection, state: ResolutionState): ResolutionState =
   replacedWhenGrown(
      known,
      Selection(
         known.selectedRepository,
         known.selectedVersion,
         known.lineageAnchor,
         withModule(selector, known.selectedModules)
      ),
      state
   )

/**
 * The one rule that keeps the closure finite: a selection re-enters the frontier only when it learned
 * something, and what it can learn — a higher version, one more module — only ever goes one way.
 */
private def replacedWhenGrown(known: Selection, next: Selection, state: ResolutionState): ResolutionState =
   fold(grew(known, next), replaced(next, state), state)

private def grew(known: Selection, next: Selection): Bool =
   known.selectedVersion != next.selectedVersion ||
      known.selectedModules.size != next.selectedModules.size

private def withModule(selector: ModuleSelector, modules: List[ModuleSelector]): List[ModuleSelector] =
   fold(modules.any(known -> known == selector), modules, append(modules, selector))

private def inserted(selection: Selection, state: ResolutionState): ResolutionState =
   ResolutionState(append(state.selected, selection), append(state.pending, selection))

private def replaced(selection: Selection, state: ResolutionState): ResolutionState =
   ResolutionState(
      append(state.selected.filter(other -> other.selectedRepository != selection.selectedRepository), selection),
      append(state.pending, selection)
   )

/**
 * The closure once the rounds are spent: a frontier that is still not empty means the graph is deeper
 * than the declared ceiling, and a partial answer is not one of the outcomes on offer.
 */
private def completed(state: ResolutionState): {Throw[ResolutionError]} Resolution =
   foldOption(Resolution(state.selected.sorted), _ -> raise(TooDeep(resolutionDepthLimit)), state.pending.head)

/**
 * The rounds a closure may take, as data: user code cannot loop, so depth is a list to fold over
 * rather than a condition to repeat under. Six doublings of one round is sixty-four, and
 * `resolutionDepthLimit` reads the length back off the same list so the ceiling and the message about
 * it cannot disagree.
 */
private def rounds: List[Unit] = twice(twice(twice(twice(twice(twice(singleton(unit)))))))

private def twice(list: List[Unit]): List[Unit] = list ++ list
