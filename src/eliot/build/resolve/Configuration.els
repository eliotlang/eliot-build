import eliot.collection.List
import eliot.build.model.Descriptor

/**
 * The unit of resolution: which of a descriptor's dependency scopes are closed over the graph.
 *
 * **Two configurations never meet.** Platform layers are declared per artifact precisely so that
 * flat-listing a jvm layer and an avr layer would not mount both into one resolution and collide on
 * every name a layer implements. So there is no such thing as "the" resolution of a repository —
 * there is one per artifact, plus one for the test scope, and the test scope is a configuration like
 * any other that just needs no `artifact` clause to name it.
 *
 * What a configuration *opens* is a fact about descriptors, true whether or not anybody resolves
 * anything: the repository's base dependencies, plus an artifact's own — the platform layers among
 * them — or plus the test block's, the framework and a platform the build host can run. An artifact's
 * dependencies never reach a consumer and neither do a test block's, which is exactly why platform
 * layers are declared there.
 *
 * Nothing here fails. A configuration nobody declared is absent rather than refused, because *which*
 * error that is belongs to the caller asking — `eliot.build.resolve.Resolution` raises
 * `NoSuchConfiguration`, and a future `eliot get` may want to answer differently.
 */
data Configuration = TestScope | ArtifactNamed(artifactName: String)

implement Show[Configuration] {
   def show(value: Configuration): String = value match {
      case TestScope           -> "test"
      case ArtifactNamed(name) -> name
   }
}

/**
 * The dependencies `configuration` opens of `descriptor`, absent where the descriptor declares no
 * such artifact.
 *
 * ```eliot
 * val requirements = configuredDependencies(ArtifactNamed("controller-jvm"), descriptor)
 * ```
 */
def configuredDependencies(configuration: Configuration, descriptor: Descriptor): Option[List[Dependency]] =
   configuration match {
      case TestScope           -> Some(descriptor.baseDependencies ++ descriptor.testDependencies)
      case ArtifactNamed(name) -> artifactDependenciesOf(name, descriptor)
   }

/**
 * The backend call `configuration` makes, absent where it makes none.
 *
 * Absent covers three different things and deliberately does not tell them apart: the test scope,
 * which has no `artifact` clause to carry one; an artifact that declares no `backend`, which is the
 * case the "exactly one candidate" rule exists for; and a configuration no descriptor declares, which
 * the resolver has already refused by the time anybody asks this. All three mean the same thing to the
 * caller — nothing here narrows what backend to call.
 *
 * ```eliot
 * val backend = configuredBackend(ArtifactNamed("controller-jvm"), descriptor)
 * ```
 */
def configuredBackend(configuration: Configuration, descriptor: Descriptor): Option[Backend] =
   configuration match {
      case TestScope           -> None
      case ArtifactNamed(name) -> declaredBackend(name, descriptor)
   }

/**
 * The configuration `text` names — `show`'s inverse, and the one place a configuration is read back
 * from the word that spells it.
 *
 * A caller with a word rather than a `Configuration` is a caller reading a command line, and the word
 * it reads is exactly the one `Show` writes: the spelling lives in this module or it drifts between
 * the two halves of it. Nothing is refused, for the reason nothing else here refuses — a name no
 * artifact declares is a resolution failure naming it, and that answer belongs to the resolver.
 *
 * ```eliot
 * val configuration = configurationNamed("controller-jvm")
 * ```
 */
def configurationNamed(text: String): Configuration =
   fold(text == show(TestScope), TestScope, ArtifactNamed(text))

private def artifactDependenciesOf(name: String, descriptor: Descriptor): Option[List[Dependency]] =
   foldOption(
      None,
      found -> Some(descriptor.baseDependencies ++ found.artifactDependencies),
      artifactNamed(name, descriptor)
   )

private def declaredBackend(name: String, descriptor: Descriptor): Option[Backend] =
   foldOption(None, found -> found.artifactBackend, artifactNamed(name, descriptor))

private def artifactNamed(name: String, descriptor: Descriptor): Option[Artifact] =
   descriptor.artifacts.find(artifact -> artifact.artifactName == name)
