import eliot.collection.List
import eliot.file.Path
import eliot.file.File
import eliot.build.model.PackageId
import eliot.build.model.Version
import eliot.build.model.Descriptor
import eliot.build.model.Lineage
import eliot.build.format.PackageFile
import eliot.build.git.Git
import eliot.build.git.Cache
import eliot.build.resolve.PackageSource

/**
 * The git-backed `PackageSource`: where a real build's answers come from.
 *
 * A module of its own for the reason `eliot.build.git.ShellGit` is one — a named implementation is what
 * a run boundary composes, so the two of them are exactly what the launcher imports and what nothing
 * else may. `eliot.build.resolve.Resolution` asks the questions, this answers them out of the mirror
 * cache, and neither module knows about the other.
 */

/**
 * The git-backed source: it asks `Git` about the local mirror and reads what the mirror holds.
 *
 * Its clauses declare what it runs on — `{Git}`, the mirror on disk, and where the mirrors live — and
 * the three ways that can fail: a repository git says no to, a cache directory that cannot be made, a
 * descriptor that will not parse. Those are bound where *this* implementation is bound rather than at
 * every question the resolver asks, and `Git` is bound one step further out again, so nothing here says
 * whether git is a subprocess.
 *
 * **The cache root is asked for, not known.** A named implementation takes no parameters and closes over
 * nothing: what it needs at runtime it asks an effect for, so `{Dep[Path]}` is the ask and the run
 * boundary's `provide` is the answer — the shape `eliot.build.resolve.TablePackages` already uses for its
 * table. It could not be an operand instead: the effect's operations carry what the *resolver* knows,
 * which is a repository and a version and never a directory. It was a constant here until there was a
 * launcher to decide it, and now there is one.
 *
 * Named rather than the default for the reason `eliot.build.git.Git` gives for `shellGit`: a clause row is
 * bound in the scope of the `with` that binds the name, so a test can write
 * `descriptorAt(…) with gitPackages with tableGit` and reach these clauses with a table beneath them,
 * where an anonymous default would bind them to whatever `Git` the platform has — which is none. The
 * launcher's run boundary writes `with gitPackages with shellGit` once, and that is the whole of the
 * tool's composition.
 */
implement gitPackages: PackageSource {
   def descriptorAt(
         version: Version,
         target: Repository
      ): {Git, FileSystem, Dep[Path], Throw[IoError], Throw[GitError], Throw[DescriptorError]} Option[Descriptor] = {
      val published = descriptorTextAt(dependency, version, target)

      foldOption(None, text -> Some(parseDescriptor(split("\n", text))), published)
   }

   def anchorAt(
         line: Line,
         target: Repository
      ): {Git, FileSystem, Dep[Path], Throw[IoError], Throw[GitError]} Option[Commit] =
      anchorOf(dependency, line, target)
}
