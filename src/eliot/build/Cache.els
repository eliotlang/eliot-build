import eliot.collection.List
import eliot.file.Path
import eliot.file.File
import eliot.build.PackageId
import eliot.build.Version
import eliot.build.Git

/**
 * What every question in this module runs on: git, the mirror on disk, and the two ways either can
 * refuse — `GitError` when git said no to a repository, `IoError` when a directory cannot be made.
 *
 * Named because six definitions state it and drift between them would be a silent widening rather
 * than a compile error. Nothing here says `Process`: that is how `shellGit` does its job, declared on
 * that implementation's clauses and charged where it is bound, so a question the cache answers reads the
 * same whether git is a subprocess or a test's table.
 */
type Cached[A] = {Git, FileSystem, Throw[IoError], Throw[GitError]} A


/**
 * The local mirror of every package a build has looked at, and the questions resolution asks of one.
 *
 * A package is a git repository, so the cache is git repositories — bare mirrors under a directory
 * named after the canonical URL. Everything else follows from that: discovering what a package
 * publishes is `ls-remote` against the mirror, reading a descriptor at a version is `git show` out of
 * its object database, and the ancestry check the design owes the fetcher is a third question for the
 * same objects to answer later. Nothing is ever checked out.
 *
 * **What is cached is the repository, not an answer.** No memo of "this URL resolved to that
 * version" is kept, because MVS's answer depends on the whole closure rather than on any one package,
 * and a stale memo of a wrong shape is worse than a second `ls-remote` against a local directory.
 *
 * This module owns *cache policy* — where a mirror lives, whether it has to be made, when it is
 * brought up to date — and `eliot.build.Git` owns git. The row is `{Git, FileSystem}` plus both
 * failure channels: `GitError` when git said no to a repository, `IoError` when a directory cannot be
 * made. Keeping them apart is what lets a caller report "that repository does not exist" differently
 * from "the cache directory cannot be created".
 */

/**
 * Where the mirror of `id` lives under `root`: one directory per canonical URL segment, so
 * `github.com/x/foo` caches at `<root>/github.com/x/foo` and the cache is a thing a human can read
 * with `ls`.
 *
 * The *repository* keys it, not the package: a module selector narrows what gets mounted later and
 * has no bearing on what git fetches, so `…/eliot//stdlib` and `…/eliot//jvm` share one mirror.
 *
 * Known gap, accepted for now: canonical URLs keep their path case — only the host is
 * case-insensitive by specification — so two packages differing only in path case collide on a
 * case-insensitive filesystem. Go escapes uppercase letters to solve this; doing the same needs
 * per-character iteration the standard library does not offer yet.
 */
def cacheDirectory(root: Path, id: PackageId): Path =
   split("/", repository(id).url).foldLeft(root, segment -> directory -> directory / segment)

/**
 * Every version `id` publishes, with the commit each names — the question `eliot get` asks in full
 * and identity asks one line of.
 *
 * Answered from the mirror rather than from the network, so a resolution that revisits a package
 * costs a local process and nothing else. Bringing the mirror up to date is `refreshed`, deliberately
 * a separate act: MVS never needs to know that a newer release exists, and a resolver that refetched
 * on every question would make an offline build impossible for no gain.
 */
def publishedTags(root: Path, id: PackageId): Cached[List[TagRef]] = ensuredMirror(root, id).tags

/**
 * The lineage anchor of `id`'s `majorLine` — the commit its first release names, or nothing where the
 * line has no first release to name one.
 *
 * This is the resolver's `anchorAt`: the question it asks when a requirement names a URL it has not
 * seen, to decide whether that URL is a package already selected under a different spelling.
 */
def anchorOf(root: Path, majorLine: Int, id: PackageId): Cached[Option[Commit]] =
   anchorCommit(majorLine, publishedTags(root, id))

/**
 * What `id`'s descriptor said at `version`, or nothing where the version publishes none.
 *
 * Absence is an ordinary answer here rather than a failure, and both ways of being absent give it: a
 * version nobody tagged and a tag carrying no `eliot.pkg` are equally "there is no descriptor to
 * read", and a resolver that reached either has a dependency line to blame that this module cannot
 * see. `fileAt` reports both the same way, by answering nothing.
 */
def descriptorTextAt(root: Path, version: Version, id: PackageId): Cached[Option[String]] =
   ensuredMirror(root, id).fileAt(AtVersion(version), descriptorFileName)

/**
 * Bring `id`'s mirror up to date with what its remote publishes now, cloning it first if this build
 * has never seen it.
 *
 * The verb that owns the network. Everything else in this module answers from what is already on
 * disk, so this is where "the build fetched something" is a true statement about a program run —
 * which is what lets the project-model query stay offline and lets fetching be something a user
 * invokes rather than something opening an editor does.
 */
def refreshed(root: Path, id: PackageId): Cached[Mirror] = {
   val mirror = ensuredMirror(root, id)

   fetch(mirror)
   mirror
}

/**
 * The descriptor's file name, at the root of every package.
 */
def descriptorFileName: String = "eliot.pkg"

/**
 * The mirror of `id`, cloned if this is the first time the cache has been asked about it.
 *
 * Presence is tested rather than remembered, so two runs of the tool share a cache with no handshake
 * between them. A directory is taken as proof of a finished clone because git removes a clone target
 * it failed to fill — a repository that does not exist leaves nothing behind and the next run simply
 * tries again. The hole that remains is a clone killed outright rather than failing, which leaves a
 * partial mirror that will look present; validating one is work for the fetcher, which has to check
 * ancestry against the objects anyway.
 *
 * Written as an `Option` eliminator rather than as `if(present) mirror else cloned(…)`, which under
 * the carrier model was forced: an `if`'s arms ran under an `Abort` carrier and `Throw` had no lift
 * through one, so the cloning arm could not raise. Under effects v6 that constraint is gone — `if`'s
 * `{Abort}` slot supplies `Abort` alone and the arms ride the caller's `Throw` — and this now reads
 * the way it does by preference rather than by necessity.
 */
private def ensuredMirror(root: Path, id: PackageId): Cached[Mirror] = {
   val directory = cacheDirectory(root, id)
   val absent = missingMirror(isDirectory(directory), directory)

   foldOption(Mirror(directory), missing -> cloned(root, missing, id), absent)
}

private def missingMirror(present: Bool, directory: Path): Option[Path] = fold(present, None, Some(directory))

/**
 * Only the root is created up front. Git makes the leading directories of a clone target itself, so
 * the per-package chain needs no help; the root is made anyway to state that the cache is a directory
 * this tool owns rather than one that appears as a side effect of the first fetch.
 */
private def cloned(root: Path, directory: Path, id: PackageId): Cached[Mirror] = {
   createDirectories(root)
   cloneMirror(remoteOf(repository(id).url), directory)
}
