import eliot.collection.List
import eliot.build.model.PackageId
import eliot.build.model.Version
import eliot.build.model.Descriptor
import eliot.build.assets.Assets
import eliot.build.resolve.PackageSource
import eliot.build.resolve.Configuration
import eliot.build.resolve.Selection
import eliot.build.resolve.Resolution

/**
 * What a resolution says to *run* with: the compiler a build uses, the backend it calls, and every
 * plugin binary that has to be on disk before either happens.
 *
 * This is `eliot.build.assemble.Assembly`'s other half. A resolution is a set of versions; assembly
 * turns it into the directories a compiler is pointed at, and this turns it into the compiler that is
 * pointed at them. Both read the same closure and neither knows how a version got there, which is why
 * they are one package and why both run on `{PackageSource}` alone.
 *
 * **The toolchain is discovered, never configured.** There is no toolchain directive anywhere in this
 * system: a package requiring a newer eliot raises the minimum, MVS unifies it, and the tag that wins
 * is the tag whose assets these are. So finding the compiler is reading the `plugin` clauses of the
 * packages the closure already mounted — the one marked `compiler` holds it, one with a `backend` word
 * answers to that word, and the rest are always-on contributors that simply come along.
 *
 * **The entry point is discovered the same way**, and that is what Q4 became. A suite's `main` lives in
 * the test framework and an application's in the application, which used to be an asymmetry the test
 * verb papered over with a hard-coded constant; both are now a `main` clause on a package, read off one
 * closure by one rule. The project's own opened packages are searched alongside the dependencies'
 * precisely because the two are not different kinds of thing.
 *
 * **Every refusal here is about a graph rather than a file.** Two packages claiming `compiler`, or two
 * declaring a `main`, is not something a descriptor reader can catch — each descriptor is read alone
 * and the conflict exists only across a resolution — so they are raised here, which is where the whole
 * closure is in view for the first time. That is `docs/build-system.md`'s Q3 and Q4 answered by
 * construction.
 */

/**
 * Why a resolution does not describe something runnable. Each names the package or the assets it is
 * about, because a toolchain a user cannot attribute to a dependency line is one they cannot fix.
 */
data ToolchainError =
   NoCompiler(compilerlessPackage: PackageName) |
   TwoCompilers(oneCompiler: Asset, otherCompiler: Asset) |
   NoBackend(backendlessPackage: PackageName) |
   TwoBackends(oneBackend: Asset, otherBackend: Asset) |
   NoMain(mainlessPackage: PackageName) |
   TwoMains(oneMain: String, otherMain: String)

implement Show[ToolchainError] {
   def show(value: ToolchainError): String = value match {
      case NoCompiler(name) ->
         "nothing '" ++ show(name) ++ "' depends on ships a compiler"
      case TwoCompilers(one, other) ->
         "both " ++ show(one) ++ " and " ++ show(other) ++ " claim to be the compiler"
      case NoBackend(name) ->
         "nothing '" ++ show(name) ++ "' depends on ships a backend"
      case TwoBackends(one, other) ->
         "both " ++ show(one) ++ " and " ++ show(other) ++ " ship a backend, so one has to be named"
      case NoMain(name) ->
         "nothing in '" ++ show(name) ++ "' declares a main, so there is nothing to run"
      case TwoMains(one, other) ->
         "both " ++ one ++ " and " ++ other ++ " are declared as a main, so there is no one entry point"
   }
}

/**
 * One plugin a selected package ships, and the asset it is published as — the pair every question here
 * is asked of, since the clause says what a plugin *is* and only the selection says where it comes
 * from.
 */
data Shipped(shippedAsset: Asset, shippedPlugin: Plugin)

/**
 * A backend candidate: an asset, and the command word it answers to. A record rather than the plugin it
 * came from, because a candidate is exactly a plugin that *has* a word — so the word is a field here
 * and the absence has already been dealt with.
 */
data Backing(backingAsset: Asset, backingWord: String)

/**
 * A toolchain: the asset holding the compiler, the command word the backend answers to, and every
 * asset the closure ships — the compiler's own among them.
 *
 * The assets are kept as one list rather than split into "the compiler's" and "the others" because
 * what a launcher does with them today is one flat classpath. `docs/build-system.md`'s Q2 decided the
 * eventual shape is a parent loader on the compiler asset with a child per plugin, and `compilerAsset`
 * is exactly the fact that split needs; until then it says which asset `Main` is in.
 */
data Toolchain(compilerAsset: Asset, backendWord: String, toolchainAssets: List[Asset], toolchainMain: String)

/**
 * What building `name` runs with, given what it resolved to.
 *
 * The resolution is passed in rather than computed, because a build wants the roots and the toolchain
 * of *one* closure — resolving twice would be two closures that merely ought to agree.
 *
 * ```eliot
 * val toolchain = toolchainOf(name, descriptor, resolve(name, descriptor))
 * ```
 */
def toolchainOf(
      name: PackageName,
      descriptor: Descriptor,
      resolution: Resolution
   ): {PackageSource, Throw[ResolutionError], Throw[ToolchainError]} Toolchain = {
   val shipped = resolution.selections.flatMap(shippedBy)
   val mains = declaredMains(name, descriptor) ++ resolution.selections.flatMap(mainsIn)

   Toolchain(
      sole(
         NoCompiler(name),
         one -> other -> TwoCompilers(one, other),
         entry -> entry.shippedAsset,
         compilersIn(shipped)
      ).shippedAsset,
      sole(
         NoBackend(name),
         one -> other -> TwoBackends(one, other),
         candidate -> candidate.backingAsset,
         backendsIn(shipped)
      ).backingWord,
      shipped.map(entry -> entry.shippedAsset),
      soleMain(name, mains)
   )
}

/**
 * The `main` clauses of the project's *own* packages that this build opens — its executable's, when an
 * executable is what was asked for, and none when a suite was, since a suite's entry point is the
 * framework's.
 */
private def declaredMains(name: PackageName, descriptor: Descriptor): List[String] =
   foldOption(
      empty,
      opened -> opened.flatMap(built -> mainOf(built)),
      configuredPackages(name, descriptor)
   )

/**
 * The `main` clauses of the packages one selected dependency mounts — where a suite's comes from, the
 * framework having declared its own runner about itself.
 */
private def mainsIn(selection: Selection): {PackageSource, Throw[ResolutionError]} List[String] =
   foldOption(
      raise(Unavailable(selection.selectedRepository, selection.selectedVersion)),
      descriptor -> mountedPackages(selection, descriptor).flatMap(built -> mainOf(built)),
      descriptorAt(selection.selectedVersion, selection.selectedRepository)
   )

private def mainOf(built: BuildPackage): List[String] =
   foldOption(empty, module -> singleton(module), built.packageMain)

/**
 * The one entry point in the closure, or which two made it a question.
 *
 * Two is a real conflict rather than a thing to prefer between: a build produces one executable, and
 * picking the nearer declaration would make what runs depend on how the graph happened to be shaped.
 * It is also why an executable is its own package — were a library's `main` in the same package as its
 * sources, every suite testing that library would inherit it alongside the framework's.
 */
private def soleMain(name: PackageName, mains: List[String]): {Throw[ToolchainError]} String =
   foldOption(
      raise(NoMain(name)),
      only -> foldOption(only, second -> raise(TwoMains(only, second)), mains.at(1)),
      mains.head
   )

/**
 * Every plugin one selected repository ships, paired with the asset it is published as.
 *
 * Of the packages the closure *mounted*, and only those: a plugin is a package's, so a package nobody
 * selected ships nothing into this build, exactly as it contributes no sources. A selected version
 * whose descriptor cannot be read back is `Unavailable` — the resolver's own error, the same fact
 * under a different verb, which is what `eliot.build.assemble.Assembly` says about the same read.
 */
private def shippedBy(selection: Selection): {PackageSource, Throw[ResolutionError]} List[Shipped] =
   foldOption(
      raise(Unavailable(selection.selectedRepository, selection.selectedVersion)),
      descriptor -> declaredBy(selection, descriptor),
      descriptorAt(selection.selectedVersion, selection.selectedRepository)
   )

private def declaredBy(selection: Selection, descriptor: Descriptor): List[Shipped] =
   mountedPackages(selection, descriptor)
      .flatMap(built -> built.packagePlugins.map(plugin -> Shipped(assetOf(selection, plugin), plugin)))

private def mountedPackages(selection: Selection, descriptor: Descriptor): List[BuildPackage] =
   descriptor.packages.filter(built -> built.exported && mounts(built.packageName, selection))

private def assetOf(selection: Selection, plugin: Plugin): Asset =
   Asset(selection.selectedRepository, selection.selectedVersion, plugin.pluginAsset)

private def compilersIn(shipped: List[Shipped]): List[Shipped] =
   shipped.filter(entry -> entry.shippedPlugin.compilerBase)

/**
 * The backend candidates, as the asset and the word it answers to.
 *
 * A plugin *is* a candidate exactly when it declares a word, which is the whole of Q1's decision: the
 * provider says what it answers to, so `lang` and `stdlib` stop counting and the "exactly one
 * candidate" rule becomes true. Nothing filters them by anything a consumer wrote, because a consumer
 * writes nothing about backends any more — a closure holding two of them holds two platform layers,
 * which would collide on every name they implement, so it is a conflict to report rather than a choice
 * to offer.
 */
private def backendsIn(shipped: List[Shipped]): List[Backing] = shipped.flatMap(candidateOf)

/**
 * One candidate, or none — a plugin that declares no word is not a backend, which is the whole of what
 * the word's absence means.
 */
private def candidateOf(entry: Shipped): List[Backing] =
   foldOption(
      noCandidate,
      word -> singleton(Backing(entry.shippedAsset, word)),
      entry.shippedPlugin.pluginBackend
   )

private def noCandidate: List[Backing] = empty

/**
 * The one candidate, or which two of them made it a question.
 *
 * Reading the second element rather than counting, because the report a user needs is *which* two
 * collided and a size says neither of them.
 */
private def sole[A](
   absent: ToolchainError,
   ambiguous: Asset => Asset => ToolchainError,
   assetOf: A => Asset,
   candidates: List[A]
): {Throw[ToolchainError]} A =
   foldOption(raise(absent), only -> settled(ambiguous, assetOf, only, candidates), candidates.head)

private def settled[A](
   ambiguous: Asset => Asset => ToolchainError,
   assetOf: A => Asset,
   only: A,
   candidates: List[A]
): {Throw[ToolchainError]} A =
   foldOption(only, second -> raise(ambiguous(assetOf(only))(assetOf(second))), candidates.at(1))
