import eliot.collection.List
import eliot.file.Path
import eliot.build.model.PackageId
import eliot.build.model.Version
import eliot.build.model.Descriptor
import eliot.build.model.Lineage
import eliot.build.model.Lock
import eliot.build.resolve.PackageSource
import eliot.build.resolve.Configuration
import eliot.build.resolve.Selection
import eliot.build.resolve.Resolution

/**
 * What a resolution becomes: the source roots one build is compiled from.
 *
 * This is the step between "which versions" and "a build". A resolution is a set of versions and the
 * packages of each that the closure reached; a compiler mounts *directories*. Turning one into the
 * other is two facts and nothing else — where a repository's tree is (the source answers that, by
 * checking the locked commit out), and where inside it the standard layout puts a package's sources.
 * Neither is a decision this module makes up: the first belongs to whoever holds the cache, and the
 * second is `docs/build-system.md`'s conventional layout, which is the whole reason `src/` and
 * `compiler/` are named rather than configured.
 *
 * **The layout, as one rule.** A package's sources are `<package root>/src`, always — for the project
 * and for a dependency, for a suite and for a library. The rule used to have three clauses, because
 * `test/` was a conventional directory that activated for one configuration and never shipped; it is
 * an ordinary package now, so *when does it compile* is *is it in the closure* and the special case
 * is gone with the scope that needed it.
 *
 * **`compiler/` is not listed**, and that has not changed: the compile-time overlay is each source
 * root's own sibling, which is the compiler's rule about a root rather than a second root the
 * assembler could invent, and a second listing of it here would be a place for the two to disagree.
 * Moving the overlay under the package root kept that property exactly — `<package root>/compiler` is
 * the sibling of `<package root>/src`.
 *
 * **What is mounted is what was locked.** A tree is asked for by the commit `eliot.build.assemble.Locking`
 * read and `eliot.lock` was checked against — those commits are taken, never asked for again — so no tag
 * is looked up between the check and the checkout, and a tag that moved in between cannot put an
 * unchecked tree on the compiler's path.
 *
 * **It runs on `{PackageSource}` and names no git.** The same effect that answers the resolver's
 * questions answers this one, so nothing here knows whether a tree arrived by clone, by checkout or
 * by a test's table — exactly as `eliot.build.resolve.Resolution` does not know how a descriptor was
 * read. The failure channel is the resolver's too: a selected version whose descriptor cannot be read
 * a second time is `Unavailable`, the same fact under a different verb.
 */

/**
 * The project being built: where it is, and what its descriptor says.
 *
 * It is not a `Selection` and never appears in one — a resolution selects *dependencies*, and the
 * project has no version to select, no URL that matters and no tree to check out. Which of its own
 * packages are in the build is not a dependency line's answer either: it is whichever one was asked
 * for, plus the siblings that one reaches, which `eliot.build.resolve.Configuration` works out.
 */
data Project(projectDirectory: Path, projectDescriptor: Descriptor)

/**
 * Every source root building `name` compiles from, against the closure `resolution` already is and at
 * the commits `pinned` locked it to: the project's own packages first, then one per package of each
 * selected dependency, in the resolution's canonical order.
 *
 * The project first because that is the order a reader expects and the order a command line reads
 * best; within the dependencies, the resolution's own order, so two runs of one graph assemble the
 * same list in the same order and a diff of it means something changed. The closure is taken rather
 * than made, because the launcher reads the invocation off the same one — resolving twice would be two
 * closures that merely ought to agree.
 *
 * ```eliot
 * val roots = rootsOf(PackageName("test"), Project(here, descriptor), resolution, entry.lockedVersions)
 * ```
 */
def rootsOf(
   name: PackageName,
   project: Project,
   resolution: Resolution,
   pinned: List[LockedVersion]
) uses PackageSource, Throw[ResolutionError]: List[Path] =
   projectRoots(name, project) ++ resolution.selections.flatMap(mountedRoots(pinned))

/**
 * The roots the project contributes: the sources of every package building `name` opens.
 *
 * Not every package it declares. A repository's other executables are not in this build and neither
 * are their platform layers, which is the whole of why they are packages — and the suite is in it
 * exactly when it is what was asked for. A name the descriptor does not declare opens nothing here
 * and is refused by the resolver, which is the caller that holds the error.
 */
def projectRoots(name: PackageName, project: Project): List[Path] =
   (configuredPackages(name, project.projectDescriptor) orElse empty).map(built ->
      sourcesOf(project.projectDirectory, built)
   )

/**
 * The roots one selected dependency contributes, under the tree its locked commit is checked out into:
 * the sources of each package the closure reached, and nothing else.
 *
 * A selection `pinned` has no commit for is `Unavailable`, as one whose descriptor cannot be read back
 * is: both are a version the closure selected and this step cannot find again, and for pins read off the
 * same resolution neither can happen.
 */
def mountedRoots(pinned: List[LockedVersion], selection: Selection) uses PackageSource, Throw[ResolutionError]: List[Path] = {
   val unavailable = Unavailable(selection.selectedRepository, selection.selectedVersion)
   val commit = lockedCommitOf(selection, pinned) orElse raise(unavailable)
   val tree = sourcesAt(commit, selection.selectedRepository)
   val descriptor = descriptorAt(selection.selectedVersion, selection.selectedRepository) orElse raise(unavailable)

   mountedPackages(selection, descriptor).map(built -> sourcesOf(tree, built))
}

/**
 * The source root `name` itself declares in the project — not its siblings' — absent where the project
 * declares no such package.
 *
 * `projectRoots` answers what a build of `name` compiles from, which includes every sibling it reaches;
 * this answers which of those roots is *its own*, which is what an editor needs to know about a file:
 * the package it belongs to.
 */
def ownRootOf(name: PackageName, project: Project): Option[Path] =
   packageNamed(name, project.projectDescriptor).mapOption(built -> sourcesOf(project.projectDirectory, built))

/**
 * The packages `selection` mounts of a dependency laid out by `descriptor`.
 *
 * A selector naming a package the descriptor does not declare mounts nothing — and a bare `dep` on a
 * repository of packages in subdirectories, which declares no root package, is that case. It is worth
 * a diagnostic at the *author's* build rather than a silent empty mount, and not worth a failure here,
 * where the only honest report would name a dependency line this module has never seen.
 */
private def mountedPackages(selection: Selection, descriptor: Descriptor): List[BuildPackage] =
   descriptor.packages.filter(built -> built.exported && mounts(built.packageName, selection))

/**
 * The commit `pinned` locked `selection` at, absent where it locked no such repository at that version.
 */
private def lockedCommitOf(selection: Selection, pinned: List[LockedVersion]): Option[Commit] =
   pinned.find(locked -> pins(selection, locked)).mapOption(lockedCommit)

/**
 * `true` when `locked` is the lock line of `selection`: the same repository at the same version.
 */
private def pins(selection: Selection, locked: LockedVersion): Bool =
   locked.lockedRepository == selection.selectedRepository && locked.lockedVersion == selection.selectedVersion

/**
 * Where a package's sources are: `src` under its root directory, which is the whole of the layout.
 */
private def sourcesOf(root: Path, built: BuildPackage): Path = under(root, built.packageRoot) / "src"

/**
 * A package root is written in the *repository's* path syntax — `lang/eliot`, one string with
 * separators in it — and is resolved a segment at a time, because `/` extends a path by one segment by
 * contract. An `at .` names the tree it is already standing in, so it contributes no segment at all.
 */
private def under(root: Path, directory: String): Path =
   split("/", directory)
      .filter(segment -> segment != "." && segment != "")
      .foldLeft(root, segment -> at -> at / segment)
