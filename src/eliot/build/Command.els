import eliot.collection.List
import eliot.file.Path
import eliot.system.Process
import eliot.build.format.PackageFile
import eliot.build.model.PackageId
import eliot.build.model.Version
import eliot.build.model.Lineage

/**
 * What the tool was asked for, and what it says back.
 *
 * A module of its own because none of it is the tool *running*: reading a command line and spelling
 * the compiler's are decisions about text, true whether or not anything is cloned, so they are
 * testable without a platform beneath them while `eliot.build.Launcher` — which is the boundary, and
 * is where the implementations are bound — can never be. That is the same cut
 * `eliot.build.format.DescriptorWriter` makes against the parser, for the same reason, and the import
 * list is the argument here too: this knows what a package name, a version and a commit are, and
 * nothing about git, the filesystem or a subprocess.
 *
 * **There are no verbs.** `eliot <package>` runs every `compiler` line in the package's closure, and
 * what that *does* — compile, run a suite, flash a board, render the docs — is the line's to say, so a
 * word in front of the package could only ever have been a name for "do it". `resolve` and `roots`,
 * the two questions the tool used to answer, went with `build`: they were queries about a closure, and
 * the query a closure is actually asked by something other than a person is the IDE's project model
 * (`docs/build-system.md`, "IDE integration"), which is a machine-facing interface of its own rather
 * than a verb beside a package name. The other option, `--release`, is not about a closure at all: it
 * tags the project's own commit, and builds nothing.
 *
 * **`eliot.system.Process` is imported for two pure list builders and nothing else.** A command line
 * is text — `command("java").withArgument("-cp")` is the spelling this project already uses for one —
 * and assembling the compiler's is exactly the kind of decision that belongs here rather than at a
 * boundary that cannot be tested. Nothing in this module performs the effect; the launcher spawns
 * what this module wrote.
 */

/**
 * The package `commandLine` names, absent where it names anything else.
 *
 * Absent covers a missing name, a spare argument and a word starting `-` alike: a tool that read past
 * an argument it did not understand would act on something the user did not name, and a leading dash
 * is kept free so that an option can arrive later without first being mistaken for a package. What
 * is *not* refused here is a package no descriptor declares: that is a fact about a descriptor this
 * function has not seen, and `unknownPackage` is what the launcher answers once it has read one.
 *
 * The one thing that may follow the name is `--`, and everything after it is `forwarded`'s, not this
 * function's: `eliot test -- eliot.build.resolve` names `test`.
 *
 * ```eliot
 * val name = requested(singleton("controller-jvm"))
 * ```
 */
def requested(commandLine: List[String]): Option[PackageName] = {
   val named = at(0, commandLine) orElse ""
   val alone = size(commandLine) == 1 || separatedAfterName(commandLine)

   someIf(alone && named != "" && !startsWith("-", named)) PackageName(named)
}

/**
 * The words after the `--` that follows the package name, verbatim — for the program a line runs, not
 * for the tool.
 *
 * **The tool reads none of them.** A second `--`, a word starting `-`, a word that looks like a package:
 * each is passed on as written, because what they mean is the program's business — a test runner reads
 * suite names, an application its own arguments — and a word the tool interpreted on the way would be a
 * word the program never saw. Only the first `--` separates; the compiler cuts its own command line at
 * the first `--` in the same way, which is what lets the words travel through it untouched.
 *
 * Nothing where the command line has no `--` right after the name, and nothing where it has one with
 * nothing after it: forwarding no words and forwarding none at all are the same request.
 *
 * ```eliot
 * val words = forwarded(split(" ", "test -- eliot.build.resolve"))   // eliot.build.resolve
 * ```
 */
def forwarded(commandLine: List[String]): List[String] =
   if(separatedAfterName(commandLine)) commandLine.tail.tail else empty

/**
 * The word that ends the tool's command line and starts the program's, spelled once.
 */
def argumentSeparator: String = "--"

/**
 * `true` where the command line asks for the project model — `--project-model` and nothing else.
 *
 * The first of the tool's two options, and an option rather than a package name because it is not a
 * build: it answers what every package resolves to, for an editor, and runs nothing
 * (`docs/build-system.md`, "IDE integration"). The leading dash `requested` keeps free is what lets it
 * arrive without being read as a package.
 *
 * ```eliot
 * val modelling = modelRequested(singleton(projectModelOption))
 * ```
 */
def modelRequested(commandLine: List[String]): Bool = {
   val named = at(0, commandLine) orElse ""

   size(commandLine) == 1 && named == projectModelOption
}

/**
 * The option that asks for the project model, spelled once.
 */
def projectModelOption: String = "--project-model"

/**
 * A command line asking for a release: of the version it names, or of the next one where it names none.
 */
data ReleaseRequest(requestedVersion: Option[Version])

/**
 * The release the command line asks for — `--release`, optionally followed by a version — absent where
 * it asks for anything else.
 *
 * The second option, and an option for the reason the first is one: it builds nothing. A word after it
 * that is not a version makes the whole line ask for nothing, so the user gets the usage rather than a
 * release of something they did not type.
 *
 * ```eliot
 * val release = releaseRequested(append(singleton(releaseOption), "v1.0"))
 * ```
 */
def releaseRequested(commandLine: List[String]): Option[ReleaseRequest] = runAbort(releaseOf(commandLine))

/**
 * The option that asks for a release, spelled once.
 */
def releaseOption: String = "--release"

/**
 * What a release says once its tag is pushed: the version, which is also what a consumer writes as the
 * minimum in a `dep` line, and the commit it names, which is what their `eliot.lock` will record.
 *
 * Taken as the two values rather than as git's `TagRef`, so this module still names nothing of git.
 */
def releaseReport(version: Version, commit: Commit): List[String] =
   singleton("eliot: released " ++ show(version) ++ " at " ++ show(commit))

/**
 * Everything one run of the compiler needs, as values: the JVM to run it on, the directories its
 * plugins were unpacked into, the words of the `compiler` line being run, the source roots, where
 * the result goes, and the words the command line forwarded to the program.
 *
 * A record rather than six arguments, because every field here is decided somewhere else — the
 * closure says the line and the assets, the resolution says the roots, the launcher says the JVM — and
 * a record is what lets each of them be filled in by whoever knows it and read back by a test.
 */
data Compilation(
   javaCommand: String,
   toolchainClasspath: List[Path],
   compilerArguments: List[String],
   compiledRoots: List[Path],
   outputDirectory: Path,
   forwardedArguments: List[String]
)

/**
 * The compiler, spelled as a command line: the launcher's part around the line's part.
 *
 * **The line goes first and is not looked at.** Its words are the package's — `run -m
 * eliot.test.Runner`, `exe-jar -m eliot.build.Launcher` — and a mode opens a subcommand scope that the
 * first positional argument closes, so the roots come after every word of the line and `-o` trails.
 * Nothing in a line is a placeholder: the launcher owns the invocation end to end, and the line is only
 * the part of it that varies (`docs/build-system.md`, "What a build runs").
 *
 * **`--progress` is the launcher's, and always there.** How far along a build is and how long it has
 * left is a question about the run, never about what a package asked the run to do, so no line says
 * it and no line can take it away. The compiler writes those lines to stderr, append-only, and picks
 * their decoration itself — colour on a terminal, the time of day in a log — so there is nothing for
 * the launcher to decide about where the build is running; stdout stays the `run` mode's program's.
 * It trails with `-o`, where the compiler's own options are read once the roots have closed the mode.
 *
 * **Forwarded words come last, after a `--` of the launcher's own.** The compiler cuts its command line
 * at the first `--` before it parses anything and hands the rest to the program its `run` mode starts,
 * so nothing a user forwards can be read as a root or an option of the compiler's. Every line in the
 * closure gets the same words: the tool does not know which line runs a program, and a line whose mode
 * runs none — `exe-jar` — refuses them, which fails the build rather than dropping words the user meant.
 * No words, no `--`.
 *
 * ```eliot
 * val line = compilerCommand(Compilation("java", plugins, split(" ", "run -m Main"), roots, target, empty))
 * ```
 */
def compilerCommand(compilation: Compilation): List[String] =
   (command(compilation.javaCommand)
      .withArgument("-cp").withArgument(classpathOf(compilation.toolchainClasspath))
      .withArgument(compilerMainClass)) ++
      compilation.compilerArguments ++
      compilation.compiledRoots.map(show) ++
      (command("--progress").withArgument("-o").withArgument(show(compilation.outputDirectory))) ++
      separated(compilation.forwardedArguments)

/**
 * The compiler's entry point, by name.
 *
 * Transitional, and named here rather than discovered: nothing says which asset holds the compiler or
 * which class in it to run, because until the compiler is self-hosted there is exactly one compiler and
 * this is what it is called. When plugins become Eliot source in ordinary packages, this
 * constant retires with the rest of the mechanism.
 */
def compilerMainClass: String = "com.vanillasource.eliot.eliotc.compiler.Main"

/**
 * A classpath the JVM expands itself: one wildcard entry per unpacked asset, so an asset's jars are
 * named by the directory they are in rather than listed one by one.
 *
 * The separator is `:`, which is POSIX's. This tool spawns rather than shells out, so nothing expands
 * the `*` on the way — the JVM reads it — but the separator is still a platform's and this is the one
 * place it is written.
 */
def classpathOf(directories: List[Path]): String =
   directories.map(directory -> show(directory) ++ "/*").joined(":")

/**
 * One line for one failure, attributed to what could not be done.
 *
 * Nothing here abbreviates the problem: each error type renders itself and each names the package or
 * the command it is about, because a failure a user cannot attribute to something they wrote is a
 * failure they cannot fix.
 */
def failed(doing: String, problem: String): List[String] = singleton("eliot: " ++ doing ++ ": " ++ problem)

/**
 * How to invoke the tool: what the one argument is, what naming it does, and — where the descriptor
 * could be read — which packages there are to name.
 *
 * **The names are the descriptor's, never examples.** No package name is special, so a usage that
 * suggested `root` or `test` would be suggesting names this project may not have — and in this
 * repository `root` is declared and runs nothing. The only list that is right is the one the file in
 * the working directory makes, so a command line naming nothing, or naming a package the file does not
 * declare, answers with exactly that list. Names only, in declaration order: whether a package runs
 * anything is a fact about its closure, and asking would turn a usage into a resolution.
 *
 * `None` is a descriptor that could not be read, whose failure the caller has already reported; the
 * usage then says what the argument is and lists nothing, rather than an empty list that would read
 * as a file declaring no packages.
 *
 * ```eliot
 * val lines = usage(Some(descriptor.packages.map(packageName)))
 * ```
 */
def usage(declared: Option[List[PackageName]]): List[String] =
   singleton("usage: eliot <package> [-- <argument>...]") ++
      singleton("   runs every compiler line in the package's closure over the package's sources") ++
      singleton("   and passes the arguments after -- to the program a line runs") ++
      singleton("usage: eliot " ++ projectModelOption) ++
      singleton("   prints what every package resolves to, as JSON, from what is already fetched") ++
      singleton("usage: eliot " ++ releaseOption ++ " [<version>]") ++
      singleton("   tags the pushed commit checked out as the next release, or as <version>, and pushes the tag") ++
      (declared.mapOption(listed) orElse empty)

/**
 * A command line naming a package the descriptor does not declare: that, and then the usage listing
 * what it does declare.
 *
 * Refused here rather than by the resolver, because the resolver's `NoSuchPackage` is about whatever
 * descriptor it was handed and cannot say what the user could have typed instead; this knows it is the
 * project's own file.
 */
def unknownPackage(name: PackageName, declared: List[PackageName]): List[String] =
   failed("no package named '" ++ show(name) ++ "'", "not declared in " ++ descriptorFileName) ++
      usage(Some(declared))

/**
 * `releaseRequested`'s reading, aborting on anything but the option and at most one version after it.
 */
private def releaseOf(commandLine: List[String]) uses Abort: ReleaseRequest = {
   val version = at(1, commandLine).mapOption(parseVersion)

   if((at(0, commandLine) orElse "") == releaseOption && size(commandLine) <= 2) ReleaseRequest(version)
}

/**
 * The packages a descriptor declares, one per line under a heading naming the file, or the one line
 * saying there are none.
 */
private def listed(declared: List[PackageName]): List[String] =
   if(isEmpty(declared)) singleton(descriptorFileName ++ " declares no packages")
   else singleton("packages in " ++ descriptorFileName ++ ":") ++ declared.map(name -> "   " ++ show(name))

/**
 * `true` where the word after the package name is the separator.
 */
private def separatedAfterName(commandLine: List[String]): Bool = (at(1, commandLine) orElse "") == argumentSeparator

/**
 * `words` behind the separator, or nothing where there are none.
 */
private def separated(words: List[String]): List[String] =
   if(isEmpty(words)) empty else prepend(words, argumentSeparator)
