import eliot.collection.List
import eliot.file.Path
import eliot.build.model.PackageId
import eliot.build.model.Version
import eliot.build.model.Lineage
import eliot.build.git.Tags

/**
 * Talking to git: the operations the tool performs on a repository, as an effect, and the vocabulary
 * they are said in.
 *
 * There is no embedded git library and there will not be one: the tool shells out to the `git` the
 * user already has, which is Go's original choice and the reason process spawning is the launcher's
 * load-bearing capability. That is `eliot.build.git.ShellGit`'s business, though, and nobody else's — a
 * module of its own, so that the separation is one the *imports* state rather than one the signatures
 * merely promise: nothing here names `eliot.system.Process`. `Git`'s members say what an operation
 * means and which refusal it raises, and `{Process}` and `{Throw[IoError]}` appear only on the clauses
 * of the implementation that spawns, charged where it is bound. A caller declares `{Git}` and says
 * nothing about subprocesses — exactly as it declares `{Console}` and says nothing about file
 * descriptors — and a test of a caller binds a double for `Git` rather than scripting what
 * `ls-remote` would print. What an operation *answers* is read by `eliot.build.git.Tags` — which refs
 * count, which commit a tag ultimately names, what a version tag even looks like — and that module is
 * imported by this one rather than the other way round, so the reading of git's output owes nothing to
 * the effect that fetched it.
 *
 * **The vocabulary is git's own.** A *mirror* is a `git clone --mirror`: a bare repository — object
 * database and refs, no working tree — whose refs are an exact copy of the remote's. Every *question*
 * is answered out of a mirror's object database and nothing is checked out to ask one. A *worktree* is
 * the exception, and it is not a question: the compiler mounts directories rather than reading files
 * one at a time, so a build that has resolved its versions must put one tree on disk per selected
 * version. `git worktree` is what does it — a second working tree of the mirror that already holds the
 * objects, so a checkout costs a tree and not a second copy of the history. A *remote* is the address
 * git is given to reach a repository. A *commit* — `eliot.build.model.Lineage`'s, because a content
 * hash is vocabulary before it is git's — is what a tag names. A file is read at a *version*, which git
 * is asked for by the tag it was published as; a tree is checked out at a *commit*, because a tree is
 * what a build compiles and a lockfile pins, and a tag is a ref that can move. `fetch` brings a mirror up to date
 * and touches no working tree; `pull` would merge into a branch and has no meaning in a mirror. A
 * *checkout* is the one repository this tool did not make: the project's own, cloned by whoever is
 * working in it, and the only one it ever writes a ref into — the tag a release is.
 *
 * **Every operation's subject says where it runs.** Git resolves a relative path against *its* working
 * directory, not this program's, and the split is git's own: a command that *names* a repository —
 * by remote or by mirror directory — must run where this program stands, while one that operates on
 * the repository it is standing in runs inside the mirror and names nothing. Getting it backwards is
 * silent — git reports a missing repository — so `shellGit` decides the frame from the subject's
 * type, and no caller says a working directory. Naming the subjects apart is what lets it: a `Remote`
 * and a `Mirror` are different types precisely so the rule can be read off an argument.
 *
 * Failure has two channels and they are different reports to a user: `GitError` is this module's,
 * raised when git ran fine and *said no*, and `IoError` is the standard library's, raised when a
 * program cannot be started at all. Only the first is part of what an operation *means* — any
 * implementation, a double included, may be asked about a repository that is not there — so only the
 * first is on the members. The second is how the shell implementation fails, and stays on its clauses.
 */

/**
 * A git command that ran and failed — as distinct from a git that could not be run at all, which is
 * the standard library's `IoError`.
 *
 * The command is carried whole rather than summarised. A build tool that shells out is a build tool
 * whose errors are somebody else's, and the only useful thing to say about one is exactly what was
 * run and exactly what it said back, so the user can run it themselves.
 */
data GitError(failedCommand: String, failedExitCode: Int, failedDiagnostics: String)

implement Show[GitError] {
   def show(value: GitError): String =
      "'" ++ value.failedCommand ++ "' failed with exit code " ++ show(value.failedExitCode) ++
         ": " ++ value.failedDiagnostics
}

/**
 * A mirror on disk — a bare, exact copy of a remote, known by the directory it lives in. Made by
 * `cloneMirror` and by nothing else; a `Mirror` in hand says that a clone finished there once.
 */
data Mirror(mirrorDirectory: Path)

/**
 * A working tree checked out of a mirror at one revision, known by the directory it lives in — what a
 * source root is, and the only thing in this module that has files in it.
 *
 * Its own type rather than a bare `Path` for the reason `Mirror` is: the two are different things git
 * does different work on, and a signature that took a `Path` could be handed either. Made by
 * `addWorktree` and by nothing else.
 */
data Worktree(worktreeDirectory: Path)

/**
 * The project's own repository, as somebody cloned it and works in it — known by the directory it is
 * checked out in.
 *
 * Neither a `Mirror` nor a `Worktree`, because this tool made neither of the things those are: it did
 * not clone it, it decides nothing about where it lives, and it asks it different questions — what is
 * not committed yet, what is not pushed yet, what its `origin` has published. It is also the only
 * repository the tool writes to, and only ever one ref: the tag that publishes a release.
 */
data Checkout(checkoutDirectory: Path)

/**
 * The address git is given to reach a repository — a transport URL, scheme included, which is what a
 * canonical package URL deliberately is not. Made by `remoteOf`, the one place the scheme is decided.
 */
data Remote(remoteUrl: String)

/**
 * What the tool asks of git, and nothing about how it is carried out: `shellGit` spawns `git`, a test's
 * double answers from a table, and a caller declaring `{Git}` cannot tell them apart.
 *
 * Two groups, told apart by their subjects. Five operations are about somebody else's repository, a
 * mirror of it and the trees checked out of that — what a build reads and mounts. Seven are about the
 * project's own `Checkout`, and they are what a release is made of: five questions that decide whether
 * the commit checked out may be published and under which tag, and two that publish it. Each is one git
 * command, so each refuses on its own and a double answers each from one entry.
 *
 * The members carry `Throw[GitError]` where the operation can be refused, because a refusal is part of
 * what the operation means and a caller may want to handle one per call. `fileAt` carries none: it is
 * the one operation that *reads* a refusal rather than raising it.
 */
effect Git {
   /**
    * Mirror `remote` at `target` — the whole repository, no working tree — and answer the mirror.
    *
    * A mirror rather than a checkout because nothing here wants files on disk: a descriptor is read out
    * of the object database with `fileAt`, and the ancestry check the design owes reads objects too. A
    * working tree would be a second copy of every source file per package, checked out at one version at
    * a time, for no question anybody asks.
    */
   def cloneMirror(remote: Remote, target: Path): {Throw[GitError]} Mirror

   /**
    * Bring `mirror` up to date with what its remote publishes now, forgetting the tags it has withdrawn.
    *
    * Pruning matters more here than it looks: a tag that stopped existing is a tag the resolver must stop
    * selecting, and a mirror that only ever accumulates would answer with releases the package has
    * withdrawn.
    */
   def fetch(mirror: Mirror): {Throw[GitError]} Unit

   /**
    * The versions `mirror` holds — what its remote had published as of the last fetch.
    */
   def tags(mirror: Mirror): {Throw[GitError]} List[TagRef]

   /**
    * The content of the file at `path` inside `mirror` at `version`, straight from the object database
    * — absent where the version or the file is not there.
    *
    * The one operation that *reads* a refusal rather than raising it, and the signature says so by
    * carrying no `Throw[GitError]`. A version nobody tagged and a tag carrying no such file are equally
    * "there is nothing to read", and a caller that reached either has a dependency line to blame that
    * this module cannot see.
    */
   def fileAt(version: Version, path: String, mirror: Mirror): Option[String]

   /**
    * Check `mirror` out at `commit` into `target`, and answer the tree.
    *
    * The one operation that leaves files on disk, and it exists because the compiler mounts source
    * *directories*: a resolution is a set of versions and a build is a set of roots, so something has
    * to materialise one from the other. A worktree rather than a second clone or an export, because
    * the objects are already in the mirror — the tree is all that is missing — and because the tree
    * stays tied to the mirror that explains where it came from.
    *
    * At a commit and not at a tag, because the tag is looked up once — by whoever asked which commit it
    * names — and checked against the lockfile there. Handing the tag to git a second time would be a
    * second lookup of a ref that may have moved in between, and a tree that was never checked.
    *
    * `target` is taken as git resolves it, which is why every caller passes an absolute one: this
    * operation stands *inside* the mirror (it operates on the repository it is in), so a relative
    * target would be read against the mirror's directory rather than against the caller's.
    */
   def addWorktree(commit: Commit, target: Path, mirror: Mirror): {Throw[GitError]} Worktree

   /**
    * What `checkout` holds that is not committed — one entry per path, tracked or not — and nothing
    * where its tree is clean.
    *
    * A list and not a `Bool`, because the one caller that asks refuses on a non-empty answer and a
    * refusal that names the files is one a user can act on without running git themselves.
    */
   def uncommittedChanges(checkout: Checkout): {Throw[GitError]} List[String]

   /**
    * The commit `checkout` has checked out — the one a release would tag.
    */
   def headCommit(checkout: Checkout): {Throw[GitError]} Commit

   /**
    * The commit `checkout`'s branch was last seen at on the remote branch it pushes to, as of the last
    * push or fetch — which is what lets "this commit is pushed" be asked without the network. Refused
    * where the branch pushes nowhere, and where nothing is checked out but a commit.
    */
   def upstreamCommit(checkout: Checkout): {Throw[GitError]} Commit

   /**
    * `true` where `ancestor` is `descendant` or is in its history, as `checkout`'s objects know it.
    */
   def isAncestor(ancestor: Commit, descendant: Commit, checkout: Checkout): {Throw[GitError]} Bool

   /**
    * The versions `checkout`'s `origin` publishes now, asked of the remote rather than of the tags the
    * checkout happens to hold: a release is numbered after what consumers can see, and a local tag
    * nobody pushed is not something they can.
    */
   def publishedReleases(checkout: Checkout): {Throw[GitError]} List[TagRef]

   /**
    * Tag `commit` as `version` in `checkout` — annotated, because an annotated tag is an object of its
    * own carrying who made it and when, which is what a release is; a lightweight tag is only a name.
    *
    * At a commit and not at whatever is checked out, for the reason `addWorktree` takes one: the commit
    * was looked up once, the questions above were asked about it, and tagging `HEAD` again would be a
    * second lookup that the checks never saw.
    */
   def tagRelease(version: Version, commit: Commit, checkout: Checkout): {Throw[GitError]} Unit

   /**
    * Push the tag `version` — that one ref and nothing else — to `checkout`'s `origin`, which is the
    * moment the release exists for anybody else.
    */
   def pushRelease(version: Version, checkout: Checkout): {Throw[GitError]} Unit
}

/**
 * How to actually reach `repository`, which a descriptor deliberately does not say.
 *
 * Dependency URLs are scheme-less by invariant — that is what keeps `//` unambiguously the module
 * selector and what stops two spellings of one transport becoming two identities. So the scheme is
 * supplied here, at the one place bytes are fetched, and `https` is the default rather than the rule:
 * where a package is fetched from is consumer configuration, and this is the function that will grow
 * a mirror table when there is one to grow.
 */
def remoteOf(repository: Repository): Remote = Remote("https://" ++ repository.repositoryUrl)
