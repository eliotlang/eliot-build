import eliot.collection.List
import eliot.file.Path
import eliot.file.File
import eliot.system.Process
import eliot.build.model.Version
import eliot.build.model.Lineage
import eliot.build.git.Git
import eliot.build.git.Tags

/**
 * The `Git` that talks to a repository: it spawns the `git` the user already has, once per operation,
 * in the directory the operation's subject decides — where this program stands for a command that
 * names a remote or a mirror, inside the mirror for a command that operates on the one it is in, and
 * inside the checkout for every command about the project's own repository, which names its `origin`
 * by the name only that repository's configuration gives it.
 *
 * **Named, and deliberately not the default.** An implementation's clause rows are bound where the *name*
 * is bound, and the binding comes from the scope of that `with` — so `tags(mirror) with shellGit`
 * inside a mocked test reaches the framework's process double, which is how this implementation is
 * tested at all. An anonymous default is bound at a slot or at `main` with nothing written, and its
 * clauses then bind the platform's own `Process`: nothing short of a real subprocess could ever check it.
 * The price is one `with shellGit` at the program's run boundary, where the launcher composes the tool,
 * and a `{Git}` reaching `main` without it is a compile error naming the effect — which is the honest
 * state of an effect the program has not yet decided how to run.
 *
 * Its clauses are where `{Process}` and `{Throw[IoError]}` enter the program: git failing to *start* is
 * this implementation's failure, and no caller declaring `{Git}` ever names it.
 */
implement shellGit: Git {
   def cloneMirror(remote: Remote, target: Path): {Process, Throw[IoError], Throw[GitError]} Mirror = {
      checked(
         command("git").withArgument("clone").withArgument("--mirror")
            .withArgument(remote.remoteUrl).withArgument(show(target)),
         here
      )

      Mirror(target)
   }

   def fetch(mirror: Mirror): {Process, Throw[IoError], Throw[GitError]} Unit = {
      checked(
         command("git").withArgument("fetch").withArgument("--tags").withArgument("--prune"),
         mirror.mirrorDirectory
      )

      unit
   }

   def tags(mirror: Mirror): {Process, Throw[IoError], Throw[GitError]} List[TagRef] =
      parseTagRefs(checked(lsRemoteTags(show(mirror.mirrorDirectory)), here))

   /**
    * `Throw[IoError]` is a different statement from the refusal this reads, and stays: git refusing to
    * answer is what this reads, git failing to *start* is not.
    */
   def fileAt(version: Version, path: String, mirror: Mirror): {Process, Throw[IoError]} Option[String] = {
      val shown = run(
         command("git").withArgument("show").withArgument(show(version) ++ ":" ++ path),
         mirror.mirrorDirectory
      )

      someIf(shown.exitCode == 0, shown.standardOutput)
   }

   /**
    * `--detach` because a build checks out a *commit*, and a branch checked out twice is a thing git
    * refuses; `--force` because the cache is allowed to have been tidied up behind git's back. A tree
    * removed with `rm -rf` leaves the mirror still holding its registration, and the plain `add` then
    * refuses a path nothing occupies — a cache that cannot heal itself from a deleted directory would
    * be a cache a user has to know how to repair.
    */
   def addWorktree(commit: Commit, target: Path, mirror: Mirror): {Process, Throw[IoError], Throw[GitError]} Worktree = {
      checked(
         command("git").withArgument("worktree").withArgument("add").withArgument("--detach")
            .withArgument("--force").withArgument(show(target)).withArgument(show(commit)),
         mirror.mirrorDirectory
      )

      Worktree(target)
   }

   def uncommittedChanges(checkout: Checkout): {Process, Throw[IoError], Throw[GitError]} List[String] =
      split("\n", checked(command("git").withArgument("status").withArgument("--porcelain"), checkout.checkoutDirectory))
         .filter(entry -> entry != "")

   def headCommit(checkout: Checkout): {Process, Throw[IoError], Throw[GitError]} Commit =
      revision("HEAD", checkout)

   /**
    * `@{upstream}` is git's own spelling of the remote-tracking branch the checked-out branch pushes to,
    * and git refuses it — naming why — on a branch with none and on a detached `HEAD`.
    */
   def upstreamCommit(checkout: Checkout): {Process, Throw[IoError], Throw[GitError]} Commit =
      revision("@{upstream}", checkout)

   /**
    * `merge-base --is-ancestor` answers in its exit code, and two of its codes are answers: 0 is yes, 1
    * is no. Anything else is git failing to answer — a commit this checkout has no object for, most
    * likely — and that is refused like every other operation's failure.
    */
   def isAncestor(ancestor: Commit, descendant: Commit, checkout: Checkout): {Process, Throw[IoError], Throw[GitError]} Bool = {
      val arguments = command("git").withArgument("merge-base").withArgument("--is-ancestor")
         .withArgument(show(ancestor)).withArgument(show(descendant))
      val result = run(arguments, checkout.checkoutDirectory)

      unless(result.exitCode == 0 || result.exitCode == 1) raise(refusal(arguments, result))
      result.exitCode == 0
   }

   def publishedReleases(checkout: Checkout): {Process, Throw[IoError], Throw[GitError]} List[TagRef] =
      parseTagRefs(checked(lsRemoteTags(publishingRemote), checkout.checkoutDirectory))

   /**
    * The tag's message is its name: a release says what it is in its version, and what changed is the
    * history's to say.
    */
   def tagRelease(version: Version, commit: Commit, checkout: Checkout): {Process, Throw[IoError], Throw[GitError]} Unit = {
      checked(
         command("git").withArgument("tag").withArgument("--annotate").withArgument("--message")
            .withArgument(show(version)).withArgument(show(version)).withArgument(show(commit)),
         checkout.checkoutDirectory
      )

      unit
   }

   /**
    * Spelled `refs/tags/<version>` so a branch that happens to share the name cannot be what is pushed.
    */
   def pushRelease(version: Version, checkout: Checkout): {Process, Throw[IoError], Throw[GitError]} Unit = {
      checked(
         command("git").withArgument("push").withArgument(publishingRemote).withArgument("refs/tags/" ++ show(version)),
         checkout.checkoutDirectory
      )

      unit
   }
}

/**
 * The directory this program was started in — the frame every relative path it is given is expressed
 * in, and therefore the directory every command that *names* a repository must run in. A cache root
 * may be relative (`target/cache` is the obvious thing for a caller to pass), and a command launched
 * from inside it would resolve that same relative path a second time, burying a mirror at
 * `target/cache/target/cache/…`. An absolute directory is indifferent to the frame, so one rule serves
 * both.
 */
private def here: Path = path(".")

/**
 * The remote a release is numbered against and pushed to: `origin`, the name `git clone` gives the
 * repository a checkout came from. Named once, because it is the one assumption a release makes about
 * how somebody's checkout is configured.
 */
private def publishingRemote: String = "origin"

/**
 * `git ls-remote --tags <target>`, for a remote, a mirror directory and a checkout's `origin` alike —
 * all three are things git is *told about*. Where it runs is the caller's to say: in `here` for the
 * first two, inside the checkout for the third, which is the only directory that name means anything in.
 */
private def lsRemoteTags(target: String): List[String] =
   command("git").withArgument("ls-remote").withArgument("--tags").withArgument(target)

/**
 * Run `arguments` in `workingDirectory` and answer what it wrote, raising when it exited non-zero —
 * the step every clause of `shellGit` is made of, bar two.
 *
 * The standard library is right that a non-zero exit is data rather than a failure — it is how a
 * program reports a decision — but the decisions reported by the operations above are all the same
 * one: git was asked about a repository and could not answer. The two operations that genuinely
 * read an exit code — `fileAt`, whose refusal is an absence, and `isAncestor`, whose 1 is a no — call
 * `run` themselves.
 */
private def checked(arguments: List[String], workingDirectory: Path): {Process, Throw[IoError], Throw[GitError]} String = {
   val result = run(arguments, workingDirectory)

   unless(result.exitCode == 0) raise(refusal(arguments, result))
   result.standardOutput
}

/**
 * The commit `name` resolves to in `checkout` — `rev-parse` prints it on a line of its own, and the
 * line's end is not part of the hash.
 */
private def revision(name: String, checkout: Checkout): {Process, Throw[IoError], Throw[GitError]} Commit =
   Commit(trim(checked(command("git").withArgument("rev-parse").withArgument(name), checkout.checkoutDirectory)))

/**
 * What `arguments` exiting as `result` reports: the command whole, its code and what it said.
 */
private def refusal(arguments: List[String], result: ProcessResult): GitError =
   GitError(arguments.joined(" "), result.exitCode, result.standardError)
