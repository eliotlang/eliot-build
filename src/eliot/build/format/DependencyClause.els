import eliot.collection.List
import eliot.build.format.Clause
import eliot.build.format.ClauseReader
import eliot.build.model.PackageId
import eliot.build.model.Version
import eliot.build.model.Descriptor

/**
 * What a `dep` line names.
 *
 * Every other clause of a descriptor is read at one place in the file, into one thing. `dep` is read
 * at four — the top level, a `module`, the `test` block inside a module, an `artifact` — and a
 * `backend` names a package the same way for a fifth. That is what makes it a module rather than a
 * paragraph of `eliot.build.format.PackageFile`: the one clause whose meaning several block readers
 * have to agree on, with the rules that are only about it in the same place.
 *
 * Those rules are three. A version token is a **git tag** and is parsed here rather than merely
 * inspected, because the model carries an ordered version from here on and a string never was one.
 * A URL is **scheme-less**, by invariant of the format rather than of the canonical form. And a
 * version is **required of a foreign package and refused of a sibling**, because a requirement with
 * no floor is a question the resolver could not answer, while a sibling versions with the repository
 * that declared it.
 */

/**
 * `dep <url> <version>` or `dep //module`. The version is required for a foreign package — a
 * requirement with no floor is a question the resolver could not answer — and forbidden for a sibling
 * module, which cannot carry one: tags are repository-wide, so a sibling versions with its repository.
 */
def dependencyOf(clause: Clause): {Throw[ClauseProblem]} Dependency = {
   val target = required(0, "a dep needs a package URL", clause)
   val reference = referenceOf(target, clause)
   val version = versionOf(optional(1, clause), clause)

   atMostArguments(2, clause)
   reference match {
      case Sibling(name)    -> siblingDependencyOf(name, version, clause)
      case Foreign(package) -> requirementOf(package, version, clause)
   }
}

private def siblingDependencyOf(
   name: ModuleName,
   version: Option[Version],
   clause: Clause
): {Throw[ClauseProblem]} Dependency =
   foldOption(
      SiblingDependency(name),
      _ -> raise(problemIn("a sibling module versions with its repository and carries no version", clause)),
      version
   )

private def requirementOf(
   package: Package,
   version: Option[Version],
   clause: Clause
): {Throw[ClauseProblem]} Dependency =
   foldOption(
      raise(problemIn("a foreign dependency needs a minimum version", clause)),
      minimum -> Requirement(package, minimum),
      version
   )

/**
 * A scheme-less URL, optionally carrying a `//module` selector. Scheme-less is an invariant of the
 * format, not merely of the canonical form `packageId` answers with: a written scheme is a spelling
 * the author expected to matter, and where the bytes come from is the consumer's configuration.
 * Refusing it here is what keeps `//` unambiguously the module selector.
 */
def referenceOf(target: String, clause: Clause): {Throw[ClauseProblem]} PackageId = {
   checkSchemeless(target, clause)
   packageId(target)
}

/**
 * The `dep` lines among `clauses` — how the root of a descriptor reads its base dependencies.
 */
def dependenciesIn(clauses: List[Clause]): {Throw[ClauseProblem]} List[Dependency] =
   clausesNamed("dep", clauses).map(dependencyOf)

/**
 * The dependencies of the `test` blocks among `clauses`. A file may write more than one, and they
 * mean one scope between them.
 */
def testDependenciesIn(clauses: List[Clause]): {Throw[ClauseProblem]} List[Dependency] =
   clausesNamed("test", clauses).flatMap(dependenciesOf)

/**
 * The `dep` lines of a block — an `artifact`'s dependencies, a `module`'s.
 */
def dependenciesOf(clause: Clause): {Throw[ClauseProblem]} List[Dependency] = dependenciesIn(clause.children)

/**
 * The dependencies of the `test` blocks of a block, which is how a module declares what its own
 * suite needs.
 */
def testDependenciesOf(clause: Clause): {Throw[ClauseProblem]} List[Dependency] =
   testDependenciesIn(clause.children)

/**
 * Every version token is a git tag, spelled as the tag is: there is no `>=` to write and no range to
 * express, because the syntax cannot state what the resolver does not do. The token is *parsed*
 * rather than merely inspected — the model carries an ordered version from here on, which is what
 * resolution needs and what the string never was.
 */
private def versionOf(token: Option[String], clause: Clause): {Throw[ClauseProblem]} Option[Version] =
   foldOption(None, tag -> Some(checkedVersion(tag, clause)), token)

private def checkedVersion(tag: String, clause: Clause): {Throw[ClauseProblem]} Version = {
   val parsed: Option[Version] = runAbort(parseVersion(tag))

   foldOption(raise(problemIn("a version must be a tag like 'v1.3'", clause)), version -> version, parsed)
}

private def checkSchemeless(target: String, clause: Clause): {Throw[ClauseProblem]} Unit =
   requireThat(!contains("://", target), "a dependency URL carries no scheme", clause)
