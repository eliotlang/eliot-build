import eliot.collection.List
import eliot.build.format.Clause
import eliot.build.format.ClauseReader
import eliot.build.format.DependencyClause
import eliot.build.model.PackageId
import eliot.build.model.Descriptor

/**
 * The `eliot.pkg` file: which keyword introduces what, and the reading of a whole file into the typed
 * model.
 *
 * `eliot.build.format.Clause` decides what shape a descriptor has; this module decides what the
 * shapes *mean*. Keeping the two apart is what lets a foreign tool read the file's literal content
 * without knowing the build model. The model itself is `eliot.build.model.Descriptor`, which holds no
 * syntax at all — so a consumer that only reads a descriptor never imports this module.
 *
 * Two things the vocabulary is made of live next door, because neither is about a keyword.
 * `eliot.build.format.ClauseReader` reads one clause carefully — which argument has to be there, which
 * children are recognised, what a clause that does not say so is complained about with — and
 * `eliot.build.format.DependencyClause` reads the `dep` line, which the top level and every `package`
 * block read identically. The other direction is `eliot.build.format.DescriptorWriter`'s, which needs
 * none of this module's machinery — a model in hand cannot fail to be written — and imports `model`
 * alone. What is left here is the keywords themselves: `package`, `at`, `internal`, `main`, `plugin`,
 * `compiler`, `backend`, and which part of the model each of them feeds.
 *
 * **The top level is a package block with the braces left off.** Its `dep`, `main` and `plugin`
 * clauses describe the *root package* — the one whose directory is the repository's own and which a
 * `dep` line carrying no selector selects — so a flat repository writes no block at all and a
 * repository with several packages beside the root writes one each. The root package is synthesised
 * whether or not anything was written for it, because a bare dep on a repository has to land
 * somewhere and "somewhere" should not depend on which clauses the author happened to need.
 *
 * **Retired keywords are read, not refused.** `module`, `test` and `artifact` are what this format
 * spelled before the scopes were cut (`docs/build-system.md`, "What this replaced, and why"), and
 * tags carrying them are published and immutable — a resolver that could not read them could not
 * resolve anything. So `module` is read exactly as `package` is, which it turns out to be: its `at`
 * meant the same directory, holding the same `src/`. `test` and `artifact` are *dropped*, which loses
 * nothing, because neither ever reached a consumer and a consumer's descriptor is the only one this
 * path ever sees.
 *
 * The two error channels meet here and nowhere else: the parser raises `ClauseError`, a reader raises
 * `ClauseProblem`, and `DescriptorError` is the union a caller catches. Unknown clauses are fatal by
 * design, which is how the format evolves without a version field — a descriptor using a clause this
 * launcher does not know refuses to build rather than silently ignoring the line that would have
 * changed the outcome.
 */

/**
 * Why a descriptor could not be read: either it is not a well-formed clause file, or it is but says
 * something this launcher does not understand. One error type rather than two effect rows, because a
 * caller wants one `catch` and the distinction is a constructor, not a channel.
 */
data DescriptorError = Malformed(syntax: ClauseError) | Unreadable(clauseProblem: ClauseProblem)

implement Show[DescriptorError] {
   def show(value: DescriptorError): String = value match {
      case Malformed(syntax) -> show(syntax)
      case Unreadable(problem) -> show(problem)
   }
}

/**
 * The descriptor's file name, at the root of every repository.
 *
 * A fact about the *format*, so it lives with the format: `eliot.build.git.Cache` reads the file out
 * of a mirror and needs the name, but nothing about which name it is belongs to cache policy.
 */
def descriptorFileName: String = "eliot.pkg"

/**
 * The descriptor `lines` spell.
 *
 * ```eliot
 * val descriptor = parseDescriptor(readLines(root / "eliot.pkg"))
 * ```
 */
def parseDescriptor(lines: List[String]): {Throw[DescriptorError]} Descriptor =
   foldEither(
      error -> raise(Malformed(error)),
      clauses -> interpreted(clauses),
      runThrow[ClauseError](parseClauses(lines))
   )

/**
 * What `clauses` mean, with the reader's complaints answered as descriptor errors — the second of the
 * two channels the modules underneath raise on, and the only place either becomes a `DescriptorError`.
 */
private def interpreted(clauses: List[Clause]): {Throw[DescriptorError]} Descriptor =
   foldEither(
      problem -> raise(Unreadable(problem)),
      descriptor -> descriptor,
      runThrow[ClauseProblem](interpret(clauses))
   )

/**
 * The descriptor `clauses` spell: the root package the top level describes, then every package
 * declared beside it.
 *
 * The root is read exactly as every block inside it is read — by asking for the clauses of one
 * keyword and interpreting those — rather than by folding a growing `Descriptor` through a sum over
 * keywords. The fold was forced once: under the carrier model an `if`'s arms could not raise, so
 * naming the alternatives was the only way to refuse an unknown one. It is `knownClauses` that
 * refuses now, up front and for all of them at once, and what is left is the mapping itself.
 */
private def interpret(clauses: List[Clause]): {Throw[ClauseProblem]} Descriptor = {
   knownClauses(descriptorKeywords, clauses)

   Descriptor(prepend(declaredPackages(clauses), rootPackageOf(clauses)))
}

/**
 * Every package the file declares a block for, `module` blocks among them: a retired keyword that
 * meant what `package` means, read the same way so an already-published tag still resolves.
 */
private def declaredPackages(clauses: List[Clause]): {Throw[ClauseProblem]} List[BuildPackage] =
   clausesNamed("package", clauses).map(packageOf) ++ clausesNamed("module", clauses).map(packageOf)

/**
 * The root package: the top level's own clauses, at the repository root, exported because a bare `dep`
 * line on this repository is exactly what selects it.
 */
private def rootPackageOf(clauses: List[Clause]): {Throw[ClauseProblem]} BuildPackage =
   BuildPackage(
      rootPackageName,
      rootPackageDirectory,
      true,
      dependenciesIn(clauses),
      mainIn(clauses),
      pluginsIn(clauses)
   )

private def packageOf(clause: Clause): {Throw[ClauseProblem]} BuildPackage = {
   val name = required(0, "a package needs a name", clause)

   atMostArguments(1, clause)
   knownChildren(packageKeywords, clause)
   BuildPackage(
      PackageName(name),
      directoryOf(name, clause),
      isEmpty(clause.childrenNamed("internal")),
      dependenciesOf(clause),
      mainIn(clause.children),
      pluginsOf(clause)
   )
}

/**
 * Where a package's root directory is, relative to the repository root: what its `at` clause says, or
 * its own name where it says nothing — the flat repository of same-named directories, which is what a
 * package looks like unless something else already owns its layout.
 *
 * The default is applied here rather than carried onwards as an absence, so the model hands every
 * consumer a directory and the rule lives in one place. Reading `at` costs the package nothing it did
 * not already spend: a repository whose layout is the convention never writes one.
 */
private def directoryOf(name: String, clause: Clause): {Throw[ClauseProblem]} String =
   clause.childrenNamed("at").foldLeft(name, child -> _ -> atClause(child))

/**
 * `at <directory>` — a path *inside* the repository, so a descriptor fetched from a remote cannot
 * point source assembly at a directory the checkout does not contain. An absolute path and a `..`
 * segment are refused for that one reason, which is why they are refused together.
 */
private def atClause(clause: Clause): {Throw[ClauseProblem]} String = {
   val directory = required(0, "an 'at' needs a directory", clause)

   atMostArguments(1, clause)
   requireThat(insideRepository(directory), "a package directory is a path inside the repository", clause)
   directory
}

private def insideRepository(directory: String): Bool =
   !startsWith("/", directory) && !any(segment -> segment == "..", split("/", directory))

/**
 * `main <module>` — the Eliot module holding the entry point, and the only thing a consumer states
 * about producing an executable. Which backend runs, which word it answers to and what it emits are
 * all read off the closure instead, from the packages that know those facts about themselves.
 *
 * A package declaring one is runnable; the framework declares its own, which is how a suite gets a
 * command without its author naming anybody's internals.
 */
private def mainIn(clauses: List[Clause]): {Throw[ClauseProblem]} Option[String] =
   clausesNamed("main", clauses).foldLeft(None, child -> _ -> Some(mainClause(child)))

private def mainClause(clause: Clause): {Throw[ClauseProblem]} String = {
   val module = required(0, "a main needs the module holding it", clause)

   atMostArguments(1, clause)
   module
}

private def pluginsIn(clauses: List[Clause]): {Throw[ClauseProblem]} List[Plugin] =
   clausesNamed("plugin", clauses).map(pluginClause)

private def pluginsOf(clause: Clause): {Throw[ClauseProblem]} List[Plugin] = pluginsIn(clause.children)

/**
 * `plugin <asset> { backend <word> | compiler }` — the name of a release asset of this package, and
 * the provider's two statements about it. No coordinate, no version, no URL and no hash: the asset
 * hangs off this repository at the tag the consumer already selected, and what a fetch of it is
 * *worth* is the lockfile's to record, since the asset is built after the tag exists.
 */
private def pluginClause(clause: Clause): {Throw[ClauseProblem]} Plugin = {
   val asset = required(0, "a plugin needs a release asset name", clause)

   atMostArguments(1, clause)
   knownChildren(pluginKeywords, clause)
   Plugin(asset, backendWordOf(clause), !isEmpty(clause.childrenNamed("compiler")))
}

/**
 * `backend <word>` — the compiler command word this asset registers, which is what makes it a backend
 * candidate rather than an always-on contributor. The word is the *provider's* and nobody else ever
 * writes it: a consumer names dependencies and an entry point, and the one candidate in the closure
 * is what the backend is.
 */
private def backendWordOf(clause: Clause): {Throw[ClauseProblem]} Option[String] =
   clause.childrenNamed("backend").foldLeft(None, child -> _ -> Some(backendWordClause(child)))

private def backendWordClause(clause: Clause): {Throw[ClauseProblem]} String = {
   val word = required(0, "a plugin's backend needs the command word it registers", clause)

   atMostArguments(1, clause)
   word
}

/**
 * `test` and `artifact` are listed so a published descriptor still parses, and read nowhere: neither
 * ever reached a consumer, and a consumer's descriptor is the only one a retired keyword is met in.
 */
private def descriptorKeywords: List[String] =
   append(
      append(append(append(append(append(empty, "dep"), "package"), "main"), "plugin"), "module"),
      "test"
   ) ++ singleton("artifact")

private def packageKeywords: List[String] =
   append(append(append(append(append(append(empty, "at"), "internal"), "dep"), "main"), "plugin"), "test")

private def pluginKeywords: List[String] = append(append(empty, "backend"), "compiler")
