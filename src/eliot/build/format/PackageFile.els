import eliot.collection.List
import eliot.build.format.Clause
import eliot.build.format.ClauseReader
import eliot.build.format.DependencyClause
import eliot.build.model.PackageId
import eliot.build.model.Descriptor

/**
 * The `eliot.pkg` file: which keyword introduces what, and the reading of a whole file into the typed
 * model.
 *
 * `eliot.build.format.Clause` decides what shape a descriptor has; this module decides what the
 * shapes *mean*. Keeping the two apart is what lets a foreign tool read the file's literal content
 * without knowing the build model. The model itself is `eliot.build.model.Descriptor`, which holds no
 * syntax at all — so a consumer that only reads a descriptor never imports this module.
 *
 * Two things the vocabulary is made of live next door, because neither is about a keyword.
 * `eliot.build.format.ClauseReader` reads one clause carefully — which argument has to be there, which
 * children are recognised, what a clause that does not say so is complained about with — and
 * `eliot.build.format.DependencyClause` reads the `dep` line, which every `package` block reads the
 * same way. The other direction is `eliot.build.format.DescriptorWriter`'s, which needs none of this
 * module's machinery — a model in hand cannot fail to be written — and imports `model` alone. What is
 * left here is the keywords themselves: `launcher`, `package`, `at`, `internal`, `dep`, `compiler`, `asset`,
 * and which part of the model each of them feeds.
 *
 * **A file is package blocks, and one line that is not about packages at all.** `launcher <tag>` pins
 * the launcher this repository's own developers build with, and `eliotw` is its only reader: it greps
 * for the first line starting `launcher `, so the clause needs no parser and the pin needs no file of its
 * own. The launcher checks the clause's shape and then drops it — it pins what *this* repository runs,
 * not anything a dependent inherits, so a mirror's pin means nothing and the model has no place for one.
 *
 * Every package is written out — the one standing at
 * the repository root too, `package root { at . … }` by convention — so a `dep` line has exactly one
 * place it can stand, the block of the package whose sources need it, and the file never carries a
 * clause whose scope a reader has to know. A `dep`, `compiler` or `asset` at the top level is refused with
 * the spelling it should have had, rather than as an unknown keyword: it is not a clause a newer
 * launcher would know, it is a clause that belongs somewhere. A package exists exactly when a block
 * declares it, and no name is special: `root` is what a package at `.` is usually called, and a
 * dependent selects it as `//root` like any other.
 *
 * One reading serves every descriptor — the project's own and every mirror's — because there is one
 * spelling of the format and nothing published in an older one is still depended on.
 *
 * The two error channels meet here and nowhere else: the parser raises `ClauseError`, a reader raises
 * `ClauseProblem`, and `DescriptorError` is the union a caller catches. Unknown clauses are fatal by
 * design, which is how the format evolves without a version field — a descriptor using a clause this
 * launcher does not know refuses to build rather than silently ignoring the line that would have
 * changed the outcome.
 */

/**
 * Why a descriptor could not be read: either it is not a well-formed clause file, or it is but says
 * something this launcher does not understand. One error type rather than two effect rows, because a
 * caller wants one `catch` and the distinction is a constructor, not a channel.
 */
data DescriptorError = Malformed(syntax: ClauseError) | Unreadable(clauseProblem: ClauseProblem)

implement Show[DescriptorError] {
   def show(value: DescriptorError): String = value match {
      case Malformed(syntax) -> show(syntax)
      case Unreadable(problem) -> show(problem)
   }
}

/**
 * The descriptor's file name, at the root of every repository.
 *
 * A fact about the *format*, so it lives with the format: `eliot.build.git.Cache` reads the file out
 * of a mirror and needs the name, but nothing about which name it is belongs to cache policy.
 */
def descriptorFileName: String = "eliot.pkg"

/**
 * The descriptor `lines` spell: package blocks, and a `launcher` pin that says nothing about them.
 *
 * ```eliot
 * val descriptor = parseDescriptor(readLines(root / "eliot.pkg"))
 * ```
 */
def parseDescriptor(lines: List[String]): {Throw[DescriptorError]} Descriptor =
   foldEither(
      error -> raise(Malformed(error)),
      clauses -> interpreted(clauses),
      runThrow[ClauseError](parseClauses(lines))
   )

/**
 * What `clauses` mean, with the reader's complaints answered as descriptor errors — the second of the
 * two channels the modules underneath raise on, and the only place either becomes a `DescriptorError`.
 */
private def interpreted(clauses: List[Clause]): {Throw[DescriptorError]} Descriptor =
   foldEither(
      problem -> raise(Unreadable(problem)),
      descriptor -> descriptor,
      runThrow[ClauseProblem](interpret(clauses))
   )

/**
 * The descriptor `clauses` spell: every package the file declares a block for.
 *
 * Read by asking for the clauses of one keyword and interpreting those, rather than by folding a
 * growing `Descriptor` through a sum over keywords. The fold was forced once: under the carrier model
 * an `if`'s arms could not raise, so naming the alternatives was the only way to refuse an unknown one.
 * It is `knownClauses` that refuses now, up front and for all of them at once, and what is left is the
 * mapping itself.
 */
private def interpret(clauses: List[Clause]): {Throw[ClauseProblem]} Descriptor = {
   topLevelClauses(clauses)

   Descriptor(clausesNamed("package", clauses).map(packageOf))
}

/**
 * The top level holds package blocks and the launcher pin, and nothing else. A clause that belongs *inside* one is told so,
 * and told how a package at the repository root is spelled, because "unknown clause, upgrade" would
 * send its author looking for a newer launcher when what the line needs is a block around it.
 */
private def topLevelClauses(clauses: List[Clause]): {Throw[ClauseProblem]} Unit = {
   clauses.foreach(clause -> requireThat(!belongsInsideAPackage(clause), belongsInside(clause), clause))
   knownClauses(descriptorKeywords, clauses)
   clausesNamed("launcher", clauses).foreach(launcherClause)
}

/**
 * `launcher <tag>` — read for its shape alone, so a pin `eliotw` would choke on is refused here rather
 * than passing the launcher and failing only the wrapper. What it names is nobody's business but the
 * wrapper's, which has already acted on it by the time anything reads this.
 */
private def launcherClause(clause: Clause): {Throw[ClauseProblem]} Unit = {
   required(0, "a launcher pin needs the tag it pins", clause)
   atMostArguments(1, clause)
   knownChildren(empty, clause)
}

private def belongsInsideAPackage(clause: Clause): Bool =
   packageClauseKeywords.any(known -> keyword(clause) == known)

private def belongsInside(clause: Clause): String =
   "'" ++ clause.keyword ++ "' belongs inside a package block; a package at the repository root is written 'package root { at . ... }'"

private def packageOf(clause: Clause): {Throw[ClauseProblem]} BuildPackage = {
   val name = required(0, "a package needs a name", clause)

   atMostArguments(1, clause)
   knownChildren(packageKeywords, clause)
   BuildPackage(
      PackageName(name),
      directoryOf(name, clause),
      isEmpty(clause.childrenNamed("internal")),
      dependenciesOf(clause),
      compilerOf(clause),
      clause.childrenNamed("asset").map(assetClause)
   )
}

/**
 * Where a package's root directory is, relative to the repository root: what its `at` clause says, or
 * its own name where it says nothing — the flat repository of same-named directories, which is what a
 * package looks like unless something else already owns its layout.
 *
 * The default is applied here rather than carried onwards as an absence, so the model hands every
 * consumer a directory and the rule lives in one place. Reading `at` costs the package nothing it did
 * not already spend: a repository whose layout is the convention never writes one.
 */
private def directoryOf(name: String, clause: Clause): {Throw[ClauseProblem]} String =
   clause.childrenNamed("at").foldLeft(name, child -> _ -> atClause(child))

/**
 * `at <directory>` — a path *inside* the repository, so a descriptor fetched from a remote cannot
 * point source assembly at a directory the checkout does not contain. An absolute path and a `..`
 * segment are refused for that one reason, which is why they are refused together.
 */
private def atClause(clause: Clause): {Throw[ClauseProblem]} String = {
   val directory = required(0, "an 'at' needs a directory", clause)

   atMostArguments(1, clause)
   requireThat(insideRepository(directory), "a package directory is a path inside the repository", clause)
   directory
}

private def insideRepository(directory: String): Bool =
   !startsWith("/", directory) && !any(segment -> segment == "..", split("/", directory))

/**
 * `compiler <words…>` — what a build of any package whose closure holds this one runs: the compiler,
 * once, with these words where the launcher does not put its own (`docs/build-system.md`, "What a
 * build runs"). The words are passed through verbatim and interpreted by nobody but the compiler.
 *
 * **One per package.** Two lines in one block would be a task list with the names filed off — it
 * would need an order, then a way to skip one, then a name to skip it by. A package that wants two
 * things depends on two packages, and the refusal says so.
 */
private def compilerOf(clause: Clause): {Throw[ClauseProblem]} Option[List[String]] = {
   val lines = clause.childrenNamed("compiler")

   foldOption(unit, second -> raise(problemIn(oneCompilerLine, second)), lines.at(1))
   foldOption(None, line -> Some(compilerClause(line)), lines.head)
}

private def compilerClause(clause: Clause): {Throw[ClauseProblem]} List[String] = {
   required(0, "a compiler line needs the words it passes to the compiler", clause)
   knownChildren(empty, clause)
   clause.arguments
}

private def oneCompilerLine: String =
   "a package carries one compiler line; a package that wants two things depends on two packages"

/**
 * `asset <name>` — the name of a release asset of this package. No coordinate, no version, no URL and
 * no hash: the asset hangs off this repository at the tag the consumer already selected, and what a
 * fetch of it is *worth* is the lockfile's to record, since the asset is built after the tag exists.
 * Nor any statement about what the asset is — the compiler tells its plugins apart, the launcher only
 * puts them all on one classpath.
 */
private def assetClause(clause: Clause): {Throw[ClauseProblem]} String = {
   val asset = required(0, "an asset needs a release asset name", clause)

   atMostArguments(1, clause)
   knownChildren(empty, clause)
   asset
}

/**
 * What the top level may hold: package blocks and the launcher pin, and nothing that belongs inside a
 * package.
 */
private def descriptorKeywords: List[String] = append(singleton("package"), "launcher")

/**
 * The clauses that describe a package rather than declare one — what the top level refuses with the
 * block they belong in.
 */
private def packageClauseKeywords: List[String] = append(append(append(empty, "dep"), "compiler"), "asset")

private def packageKeywords: List[String] = append(append(packageClauseKeywords, "at"), "internal")
