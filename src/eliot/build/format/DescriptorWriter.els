import eliot.collection.List
import eliot.build.model.PackageId
import eliot.build.model.Version
import eliot.build.model.Descriptor

/**
 * A descriptor written back out as an `eliot.pkg` file.
 *
 * The other direction of `eliot.build.format.PackageFile`'s contract, and the half that needs none of
 * the machinery the reading half is built on: there is no clause tree here, no parser and no way to
 * fail — a model in hand is already everything the file says, so writing it is a total function from
 * data to text. That is what makes it a module rather than the bottom of the reader: the import list
 * is `model` and nothing else.
 *
 * Not a byte-for-byte round trip — comments, order within a keyword's group and spelling are the
 * author's, not the model's, and an `at` repeating the package's own name is dropped because the name
 * already said it — but every clause the model carries reappears, canonically ordered. That is what
 * makes a descriptor inspectable, what makes the tool's own edits to one reviewable, and what lets a
 * reader's test assert on a rendering rather than on a shape.
 *
 * **The root package is written as the top level, not as a block.** It is the one package whose
 * directory is not a choice, so `package root { … }` would be a block whose only content is what the
 * file could have said with no block at all — and a writer that emitted one would teach every reader
 * a second spelling of the common case. A descriptor whose root package says nothing writes nothing
 * for it, which is what a repository of packages in subdirectories looks like.
 *
 * Nesting is written by indenting a whole rendered block rather than by threading a depth through the
 * renderers, so a package's plugin sub-clauses end up two levels in without any renderer knowing how
 * deep it is.
 */

/**
 * `descriptor` written back out in `eliot.pkg` syntax: the root package's own clauses at the top
 * level, then a block per package beside it.
 *
 * ```eliot
 * val text = renderDescriptor(parseDescriptor(lines))
 * ```
 */
def renderDescriptor(descriptor: Descriptor): String =
   nonEmptyLines(
      rootClauses(descriptor) ++ besideTheRoot(descriptor).map(renderPackage)
   )

private def rootClauses(descriptor: Descriptor): List[String] =
   foldOption(empty, root -> packageClauses(root), packageNamed(rootPackageName, descriptor))

private def besideTheRoot(descriptor: Descriptor): List[BuildPackage] =
   descriptor.packages.filter(built -> built.packageName != rootPackageName)

/**
 * Everything one package says, in the order a reader expects it: where it is, whether it is anyone
 * else's to name, what it depends on, what runs it, what it ships.
 */
private def packageClauses(built: BuildPackage): List[String] =
   renderAt(built) ++
      renderInternal(built) ++
      built.packageDependencies.map(renderDependency) ++
      renderMain(built) ++
      built.packagePlugins.map(renderPlugin)

private def renderPackage(built: BuildPackage): String =
   "package " ++ show(built.packageName) ++ renderBlock(packageClauses(built))

private def renderDependency(dependency: Dependency): String = dependency match {
   case SiblingDependency(name)         -> "dep //" ++ show(name)
   case Requirement(package, minimum)   -> "dep " ++ show(package) ++ " " ++ show(minimum)
}

/**
 * `at <directory>`, written only where the directory is not the package's name. Where it is, the name
 * has already said so, and writing it out would spell a convention as though it were an override. The
 * root package's `.` is never written for the same reason twice over: it is not a choice, and the top
 * level it is rendered at is what says so.
 */
private def renderAt(built: BuildPackage): List[String] =
   fold(atItsDefault(built), empty, singleton("at " ++ built.packageRoot))

private def atItsDefault(built: BuildPackage): Bool =
   built.packageRoot == show(built.packageName) ||
      (built.packageName == rootPackageName && built.packageRoot == rootPackageDirectory)

private def renderInternal(built: BuildPackage): List[String] =
   fold(built.exported, empty, singleton("internal"))

private def renderMain(built: BuildPackage): List[String] =
   foldOption(empty, module -> singleton("main " ++ module), built.packageMain)

private def renderPlugin(plugin: Plugin): String =
   "plugin " ++ plugin.pluginAsset ++ renderBlock(renderBackendWord(plugin) ++ renderCompiler(plugin))

private def renderBackendWord(plugin: Plugin): List[String] =
   foldOption(empty, word -> singleton("backend " ++ word), plugin.pluginBackend)

private def renderCompiler(plugin: Plugin): List[String] =
   fold(plugin.compilerBase, singleton("compiler"), empty)

/**
 * A `{ … }` block holding `lines`, each indented one level. Nested blocks are indented by their own
 * renderer, so a plugin's sub-clauses end up two levels in.
 */
private def renderBlock(lines: List[String]): String =
   fold(isEmpty(lines), "", " {\n" ++ lines.map(indented).joined("\n") ++ "\n}")

private def indented(text: String): String = split("\n", text).map(indentLine).joined("\n")

private def indentLine(line: String): String = "  " ++ line

private def nonEmptyLines(lines: List[String]): String = lines.filter(line -> line != "").joined("\n")
