import eliot.collection.List
import eliot.file.Path
import eliot.file.File
import eliot.system.Process
import eliot.build.model.PackageId
import eliot.build.model.Version
import eliot.build.model.Lock
import eliot.build.assets.Assets

/**
 * The `Assets` that actually goes and gets one: it downloads the release asset with the tool the
 * machine has and unpacks it beside the mirrors, once per asset per version.
 *
 * **Named, and deliberately not the default**, for the reason `eliot.build.git.ShellGit` gives: an
 * implementation's clause rows are bound where the *name* is bound, so a test writing
 * `assetTree(asset) with shellAssets` reaches the framework's process double and this implementation is
 * checked at all. The launcher's run boundary writes the one `with shellAssets`, and an `{Assets}`
 * reaching `main` without it is a compile error naming the effect.
 *
 * **It spawns rather than speaks HTTP, and that is not a stopgap in the way it looks.** Nothing in
 * `eliot.system` opens a socket or reads a zip, so a download is `curl` and an unpacking is `unzip` —
 * the same shape `eliot.build.git.ShellGit` has, where git is a program the user already has rather
 * than a library this tool carries. `curl` first and `wget` where curl will not *start*, which is the
 * pair `eliotw` already requires one of: the wrapper that fetched the launcher proved one of them is
 * here, and this asks for them in the same order so that a machine which could bootstrap can also
 * build. A refusal from either — a 404, a tag with no such asset — is an `AssetError` naming the
 * command, never a fallback to the other tool.
 *
 * **What is cached is the unpacked directory and the archive's digest**, under the same root the
 * mirrors are in and keyed the same way: `<root>/assets/<url>@<tag>/<asset>`, with
 * `<asset>.sha256` beside it, so `ls` says which package, which version and which asset a pile of jars
 * came from. The archive is hashed before it is unpacked and deleted after — keeping it would double
 * what the cache costs to hold a file nothing reads again — so the digest file is the one record of
 * what was downloaded, and it is written *last*: its presence, not the directory's, is the proof that a
 * fetch finished. That closes the hole a directory alone left open, an `unzip` killed outright leaving a
 * partial tree that looked present, and it heals a cache from before digests existed the same way —
 * a directory with no digest beside it is fetched again, over itself.
 */
implement shellAssets: Assets {
   def assetTree(asset: Asset): {Process, FileSystem, Dep[Path], Throw[IoError], Throw[AssetError]} Path =
      fetchedTree(dependency, asset)

   /**
    * Read back from the digest file the fetch wrote, so a cached asset answers without being hashed
    * again — and without the archive, which is gone.
    */
   def assetDigest(asset: Asset): {Process, FileSystem, Dep[Path], Throw[IoError], Throw[AssetError]} Digest = {
      fetchedTree(dependency, asset)

      Digest(readFile(digestFile(dependency, asset)).trim)
   }
}

/**
 * Where `asset` is unpacked under `root`: beside the mirror of the repository that published it, under
 * a name carrying the version, holding one directory per asset.
 *
 * Under `assets/` rather than beside the mirrors themselves, because `<url>@<tag>` is already where a
 * *worktree* of that version goes and a build wants both at once.
 */
def assetDirectory(root: Path, asset: Asset): Path = versionDirectory(root, asset) / asset.assetName

/**
 * Where the digest of `asset`'s archive is kept: beside the directory it was unpacked into, written once
 * the unpacking finished.
 */
def digestFile(root: Path, asset: Asset): Path = versionDirectory(root, asset) / (asset.assetName ++ ".sha256")

/**
 * `asset`'s directory, fetched first unless the digest file says a fetch already finished.
 */
private def fetchedTree(root: Path, asset: Asset): {Process, FileSystem, Throw[IoError], Throw[AssetError]} Path = {
   val directory = assetDirectory(root, asset)

   if(exists(digestFile(root, asset))) directory else unpacked(root, asset, directory)
}

private def versionDirectory(root: Path, asset: Asset): Path =
   under(root / "assets", asset.assetRepository.repositoryUrl ++ "@" ++ show(asset.assetVersion))

private def under(root: Path, name: String): Path =
   split("/", name).foldLeft(root, segment -> directory -> directory / segment)

/**
 * Fetch the archive, hash it and unpack it — the whole of what this implementation does that is not
 * deciding where something goes.
 *
 * The archive is downloaded beside the directory it unpacks into rather than into it, and the digest is
 * written only once `unzip` has finished, so a half-finished fetch leaves nothing that later looks
 * cached. The archive is deleted afterwards: the unpacked jars are what a classpath names, and a second
 * copy of every one of them compressed is a cache that is twice the size for nothing.
 */
private def unpacked(
      root: Path,
      asset: Asset,
      directory: Path
   ): {Process, FileSystem, Throw[IoError], Throw[AssetError]} Path = {
   val archive = versionDirectory(root, asset) / (asset.assetName ++ ".download")

   createDirectories(versionDirectory(root, asset))
   downloaded(assetUrlOf(asset), archive)

   val digest = hashed(archive)

   checked(unzipping(archive, directory))
   writeFile(digest ++ "\n", digestFile(root, asset))
   delete(archive)

   directory
}

/**
 * The SHA-256 of `archive`, as `sha256sum` prints it — and as `shasum -a 256` does where there is no
 * `sha256sum`, which is macOS.
 *
 * The fallback is on the first tool failing to *start*, for `downloaded`'s reason. Both print the digest
 * first and the file name after it, so the digest is everything before the first space.
 */
private def hashed(archive: Path): {Process, Throw[IoError], Throw[AssetError]} String =
   before(" ", catch[IoError, String](output(sha256sumHashing(archive)), _ -> output(shasumHashing(archive))))

private def sha256sumHashing(archive: Path): List[String] = command("sha256sum").withArgument(show(archive))

private def shasumHashing(archive: Path): List[String] =
   command("shasum").withArgument("-a").withArgument("256").withArgument(show(archive))

/**
 * `curl`, and `wget` where curl is not installed.
 *
 * The fallback is on curl failing to *start*, which is the one thing that says "this machine has the
 * other tool". A curl that ran and refused has read the server's answer, and retrying that with a
 * second downloader would turn one honest report into two confusing ones.
 */
private def downloaded(url: String, archive: Path): {Process, Throw[IoError], Throw[AssetError]} Unit =
   catch[IoError, Unit](checked(curlFetching(url, archive)), _ -> checked(wgetFetching(url, archive)))

/**
 * `--fail` so that a forge answering "404" in HTML is an error rather than an archive full of HTML,
 * and `--location` because a release asset is served as a redirect to storage.
 */
private def curlFetching(url: String, archive: Path): List[String] =
   command("curl").withArgument("--fail").withArgument("--location").withArgument("--silent")
      .withArgument("--show-error").withArgument("--output").withArgument(show(archive))
      .withArgument(url)

private def wgetFetching(url: String, archive: Path): List[String] =
   command("wget").withArgument("--quiet").withArgument("--output-document").withArgument(show(archive))
      .withArgument(url)

/**
 * `-o` because a directory that is there but partial is re-unpacked over rather than refused, and `-d`
 * because `unzip` making the directory is what makes its existence mean "this finished".
 */
private def unzipping(archive: Path, directory: Path): List[String] =
   command("unzip").withArgument("-q").withArgument("-o").withArgument(show(archive))
      .withArgument("-d").withArgument(show(directory))

/**
 * Run `arguments` where this program stands, raising what they said if they refused.
 *
 * In `here` for `eliot.build.git.ShellGit`'s reason: a cache root may be relative — `target/cache` is
 * the obvious thing for a caller to pass — and a command launched from inside the cache would resolve
 * that same relative path a second time.
 */
private def checked(arguments: List[String]): {Process, Throw[IoError], Throw[AssetError]} Unit = {
   output(arguments)

   unit
}

/**
 * What `arguments` wrote, run as `checked` runs them.
 */
private def output(arguments: List[String]): {Process, Throw[IoError], Throw[AssetError]} String = {
   val result = run(arguments, here)

   unless(result.exitCode == 0) raise(AssetError(arguments.joined(" "), result.exitCode, result.standardError))
   result.standardOutput
}

private def here: Path = path(".")
