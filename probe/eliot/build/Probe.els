import eliot.collection.List
import eliot.file.Path
import eliot.file.File
import eliot.system.Process
import eliot.system.Environment
import eliot.build.PackageId
import eliot.build.Version
import eliot.build.Descriptor
import eliot.build.Git
import eliot.build.Cache
import eliot.build.PackageSource
import eliot.build.Resolution

/**
 * A `main` that drives the effectful half of the build against a real repository: `eliot.build.Git`
 * spawning real processes, `eliot.build.Cache` making real directories, and `eliot.build.Resolution`
 * running on the git-backed `PackageSource` rather than on a table of strings.
 *
 * It exists because the compiler checks a whole program from `main` and nothing else, and because a
 * test cannot do this job. Ability resolution happens at monomorphization, so running production code
 * on a test's pure carrier resolves `Process[Fake]` — never `Process[IO]`. A green suite is evidence
 * about the logic and no evidence at all that the logic has an interpretation on the platform. This is
 * where that is checked, so it must keep reaching every effectful module deliberately; when the
 * launcher has its own `main`, that becomes the mechanism and this goes.
 *
 * The two reports are printed separately, each discharging its own failures, so a resolution that
 * fails still leaves the cache's answers on screen — a probe that reports nothing because its last
 * step raised is a probe that has to be edited to be useful.
 *
 * Not a test: it wants the network and a `git` on the path, and it asserts nothing. Run it to watch
 * the cache work.
 */
def main: {Console, Process, FileSystem, Environment, PackageSource} Unit = {
   val subject = packageId(arguments.head orElse "github.com/robertbraeutigam/eliot")

   printLine("cache directory: " ++ show(cacheDirectory(packageCacheRoot, subject)))
   printLine(cacheReport(subject) catch ((broken: IoError) -> show(broken)) catch ((failed: GitError) -> show(failed)))
   printLine(
      resolutionReport(subject)
         catch ((broken: IoError) -> show(broken))
         catch ((failed: GitError) -> show(failed))
         catch ((unreadable: DescriptorError) -> show(unreadable))
         catch ((unresolvable: ResolutionError) -> "resolution: " ++ show(unresolvable))
   )
}

/**
 * What the cache can say about `subject`: what it publishes, where its first release points, and
 * whether it carries a descriptor at its newest version.
 */
private def cacheReport(subject: PackageId): {Process, FileSystem, Throw[IoError], Throw[GitError]} String = {
   val published = publishedTags(packageCacheRoot, subject)
   val anchor = anchorOf(packageCacheRoot, 1, subject)

   "tags: " ++ published.map(ref -> show(ref.taggedVersion)).joined(", ") ++
      "\nv1 anchor: " ++ foldOption("<none>", commit -> commit, anchor) ++
      "\n" ++ descriptorReport(published, subject)
}

private def descriptorReport(
   published: List[TagRef],
   subject: PackageId
): {Process, FileSystem, Throw[IoError], Throw[GitError]} String =
   foldOption(
      "descriptor: no version to read one at",
      newest -> descriptorAtNewest(newest.taggedVersion, subject),
      published.sorted.last
   )

private def descriptorAtNewest(
   newest: Version,
   subject: PackageId
): {Process, FileSystem, Throw[IoError], Throw[GitError]} String = {
   val text = descriptorTextAt(packageCacheRoot, newest, subject)

   "descriptor at " ++ show(newest) ++ ": " ++ foldOption("<none published>", found -> shown(found), text)
}

/**
 * What a configuration requiring `subject` resolves to — the one path that reaches `Resolution`
 * through the git-backed `PackageSource` instance, which is the binding a test carrier by
 * construction cannot exercise.
 *
 * The requirement is the newest release the repository publishes, or `v1` where it publishes none:
 * asking for a version that does not exist is a resolution *error*, which is a report worth printing
 * and still runs every step of the path that produces it.
 */
private def resolutionReport(
   subject: PackageId
): {Process, FileSystem, PackageSource, Throw[IoError], Throw[GitError], Throw[DescriptorError], Throw[ResolutionError]} String = {
   val published = publishedTags(packageCacheRoot, subject)

   resolutionAt(foldOption(Version(1, None), newest -> newest.taggedVersion, published.sorted.last), subject)
}

private def resolutionAt(
   newest: Version,
   subject: PackageId
): {Process, FileSystem, PackageSource, Throw[IoError], Throw[GitError], Throw[DescriptorError], Throw[ResolutionError]} String = {
   val root = parseDescriptor(singleton("dep " ++ show(subject) ++ " " ++ show(newest)))
   val resolution = resolveTests(root)

   "resolution: " ++ resolution.selections.joined(", ")
}

private def shown(text: String): String = show(size(split("\n", text))) ++ " lines"
